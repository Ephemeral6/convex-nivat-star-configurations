import Nivat.External.Colle.DirectionRigidity
import Mathlib.Analysis.Convex.Extreme

/-!
# Local generation by an annihilator

This is the algebraic mechanism in Colle Lemma 2.5. A nonzero coefficient
of an annihilator makes the value at that site uniquely recoverable from
the other support sites, for every configuration in the orbit closure.
Geometric assertions about the vertices of a convex hull are separate.
-/

namespace Nivat.Colle

/-- A window generates a site if its remaining values uniquely determine
the value there among configurations in the orbit closure. -/
def GeneratesAt {A : Type*} (ξ : Config A) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ) : Prop :=
  a ∈ S ∧ ∀ x ∈ orbitClosure ξ, ∀ y ∈ orbitClosure ξ,
    (∀ z ∈ S.erase a, x z = y z) → x a = y a

/-- A nonzero coefficient in a common annihilator determines its site from
the remaining support, over any commutative ring without zero divisors. -/
theorem eq_at_of_annihilator_of_agree_off_support
    {R : Type*} [CommRing R] [NoZeroDivisors R]
    {p : LaurentTwo R} {x y : Config R} {a : ℤ × ℤ}
    (ha : a ∈ supp p) (hx : act p x = 0) (hy : act p y = 0)
    (hagree : ∀ z ∈ (supp p).erase a, x z = y z) : x a = y a := by
  classical
  have hxy : act p (x - y) = 0 := by rw [act_sub_right, hx, hy, sub_self]
  have hsum : (∑ z ∈ supp p, p.coeff z * (x z - y z)) = 0 := by
    have h := congrFun hxy (0 : ℤ × ℤ)
    simpa only [act_apply, Finsupp.sum, zero_add, Pi.sub_apply, Pi.zero_apply, supp] using h
  have hrest : (∑ z ∈ (supp p).erase a, p.coeff z * (x z - y z)) = 0 := by
    apply Finset.sum_eq_zero
    intro z hz
    rw [hagree z hz, sub_self, mul_zero]
  rw [← Finset.sum_erase_add _ _ ha, hrest, zero_add] at hsum
  exact sub_eq_zero.mp ((mul_eq_zero.mp hsum).resolve_left (mem_supp.mp ha))

/-- Every nonzero support site of an annihilator is generated by any
window containing its support, throughout the orbit closure. -/
theorem generatesAt_of_annihilator
    {R : Type*} [CommRing R] [NoZeroDivisors R]
    {ξ : Config R} {p : LaurentTwo R} (hann : act p ξ = 0)
    {S : Finset (ℤ × ℤ)} (hS : supp p ⊆ S) {a : ℤ × ℤ} (ha : a ∈ supp p) :
    GeneratesAt ξ S a := by
  refine ⟨hS ha, ?_⟩
  intro x hx y hy hagree
  apply eq_at_of_annihilator_of_agree_off_support ha
    (act_eq_zero_on_orbitClosure hann hx) (act_eq_zero_on_orbitClosure hann hy)
  intro z hz
  exact hagree z (Finset.mem_erase.mpr
    ⟨(Finset.mem_erase.mp hz).1, hS (Finset.mem_erase.mp hz).2⟩)

/-- Colle's literal vertex convention: a site is a vertex when deleting
it preserves lattice convexity. Each such site must be generated. -/
def IsGeneratingSet {A : Type*} (ξ : Config A) (S : Finset (ℤ × ℤ)) : Prop :=
  S.Nonempty ∧ LatticeConvex S ∧
    ∀ a ∈ S, LatticeConvex (S.erase a) → GeneratesAt ξ S a

/-- Colle Lemma 2.5 for a finite lattice convex completion of the support,
in this project's action convention `act p x z = ∑ a, p[a] * x(z+a)`.
The hull equality ensures that every vertex has a nonzero coefficient. -/
theorem isGeneratingSet_of_annihilator
    {R : Type*} [CommRing R] [NoZeroDivisors R]
    {ξ : Config R} {p : LaurentTwo R} (hann : act p ξ = 0)
    {S : Finset (ℤ × ℤ)} (hne : S.Nonempty) (hconv : LatticeConvex S)
    (hS : supp p ⊆ S) (hhull : Conv S = Conv (supp p)) :
    IsGeneratingSet ξ S := by
  refine ⟨hne, hconv, ?_⟩
  intro a ha hdel
  have hap : a ∈ supp p := by
    by_contra hn
    have hsub : supp p ⊆ S.erase a := by
      intro z hz
      refine Finset.mem_erase.mpr ⟨?_, hS hz⟩
      intro hza
      exact hn (hza ▸ hz)
    have hconvsub : Conv (supp p) ⊆ Conv (S.erase a) :=
      convexHull_mono (Set.image_mono hsub)
    have haHull : toReal a ∈ Conv (supp p) := by
      rw [← hhull]
      exact subset_Conv ha
    exact Finset.notMem_erase a S (hdel a (hconvsub haHull))
  exact generatesAt_of_annihilator hann hS hap

/-- The lattice points in the convex hull of a finite lattice set form a
finite lattice-convex completion with the same real convex hull. -/
theorem exists_latticeConvex_completion (F : Finset (ℤ × ℤ)) :
    ∃ S : Finset (ℤ × ℤ), F ⊆ S ∧ LatticeConvex S ∧ Conv S = Conv F := by
  classical
  let hfinite := RZ_finite ({0} : Set (ℝ × ℝ)) (by simp) F
  let S : Finset (ℤ × ℤ) := hfinite.toFinset
  have hmem (z : ℤ × ℤ) : z ∈ S ↔ toReal z ∈ Conv F := by
    simp only [S, Set.Finite.mem_toFinset, RZ, Set.mem_ofPred_eq,
      Set.mem_singleton_iff, forall_eq, add_zero]
  have hsub : F ⊆ S := fun z hz => (hmem z).mpr (subset_Conv hz)
  have hhull : Conv S = Conv F := by
    apply Set.Subset.antisymm
    · apply convexHull_min _ (convex_convexHull ℝ _)
      rintro _ ⟨z, hz, rfl⟩
      exact (hmem z).mp hz
    · apply convexHull_mono
      rintro _ ⟨z, hz, rfl⟩
      exact ⟨z, hsub hz, rfl⟩
  refine ⟨S, hsub, ?_, hhull⟩
  intro z hz
  exact (hmem z).mpr (hhull ▸ hz)

/-- Every nonzero annihilator supplies a finite lattice-convex generating
set: take all lattice points in the convex hull of its support.
This is the existence form of Colle Lemma 2.5. -/
theorem exists_generatingSet_of_annihilator
    {R : Type*} [CommRing R] [NoZeroDivisors R]
    {ξ : Config R} {p : LaurentTwo R} (hp : p ≠ 0) (hann : act p ξ = 0) :
    ∃ S : Finset (ℤ × ℤ), IsGeneratingSet ξ S ∧
      supp p ⊆ S ∧ Conv S = Conv (supp p) := by
  obtain ⟨S, hS, hconv, hhull⟩ := exists_latticeConvex_completion (supp p)
  have hsne : (supp p).Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro h
    apply hp
    simpa only [supp, Finsupp.support_eq_empty, AddMonoidAlgebra.coeff_eq_zero] using h
  exact ⟨S, isGeneratingSet_of_annihilator hann (hsne.mono hS) hconv hS hhull,
    hS, hhull⟩

end Nivat.Colle
