namespace Nivat.Colle41

open Nivat

/-! ## §1 One-sided Morse–Hedlund -/

/-- The length-`k` word read off `y` starting at position `t`. -/
def wordAt {β : Type*} (y : ℤ → β) (k : ℕ) (t : ℤ) : Fin k → β :=
  fun l => y (t + (l.val : ℤ))

/-- The set of length-`k` words occurring in `y` at positions `≥ τ`. -/
def wordsFrom {β : Type*} (y : ℤ → β) (τ : ℤ) (k : ℕ) : Set (Fin k → β) :=
  wordAt y k '' {t : ℤ | τ ≤ t}

theorem wordAt_eq_iff {β : Type*} (y : ℤ → β) (k : ℕ) (s t : ℤ) :
    wordAt y k s = wordAt y k t ↔ ∀ l : ℕ, l < k → y (s + (l : ℤ)) = y (t + (l : ℤ)) := by
  constructor
  · intro h l hl
    exact congrFun h ⟨l, hl⟩
  · intro h
    funext l
    exact h l.val l.isLt

theorem wordAt_mem_wordsFrom {β : Type*} {y : ℤ → β} {τ t : ℤ} (ht : τ ≤ t) (k : ℕ) :
    wordAt y k t ∈ wordsFrom y τ k := ⟨t, ht, rfl⟩

theorem wordsFrom_nonempty {β : Type*} (y : ℤ → β) (τ : ℤ) (k : ℕ) :
    (wordsFrom y τ k).Nonempty := ⟨_, wordAt_mem_wordsFrom (le_refl τ) k⟩

/-- Deleting the last letter of a word. -/
def dropLast {β : Type*} (k : ℕ) (f : Fin (k + 1) → β) : Fin k → β := fun l => f l.castSucc

theorem dropLast_wordAt {β : Type*} (y : ℤ → β) (k : ℕ) (t : ℤ) :
    dropLast k (wordAt y (k + 1) t) = wordAt y k t := rfl

theorem dropLast_image_wordsFrom {β : Type*} (y : ℤ → β) (τ : ℤ) (k : ℕ) :
    dropLast k '' wordsFrom y τ (k + 1) = wordsFrom y τ k := by
  rw [wordsFrom, wordsFrom, Set.image_image]
  exact rfl

theorem wordsFrom_finite_of_le {β : Type*} (y : ℤ → β) (τ : ℤ) {k p : ℕ} (hkp : k ≤ p)
    (h : (wordsFrom y τ p).Finite) : (wordsFrom y τ k).Finite := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hkp
  clear hkp
  induction d with
  | zero => simpa using h
  | succ d ih =>
    apply ih
    rw [← dropLast_image_wordsFrom y τ (k + d)]
    exact Set.Finite.image _ h

theorem wordsFrom_ncard_mono {β : Type*} (y : ℤ → β) (τ : ℤ) {k p : ℕ} (hkp : k + 1 ≤ p)
    (h : (wordsFrom y τ p).Finite) :
    (wordsFrom y τ k).ncard ≤ (wordsFrom y τ (k + 1)).ncard := by
  rw [← dropLast_image_wordsFrom y τ k]
  exact Set.ncard_image_le (wordsFrom_finite_of_le y τ hkp h)

theorem wordsFrom_ncard_mono' {β : Type*} (y : ℤ → β) (τ : ℤ) {k p : ℕ} (hkp : k ≤ p)
    (h : (wordsFrom y τ p).Finite) :
    (wordsFrom y τ k).ncard ≤ (wordsFrom y τ p).ncard := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hkp
  clear hkp
  induction d with
  | zero => simp
  | succ d ih =>
    refine le_trans (ih (wordsFrom_finite_of_le y τ (Nat.le_succ (k + d)) h)) ?_
    exact wordsFrom_ncard_mono y τ (le_refl (k + d + 1)) h

theorem one_le_wordsFrom_ncard {β : Type*} (y : ℤ → β) (τ : ℤ) {k p : ℕ} (hkp : k ≤ p)
    (h : (wordsFrom y τ p).Finite) : 1 ≤ (wordsFrom y τ k).ncard :=
  (Set.ncard_pos (wordsFrom_finite_of_le y τ hkp h)).mpr (wordsFrom_nonempty y τ k)

/-- A plateau of the one-sided subword-complexity function below the threshold `p`. -/
theorem exists_plateau {β : Type*} (y : ℤ → β) (τ : ℤ) {p : ℕ}
    (h : (wordsFrom y τ p).Finite) (hcard : (wordsFrom y τ p).ncard ≤ p) :
    ∃ k : ℕ, k < p ∧ (wordsFrom y τ k).ncard = (wordsFrom y τ (k + 1)).ncard := by
  by_contra hcon
  push Not at hcon
  have hstep : ∀ k : ℕ, k < p →
      (wordsFrom y τ k).ncard + 1 ≤ (wordsFrom y τ (k + 1)).ncard := by
    intro k hk
    have hle := wordsFrom_ncard_mono y τ (Nat.succ_le_of_lt hk) h
    have hne := hcon k hk
    omega
  have hgrow : ∀ j : ℕ, j ≤ p → (wordsFrom y τ 0).ncard + j ≤ (wordsFrom y τ j).ncard := by
    intro j
    induction j with
    | zero => intro _; omega
    | succ j ih =>
      intro hj
      have h1 := ih (by omega)
      have h2 := hstep j (by omega)
      omega
  have h0 := one_le_wordsFrom_ncard y τ (Nat.zero_le p) h
  have := hgrow p (le_refl p)
  omega

/-- At a plateau, a length-`k` word occurring at two admissible positions has the same
right extension. -/
theorem forward_determinacy_of_plateau {β : Type*} (y : ℤ → β) (τ : ℤ) {k p : ℕ}
    (hkp : k + 1 ≤ p) (h : (wordsFrom y τ p).Finite)
    (hplat : (wordsFrom y τ k).ncard = (wordsFrom y τ (k + 1)).ncard)
    {s t : ℤ} (hs : τ ≤ s) (ht : τ ≤ t) (hw : wordAt y k s = wordAt y k t) :
    y (s + (k : ℤ)) = y (t + (k : ℤ)) := by
  have hfin1 : (wordsFrom y τ (k + 1)).Finite := wordsFrom_finite_of_le y τ hkp h
  have himg : (dropLast k '' wordsFrom y τ (k + 1)).ncard = (wordsFrom y τ (k + 1)).ncard := by
    rw [dropLast_image_wordsFrom]; exact hplat
  have hinj : Set.InjOn (dropLast k) (wordsFrom y τ (k + 1)) :=
    Set.injOn_of_ncard_image_eq himg hfin1
  have heq : wordAt y (k + 1) s = wordAt y (k + 1) t := by
    apply hinj (wordAt_mem_wordsFrom hs (k + 1)) (wordAt_mem_wordsFrom ht (k + 1))
    rw [dropLast_wordAt, dropLast_wordAt, hw]
  have := congrFun heq (Fin.last k)
  simpa only [wordAt, Fin.val_last] using this

private theorem period_from_repeat {β : Type*} (y : ℤ → β) (τ : ℤ) {k p : ℕ}
    (hkp : k < p) (hfin : (wordsFrom y τ p).Finite)
    (hplat : (wordsFrom y τ k).ncard = (wordsFrom y τ (k + 1)).ncard)
    {a b : ℤ} (ha : τ ≤ a) (_hb : τ ≤ b) (hab : a < b)
    (hw : wordAt y k a = wordAt y k b) :
    ∃ q : ℕ, 0 < q ∧ ∀ t : ℤ, a ≤ t → y (t + (q : ℤ)) = y t := by
  have hfd : ∀ s t : ℤ, τ ≤ s → τ ≤ t → (∀ l : ℕ, l < k → y (s + (l : ℤ)) = y (t + (l : ℤ))) →
      y (s + (k : ℤ)) = y (t + (k : ℤ)) := by
    intro s t hs ht hword
    exact forward_determinacy_of_plateau y τ (Nat.succ_le_of_lt hkp) hfin hplat hs ht
      ((wordAt_eq_iff y k s t).mpr hword)
  have key : ∀ m : ℕ, ∀ l : ℕ, l < k →
      y (a + (m : ℤ) + (l : ℤ)) = y (b + (m : ℤ) + (l : ℤ)) := by
    intro m
    induction m with
    | zero =>
      intro l hl
      have := (wordAt_eq_iff y k a b).mp hw l hl
      simpa using this
    | succ m ih =>
      have hstep := hfd (a + (m : ℤ)) (b + (m : ℤ)) (by omega) (by omega) ih
      intro l hl
      rcases Nat.lt_or_ge (l + 1) k with hlk | hlk
      · have := ih (l + 1) hlk
        have e1 : a + ((m : ℤ) + 1) + (l : ℤ) = a + (m : ℤ) + ((l : ℤ) + 1) := by ring
        have e2 : b + ((m : ℤ) + 1) + (l : ℤ) = b + (m : ℤ) + ((l : ℤ) + 1) := by ring
        push_cast
        push_cast at this
        rw [e1, e2]
        exact this
      · have hlk' : l + 1 = k := by omega
        have e1 : a + ((m : ℤ) + 1) + (l : ℤ) = a + (m : ℤ) + ((l : ℤ) + 1) := by ring
        have e2 : b + ((m : ℤ) + 1) + (l : ℤ) = b + (m : ℤ) + ((l : ℤ) + 1) := by ring
        have e3 : ((l : ℤ) + 1) = (k : ℤ) := by exact_mod_cast congrArg (Nat.cast : ℕ → ℤ) hlk'
        push_cast
        rw [e1, e2, e3]
        exact hstep
  have hpt : ∀ m : ℕ, y (a + (m : ℤ)) = y (b + (m : ℤ)) := by
    intro m
    rcases Nat.eq_zero_or_pos k with hk0 | hk0
    · have hstep := hfd (a + (m : ℤ)) (b + (m : ℤ)) (by omega) (by omega)
        (fun l hl => absurd hl (by omega))
      rw [hk0] at hstep
      simpa using hstep
    · have := key m 0 hk0
      simpa using this
  refine ⟨(b - a).toNat, by omega, ?_⟩
  intro t hta
  have hq : ((b - a).toNat : ℤ) = b - a := Int.toNat_of_nonneg (by omega)
  have hm : ((t - a).toNat : ℤ) = t - a := Int.toNat_of_nonneg (by omega)
  have h1 := hpt (t - a).toNat
  rw [hm] at h1
  have e1 : a + (t - a) = t := by ring
  have e2 : b + (t - a) = t + (b - a) := by ring
  rw [e1, e2] at h1
  rw [hq]
  exact h1.symm

/-- **Colle, Theorem 1.2 (Morse–Hedlund, one-sided form).**  If the number of distinct
length-`p` words occurring in `y` at positions `≥ τ` is at most `p`, then `y` is periodic
on the half-line `[τ + p, ∞)`. -/
theorem exists_period_of_wordsFrom_ncard_le {β : Type*} (y : ℤ → β) (τ : ℤ) {p : ℕ}
    (hfin : (wordsFrom y τ p).Finite) (hcard : (wordsFrom y τ p).ncard ≤ p) :
    ∃ q : ℕ, 0 < q ∧ ∀ t : ℤ, τ + (p : ℤ) ≤ t → y (t + (q : ℤ)) = y t := by
  classical
  obtain ⟨k, hkp, hplat⟩ := exists_plateau y τ hfin hcard
  have hfink : (wordsFrom y τ k).Finite := wordsFrom_finite_of_le y τ (le_of_lt hkp) hfin
  have hmaps : ∀ a ∈ Finset.Icc τ (τ + (p : ℤ)), wordAt y k a ∈ hfink.toFinset := by
    intro a ha
    rw [Set.Finite.mem_toFinset]
    exact wordAt_mem_wordsFrom (Finset.mem_Icc.mp ha).1 k
  have hlt : hfink.toFinset.card < (Finset.Icc τ (τ + (p : ℤ))).card := by
    have h1 : hfink.toFinset.card = (wordsFrom y τ k).ncard :=
      (Set.ncard_eq_toFinset_card _ hfink).symm
    have h2 : (wordsFrom y τ k).ncard ≤ p :=
      le_trans (wordsFrom_ncard_mono' y τ (le_of_lt hkp) hfin) hcard
    rw [h1, Int.card_Icc]
    omega
  obtain ⟨a, ha, b, hb, hab, hwab⟩ :=
    Finset.exists_ne_map_eq_of_card_lt_of_maps_to hlt hmaps
  rw [Finset.mem_Icc] at ha hb
  rcases lt_or_gt_of_ne hab with hlt' | hlt'
  · obtain ⟨q, hq, hper⟩ := period_from_repeat y τ hkp hfin hplat ha.1 hb.1 hlt' hwab
    exact ⟨q, hq, fun t ht => hper t (by omega)⟩
  · obtain ⟨q, hq, hper⟩ := period_from_repeat y τ hkp hfin hplat hb.1 ha.1 hlt' hwab.symm
    exact ⟨q, hq, fun t ht => hper t (by omega)⟩

/-! ## §2 Claim 4.2: the semi-ambiguity count along one line -/

/-- The semi-ambiguity hypothesis of Colle's Lemma 4.1, written out.  `SemiAmbiguousAlong η x Q
u' τ` says that every `Q`-pattern of `x` occurring at a position `t • u'` with `t ≥ τ` extends
to at least two distinct `S`-patterns of `η` — this is `N_S(ℓ', γ) > 1` for
`γ = (T^{t v_{ℓ'}} x)|_{S ∖ ℓ'_S}`, with `Q = S ∖ ℓ'_S`. -/
def SemiAmbiguousAlong {A : Type*} (η x : Config A) (S Q : Finset (ℤ × ℤ))
    (u' : ℤ × ℤ) (τ : ℤ) : Prop :=
  ∀ t : ℤ, τ ≤ t → ∃ a b : ℤ × ℤ,
    (∀ z ∈ Q, η (a + z) = x (t • u' + z)) ∧ (∀ z ∈ Q, η (b + z) = x (t • u' + z)) ∧
      ∃ z ∈ S, η (a + z) ≠ η (b + z)

/-- **Colle, Claim 4.2, counting step.**  Under the complexity deficit
`P_η(S) − P_η(S ∖ ℓ'_S) ≤ p` and semi-ambiguity along `ℓ'`, the one-sided subword complexity
of `x` read along the `ℓ'`-line through `g` is at most `p`, provided `Q` contains the `p`
consecutive points `g, g + v_{ℓ'}, …, g + (p−1) v_{ℓ'}`. -/
theorem wordsFrom_ncard_le_of_semiAmbiguous {A : Type*} {η x : Config A}
    (hfinη : (Set.range η).Finite) (hx : x ∈ orbitClosure η)
    {S Q : Finset (ℤ × ℤ)} (hQS : Q ⊆ S) {u' g : ℤ × ℤ} {τ : ℤ} {p : ℕ}
    (hdef : P η S ≤ P η Q + p)
    (hline : ∀ i : ℕ, i < p → g + (i : ℤ) • u' ∈ Q)
    (hamb : SemiAmbiguousAlong η x S Q u' τ) :
    (wordsFrom (fun t : ℤ => x (g + t • u')) τ p).Finite ∧
      (wordsFrom (fun t : ℤ => x (g + t • u')) τ p).ncard ≤ p := by
  classical
  have hfinQ : Finite ↥(patterns η Q) := (patterns_finite_of_range_finite hfinη Q).to_subtype
  -- the `Q`-pattern of `x` at the position `t • u'`
  set px : ℤ → ↥(patterns η Q) := fun t =>
    ⟨pattern x Q (t • u'), patterns_subset_of_mem_orbitClosure hx Q ⟨t • u', rfl⟩⟩ with hpx
  -- semi-ambiguity puts every such pattern in the ambiguous set
  have hmem : ∀ t : ℤ, τ ≤ t → px t ∈ Colle.ambiguous_patterns η hQS := by
    intro t ht
    obtain ⟨a, b, ha, hb, z, hzS, hzne⟩ := hamb t ht
    refine ⟨⟨pattern η S a, ⟨a, rfl⟩⟩, ⟨pattern η S b, ⟨b, rfl⟩⟩, ?_, ?_, ?_⟩
    · intro hab
      apply hzne
      have := congrFun (congrArg Subtype.val hab) ⟨z, hzS⟩
      simpa only [pattern] using this
    · apply Subtype.ext
      funext q
      simpa only [Colle.restrict_occurring_pattern, pattern, hpx] using ha q.1 q.2
    · apply Subtype.ext
      funext q
      simpa only [Colle.restrict_occurring_pattern, pattern, hpx] using hb q.1 q.2
  -- the word along the `ℓ'`-line through `g` is a function of the `Q`-pattern
  set f : ↥(patterns η Q) → (Fin p → A) := fun π l =>
    π.1 ⟨g + (l.val : ℤ) • u', hline l.val l.isLt⟩ with hf
  have hfpx : ∀ t : ℤ, f (px t) = wordAt (fun s : ℤ => x (g + s • u')) p t := by
    intro t
    funext l
    show x (t • u' + (g + (l.val : ℤ) • u')) = x (g + (t + (l.val : ℤ)) • u')
    congr 1
    rw [add_smul]
    abel
  have hsub : wordsFrom (fun s : ℤ => x (g + s • u')) τ p ⊆
      f '' Colle.ambiguous_patterns η hQS := by
    rintro _ ⟨t, ht, rfl⟩
    exact ⟨px t, hmem t ht, hfpx t⟩
  have hfinamb : (Colle.ambiguous_patterns η hQS).Finite := Set.toFinite _
  have hfinimg : (f '' Colle.ambiguous_patterns η hQS).Finite := hfinamb.image f
  refine ⟨hfinimg.subset hsub, ?_⟩
  calc (wordsFrom (fun s : ℤ => x (g + s • u')) τ p).ncard
      ≤ (f '' Colle.ambiguous_patterns η hQS).ncard := Set.ncard_le_ncard hsub hfinimg
    _ ≤ (Colle.ambiguous_patterns η hQS).ncard := Set.ncard_image_le hfinamb
    _ ≤ P η S - P η Q := Colle.ncard_ambiguous_patterns_le_sub hfinη hQS
    _ ≤ p := by omega

/-- **Colle, Claim 4.2.**  Along every `ℓ'`-line through a point `g` for which `Q` contains the
`p` consecutive points `g, g + v_{ℓ'}, …, g + (p−1) v_{ℓ'}`, the configuration `x` is periodic
with a period parallel to `ℓ'` from the position `τ + p` on. -/
theorem exists_period_along_of_semiAmbiguous {A : Type*} {η x : Config A}
    (hfinη : (Set.range η).Finite) (hx : x ∈ orbitClosure η)
    {S Q : Finset (ℤ × ℤ)} (hQS : Q ⊆ S) {u' g : ℤ × ℤ} {τ : ℤ} {p : ℕ}
    (hdef : P η S ≤ P η Q + p)
    (hline : ∀ i : ℕ, i < p → g + (i : ℤ) • u' ∈ Q)
    (hamb : SemiAmbiguousAlong η x S Q u' τ) :
    ∃ q : ℕ, 0 < q ∧ ∀ t : ℤ, τ + (p : ℤ) ≤ t →
      x (g + (t + (q : ℤ)) • u') = x (g + t • u') := by
  obtain ⟨hfin, hcard⟩ :=
    wordsFrom_ncard_le_of_semiAmbiguous hfinη hx hQS hdef hline hamb
  exact exists_period_of_wordsFrom_ncard_le (fun s : ℤ => x (g + s • u')) τ hfin hcard

/-! ## §3 A single period for the whole half-strip -/

private theorem period_mul {β : Type*} (y : ℤ → β) (σ : ℤ) {q : ℕ}
    (h : ∀ t : ℤ, σ ≤ t → y (t + (q : ℤ)) = y t) (m : ℕ) :
    ∀ t : ℤ, σ ≤ t → y (t + (m : ℤ) * (q : ℤ)) = y t := by
  induction m with
  | zero => intro t _; simp
  | succ m ih =>
    intro t ht
    have hnn : (0 : ℤ) ≤ (m : ℤ) * (q : ℤ) :=
      mul_nonneg (Int.natCast_nonneg m) (Int.natCast_nonneg q)
    have e : t + ((m + 1 : ℕ) : ℤ) * (q : ℤ) = (t + (m : ℤ) * (q : ℤ)) + (q : ℤ) := by
      push_cast; ring
    rw [e, h (t + (m : ℤ) * (q : ℤ)) (by omega)]
    exact ih t ht

/-- **Colle, Claim 4.2, uniform version.**  A single period parallel to `ℓ'` works
simultaneously for every line of the half-strip `H_Q` — take the product of the finitely
many per-line periods produced by Claim 4.2. -/
theorem exists_common_period_of_semiAmbiguous {A : Type*} {η x : Config A}
    (hfinη : (Set.range η).Finite) (hx : x ∈ orbitClosure η)
    {S Q : Finset (ℤ × ℤ)} (hQS : Q ⊆ S) {u' : ℤ × ℤ} {τ : ℤ} {p : ℕ}
    (hdef : P η S ≤ P η Q + p) (B : Finset (ℤ × ℤ))
    (hline : ∀ g ∈ B, ∀ i : ℕ, i < p → g + (i : ℤ) • u' ∈ Q)
    (hamb : SemiAmbiguousAlong η x S Q u' τ) :
    ∃ q : ℕ, 0 < q ∧ ∀ g ∈ B, ∀ t : ℤ, τ + (p : ℤ) ≤ t →
      x (g + (t + (q : ℤ)) • u') = x (g + t • u') := by
  classical
  have hall : ∀ g ∈ B, ∃ q : ℕ, 0 < q ∧ ∀ t : ℤ, τ + (p : ℤ) ≤ t →
      x (g + (t + (q : ℤ)) • u') = x (g + t • u') := fun g hg =>
    exists_period_along_of_semiAmbiguous hfinη hx hQS hdef (hline g hg) hamb
  choose! qf hqf0 hqf using hall
  refine ⟨∏ g ∈ B, qf g, Finset.prod_pos (fun g hg => hqf0 g hg), ?_⟩
  intro g hg t ht
  obtain ⟨m, hm⟩ : qf g ∣ ∏ g' ∈ B, qf g' := Finset.dvd_prod_of_mem qf hg
  have e : ((qf g * m : ℕ) : ℤ) = (m : ℤ) * ((qf g : ℕ) : ℤ) := by push_cast; ring
  rw [hm, e]
  exact period_mul (fun s : ℤ => x (g + s • u')) (τ + (p : ℤ)) (hqf g hg) m t ht

/-! ## §4 Regional periodicity (Definition 2.11) and the assembly of Lemma 4.1 -/

/-- **Definition 2.11.**  `h` is a period of `x|U`: `x_{g+h} = x_g` for every
`g ∈ U ∩ (U − h)`.  Note this is an *overlap-only* condition; it does not ask `U + h ⊆ U`. -/
def PeriodOn {A : Type*} (x : Config A) (U : Set (ℤ × ℤ)) (h : ℤ × ℤ) : Prop :=
  ∀ z ∈ U, z + h ∈ U → x (z + h) = x z

theorem PeriodOn.mono {A : Type*} {x : Config A} {U V : Set (ℤ × ℤ)} {h : ℤ × ℤ}
    (hUV : U ⊆ V) (hp : PeriodOn x V h) : PeriodOn x U h :=
  fun z hz hz' => hp z (hUV hz) (hUV hz')

theorem PeriodOn.neg {A : Type*} {x : Config A} {U : Set (ℤ × ℤ)} {h : ℤ × ℤ}
    (hp : PeriodOn x U h) : PeriodOn x U (-h) := by
  intro z hz hz'
  have e : z + -h + h = z := by abel
  have := hp (z + -h) hz' (by rw [e]; exact hz)
  rw [e] at this
  exact this.symm

/-- `U` contains the whole ray `z₀, z₀ + v, z₀ + 2v, …`. -/
def RayIn (U : Set (ℤ × ℤ)) (z₀ v : ℤ × ℤ) : Prop := ∀ k : ℕ, z₀ + (k : ℤ) • v ∈ U

theorem RayIn.nsmul {U : Set (ℤ × ℤ)} {z₀ v : ℤ × ℤ} (h : RayIn U z₀ v) (n : ℕ) :
    RayIn U z₀ ((n : ℤ) • v) := by
  intro k
  have e : (k : ℤ) • ((n : ℤ) • v) = ((k * n : ℕ) : ℤ) • v := by
    rw [smul_smul]; norm_cast
  rw [e]; exact h (k * n)

/-- The part of Definition 3.1 that the statement of Lemma 4.1 actually uses: `K` is a
lattice-convex region carrying a semi-infinite edge in the direction of `ℓ` and one in the
direction of `ℓ'`.  (Colle additionally prescribes the cyclic order `w ≺ ⋯ ≺ w'` of the two
edges; that orientation datum is not used below and is dropped.) -/
def IsRegion (K : Set (ℤ × ℤ)) (u u' : ℤ × ℤ) : Prop :=
  IsLatticeConvexRegion K ∧ (∃ z₀ : ℤ × ℤ, RayIn K z₀ u) ∧ (∃ z₀' : ℤ × ℤ, RayIn K z₀' u')

private theorem det_smul_smul (a b : ℤ) (v w : ℤ × ℤ) :
    det (a • v) (b • w) = a * b * det v w := by
  simp only [det, Prod.smul_def, smul_eq_mul]; ring

/-- **Colle, Lemma 4.1 (i)**, assembled.

Hypotheses `hdef`, `hline`, `hamb`, `hRper` are the hypotheses of the paper; `hsweep` is
Claim 4.3, which is *assumed* (see the "What is assumed" section of the module docstring).
Everything else — Claim 4.2 (Theorem 1.2 plus the ambiguity count), the passage to a single
period for the whole half-strip, and the extraction of the two independent periods — is
proved here. -/
theorem lemma41_of_sweep {A : Type*} {η x : Config A}
    (hfinη : (Set.range η).Finite) (hx : x ∈ orbitClosure η)
    {S Q : Finset (ℤ × ℤ)} (hQS : Q ⊆ S) {u u' : ℤ × ℤ} {τ : ℤ} {p : ℕ}
    (hdet : det u u' ≠ 0)
    (hdef : P η S ≤ P η Q + p)
    {B : Finset (ℤ × ℤ)}
    (hline : ∀ g ∈ B, ∀ i : ℕ, i < p → g + (i : ℤ) • u' ∈ Q)
    (hamb : SemiAmbiguousAlong η x S Q u' τ)
    {R : Set (ℤ × ℤ)} {c : ℤ} (hc : c ≠ 0) (hRper : PeriodOn x R (c • u))
    (hsweep : ∀ q : ℕ, 0 < q →
        (∀ g ∈ B, ∀ t : ℤ, τ + (p : ℤ) ≤ t → x (g + (t + (q : ℤ)) • u') = x (g + t • u')) →
        ∃ K : Set (ℤ × ℤ), K ⊆ R ∧ IsRegion K u u' ∧ K.Nonempty ∧
          ∃ t₀ : ℕ, 0 < t₀ ∧ PeriodOn x K (((t₀ * q : ℕ) : ℤ) • u')) :
    ∃ K : Set (ℤ × ℤ), K ⊆ R ∧ IsLatticeConvexRegion K ∧ K.Nonempty ∧
      ∃ h h' z₀ z₀' : ℤ × ℤ, det h h' ≠ 0 ∧
        RayIn K z₀ h ∧ RayIn K z₀' h' ∧ PeriodOn x K h ∧ PeriodOn x K h' := by
  obtain ⟨q, hq, hqper⟩ :=
    exists_common_period_of_semiAmbiguous hfinη hx hQS hdef B hline hamb
  obtain ⟨K, hKR, ⟨hKconv, ⟨z₀, hray⟩, ⟨z₀', hray'⟩⟩, hKne, t₀, ht₀, hKper'⟩ :=
    hsweep q hq hqper
  -- the `ℓ`-period is inherited from `R`; replace `c` by `|c|` so that the ray survives
  refine ⟨K, hKR, hKconv, hKne, (c.natAbs : ℤ) • u, ((t₀ * q : ℕ) : ℤ) • u', z₀, z₀', ?_, ?_,
    ?_, ?_, hKper'⟩
  · rw [det_smul_smul]
    have h1 : (c.natAbs : ℤ) ≠ 0 := by
      simpa using hc
    have h2 : ((t₀ * q : ℕ) : ℤ) ≠ 0 := by
      have : 0 < t₀ * q := Nat.mul_pos ht₀ hq
      omega
    exact mul_ne_zero (mul_ne_zero h1 h2) hdet
  · exact hray.nsmul c.natAbs
  · exact hray'.nsmul (t₀ * q)
  · -- `|c| • u` is `± (c • u)`, and both are periods of `x|K`
    have hKper : PeriodOn x K (c • u) := hRper.mono hKR
    rcases Int.natAbs_eq c with h | h
    · rw [← h]; exact hKper
    · have e : (c.natAbs : ℤ) • u = -(c • u) := by
        conv_rhs => rw [h]
        rw [neg_smul, neg_neg]
      rw [e]; exact hKper.neg

/-! ## §5 Non-vacuity -/

theorem isLatticeConvexRegion_univ : IsLatticeConvexRegion (Set.univ : Set (ℤ × ℤ)) :=
  ⟨Set.univ, convex_univ, isClosed_univ, by simp⟩

/-- **Non-vacuity check.**  The conclusion of Lemma 4.1 is *not* automatic: for the
configuration `x = Prod.fst` and the (nonempty, lattice-convex) region `K = ℤ²` there is no
pair of periods of `x|K` with non-zero determinant.  So `det h h' ≠ 0` in the conclusion
above carries real content. -/
theorem full_periodicity_not_automatic :
    ¬ ∃ h h' : ℤ × ℤ, det h h' ≠ 0 ∧
      PeriodOn (Prod.fst : Config ℤ) Set.univ h ∧
      PeriodOn (Prod.fst : Config ℤ) Set.univ h' := by
  rintro ⟨h, h', hdet, hp, hp'⟩
  have k1 : h.1 = 0 := by
    have := hp 0 (Set.mem_univ _) (Set.mem_univ _)
    simpa using this
  have k2 : h'.1 = 0 := by
    have := hp' 0 (Set.mem_univ _) (Set.mem_univ _)
    simpa using this
  exact hdet (by simp [det, k1, k2])

/-- The conclusion of `lemma41_of_sweep` spelled out in exactly the shape of the region
clause of the `Nivat.colle_region` axiom (`RayIn` and `PeriodOn` unfolded). -/
theorem lemma41_colle_region_shape {A : Type*} {η x : Config A}
    (hfinη : (Set.range η).Finite) (hx : x ∈ orbitClosure η)
    {S Q : Finset (ℤ × ℤ)} (hQS : Q ⊆ S) {u u' : ℤ × ℤ} {τ : ℤ} {p : ℕ}
    (hdet : det u u' ≠ 0)
    (hdef : P η S ≤ P η Q + p)
    {B : Finset (ℤ × ℤ)}
    (hline : ∀ g ∈ B, ∀ i : ℕ, i < p → g + (i : ℤ) • u' ∈ Q)
    (hamb : SemiAmbiguousAlong η x S Q u' τ)
    {R : Set (ℤ × ℤ)} {c : ℤ} (hc : c ≠ 0) (hRper : PeriodOn x R (c • u))
    (hsweep : ∀ q : ℕ, 0 < q →
        (∀ g ∈ B, ∀ t : ℤ, τ + (p : ℤ) ≤ t → x (g + (t + (q : ℤ)) • u') = x (g + t • u')) →
        ∃ K : Set (ℤ × ℤ), K ⊆ R ∧ IsRegion K u u' ∧ K.Nonempty ∧
          ∃ t₀ : ℕ, 0 < t₀ ∧ PeriodOn x K (((t₀ * q : ℕ) : ℤ) • u')) :
    ∃ K : Set (ℤ × ℤ), K ⊆ R ∧ IsLatticeConvexRegion K ∧ K.Nonempty ∧
      ∃ h h' z₀ z₀' : ℤ × ℤ, det h h' ≠ 0 ∧
        (∀ k : ℕ, z₀ + (k : ℤ) • h ∈ K) ∧ (∀ k : ℕ, z₀' + (k : ℤ) • h' ∈ K) ∧
        (∀ z ∈ K, z + h ∈ K → x (z + h) = x z) ∧
        (∀ z ∈ K, z + h' ∈ K → x (z + h') = x z) :=
  lemma41_of_sweep hfinη hx hQS hdet hdef hline hamb hc hRper hsweep

/-! ### The direction of the `ℓ'`-period

`lemma41_of_sweep` *constructs* `h' := ((t₀ * q : ℕ) : ℤ) • u'` at `:723` and proves
`0 < t₀ * q` at `:728-730`, then discards both by existential quantification.
`region_periods_and_rays` (`RegionSteps.lean:1397`) needs exactly that discarded data:

    ∃ n : ℕ, 0 < n ∧ h' = (n : ℤ) • cg.vJ

so the two theorems below re-export it.  Per CLAUDE.md 「加强，不替换」 the originals above
keep their statements **verbatim** — `region_case1` (`RegionSteps.lean:1146`) destructures
`lemma41_colle_region_shape` positionally and an added conjunct would break it. -/

/-- **Colle, Lemma 4.1 (i), with the direction of the `ℓ'`-period exported.**

Identical to `lemma41_of_sweep` except for the final conjunct
`∃ n : ℕ, 0 < n ∧ h' = (n : ℤ) • u'`, which is `⟨t₀ * q, Nat.mul_pos ht₀ hq, rfl⟩` — data
that proof already has.  No hypothesis is added, none becomes idle. -/
theorem lemma41_of_sweep_parallel {A : Type*} {η x : Config A}
    (hfinη : (Set.range η).Finite) (hx : x ∈ orbitClosure η)
    {S Q : Finset (ℤ × ℤ)} (hQS : Q ⊆ S) {u u' : ℤ × ℤ} {τ : ℤ} {p : ℕ}
    (hdet : det u u' ≠ 0)
    (hdef : P η S ≤ P η Q + p)
    {B : Finset (ℤ × ℤ)}
    (hline : ∀ g ∈ B, ∀ i : ℕ, i < p → g + (i : ℤ) • u' ∈ Q)
    (hamb : SemiAmbiguousAlong η x S Q u' τ)
    {R : Set (ℤ × ℤ)} {c : ℤ} (hc : c ≠ 0) (hRper : PeriodOn x R (c • u))
    (hsweep : ∀ q : ℕ, 0 < q →
        (∀ g ∈ B, ∀ t : ℤ, τ + (p : ℤ) ≤ t → x (g + (t + (q : ℤ)) • u') = x (g + t • u')) →
        ∃ K : Set (ℤ × ℤ), K ⊆ R ∧ IsRegion K u u' ∧ K.Nonempty ∧
          ∃ t₀ : ℕ, 0 < t₀ ∧ PeriodOn x K (((t₀ * q : ℕ) : ℤ) • u')) :
    ∃ K : Set (ℤ × ℤ), K ⊆ R ∧ IsLatticeConvexRegion K ∧ K.Nonempty ∧
      ∃ h h' z₀ z₀' : ℤ × ℤ, det h h' ≠ 0 ∧
        RayIn K z₀ h ∧ RayIn K z₀' h' ∧ PeriodOn x K h ∧ PeriodOn x K h' ∧
        ∃ n : ℕ, 0 < n ∧ h' = (n : ℤ) • u' := by
  obtain ⟨q, hq, hqper⟩ :=
    exists_common_period_of_semiAmbiguous hfinη hx hQS hdef B hline hamb
  obtain ⟨K, hKR, ⟨hKconv, ⟨z₀, hray⟩, ⟨z₀', hray'⟩⟩, hKne, t₀, ht₀, hKper'⟩ :=
    hsweep q hq hqper
  refine ⟨K, hKR, hKconv, hKne, (c.natAbs : ℤ) • u, ((t₀ * q : ℕ) : ℤ) • u', z₀, z₀', ?_, ?_,
    ?_, ?_, hKper', ⟨t₀ * q, Nat.mul_pos ht₀ hq, rfl⟩⟩
  · rw [det_smul_smul]
    have h1 : (c.natAbs : ℤ) ≠ 0 := by
      simpa using hc
    have h2 : ((t₀ * q : ℕ) : ℤ) ≠ 0 := by
      have : 0 < t₀ * q := Nat.mul_pos ht₀ hq
      omega
    exact mul_ne_zero (mul_ne_zero h1 h2) hdet
  · exact hray.nsmul c.natAbs
  · exact hray'.nsmul (t₀ * q)
  · have hKper : PeriodOn x K (c • u) := hRper.mono hKR
    rcases Int.natAbs_eq c with h | h
    · rw [← h]; exact hKper
    · have e : (c.natAbs : ℤ) • u = -(c • u) := by
        conv_rhs => rw [h]
        rw [neg_smul, neg_neg]
      rw [e]; exact hKper.neg

/-- `lemma41_of_sweep_parallel` with `RayIn` and `PeriodOn` unfolded: the exact shape
`region_periods_and_rays`' conclusion (`RegionSteps.lean:1390-1397`) asks for, once
`u' := cg.vJ`. -/
theorem lemma41_colle_region_shape_parallel {A : Type*} {η x : Config A}
    (hfinη : (Set.range η).Finite) (hx : x ∈ orbitClosure η)
    {S Q : Finset (ℤ × ℤ)} (hQS : Q ⊆ S) {u u' : ℤ × ℤ} {τ : ℤ} {p : ℕ}
    (hdet : det u u' ≠ 0)
    (hdef : P η S ≤ P η Q + p)
    {B : Finset (ℤ × ℤ)}
    (hline : ∀ g ∈ B, ∀ i : ℕ, i < p → g + (i : ℤ) • u' ∈ Q)
    (hamb : SemiAmbiguousAlong η x S Q u' τ)
    {R : Set (ℤ × ℤ)} {c : ℤ} (hc : c ≠ 0) (hRper : PeriodOn x R (c • u))
    (hsweep : ∀ q : ℕ, 0 < q →
        (∀ g ∈ B, ∀ t : ℤ, τ + (p : ℤ) ≤ t → x (g + (t + (q : ℤ)) • u') = x (g + t • u')) →
        ∃ K : Set (ℤ × ℤ), K ⊆ R ∧ IsRegion K u u' ∧ K.Nonempty ∧
          ∃ t₀ : ℕ, 0 < t₀ ∧ PeriodOn x K (((t₀ * q : ℕ) : ℤ) • u')) :
    ∃ K : Set (ℤ × ℤ), K ⊆ R ∧ IsLatticeConvexRegion K ∧ K.Nonempty ∧
      ∃ h h' z₀ z₀' : ℤ × ℤ, det h h' ≠ 0 ∧
        (∀ k : ℕ, z₀ + (k : ℤ) • h ∈ K) ∧ (∀ k : ℕ, z₀' + (k : ℤ) • h' ∈ K) ∧
        (∀ z ∈ K, z + h ∈ K → x (z + h) = x z) ∧
        (∀ z ∈ K, z + h' ∈ K → x (z + h') = x z) ∧
        ∃ n : ℕ, 0 < n ∧ h' = (n : ℤ) • u' :=
  lemma41_of_sweep_parallel hfinη hx hQS hdet hdef hline hamb hc hRper hsweep

/-! ## §6 The Claim 4.2 hypothesis bundle is satisfiable

A theorem whose hypotheses are contradictory proves nothing.  This section exhibits a
concrete configuration satisfying every hypothesis of
`wordsFrom_ncard_le_of_semiAmbiguous` / `exists_period_along_of_semiAmbiguous`
simultaneously, with `p = 1` and a non-empty `Q`. -/

/-- The "row" configuration: `η (a, b) = 1` if `b = 1` and `0` otherwise. -/
def rowConfig : Config ℕ := fun z => if z.2 = 1 then 1 else 0

/-- `Q = {(0,0)}`. -/
def wQ : Finset (ℤ × ℤ) := {(0, 0)}

/-- `S = {(0,0), (0,1)}`. -/
def wS : Finset (ℤ × ℤ) := {(0, 0), (0, 1)}

theorem wQ_subset_wS : wQ ⊆ wS := by
  intro z hz
  simp only [wQ, Finset.mem_singleton] at hz
  simp [wS, hz]

theorem rowConfig_range_finite : (Set.range rowConfig).Finite := by
  refine Set.Finite.subset ((Set.finite_singleton (1 : ℕ)).insert 0) ?_
  rintro _ ⟨z, rfl⟩
  by_cases h : z.2 = 1 <;> simp [rowConfig, h]

theorem two_le_P_rowConfig_wQ : 2 ≤ P rowConfig wQ := by
  have hfin : (patterns rowConfig wQ).Finite :=
    patterns_finite_of_range_finite rowConfig_range_finite wQ
  show 1 < (patterns rowConfig wQ).ncard
  rw [Set.one_lt_ncard hfin]
  refine ⟨pattern rowConfig wQ (0, 0), ⟨(0, 0), rfl⟩,
          pattern rowConfig wQ (0, 1), ⟨(0, 1), rfl⟩, ?_⟩
  intro hcon
  have := congrFun hcon ⟨(0, 0), by simp [wQ]⟩
  simp [pattern, rowConfig] at this

theorem P_rowConfig_wS_le_three : P rowConfig wS ≤ 3 := by
  have hsub : patterns rowConfig wS ⊆
      ({pattern rowConfig wS (0, 0), pattern rowConfig wS (0, 1),
        pattern rowConfig wS (0, 2)} : Set (↥wS → ℕ)) := by
    rintro _ ⟨u, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    rcases eq_or_ne u.2 0 with h0 | h0
    · refine Or.inl ?_
      funext z
      obtain ⟨z, hz⟩ := z
      simp only [wS, Finset.mem_insert, Finset.mem_singleton] at hz
      rcases hz with rfl | rfl <;> simp [pattern, rowConfig, h0]
    · rcases eq_or_ne u.2 1 with h1 | h1
      · refine Or.inr (Or.inl ?_)
        funext z
        obtain ⟨z, hz⟩ := z
        simp only [wS, Finset.mem_insert, Finset.mem_singleton] at hz
        rcases hz with rfl | rfl <;> simp [pattern, rowConfig, h1]
      · refine Or.inr (Or.inr ?_)
        funext z
        obtain ⟨z, hz⟩ := z
        simp only [wS, Finset.mem_insert, Finset.mem_singleton] at hz
        rcases hz with rfl | rfl <;>
          simp [pattern, rowConfig, h0, h1]
  have h3 : ({pattern rowConfig wS (0, 0), pattern rowConfig wS (0, 1),
      pattern rowConfig wS (0, 2)} : Set (↥wS → ℕ)).ncard ≤ 3 := by
    refine le_trans (Set.ncard_insert_le _ _) ?_
    have h2 : ({pattern rowConfig wS (0, 1), pattern rowConfig wS (0, 2)} :
        Set (↥wS → ℕ)).ncard ≤ 2 := by
      refine le_trans (Set.ncard_insert_le _ _) ?_
      simp
    omega
  exact le_trans (Set.ncard_le_ncard hsub (Set.toFinite _)) h3

theorem rowConfig_hline : ∀ i : ℕ, i < 1 → ((0, 0) : ℤ × ℤ) + (i : ℤ) • ((1, 0) : ℤ × ℤ) ∈ wQ := by
  intro i hi
  have : i = 0 := by omega
  subst this
  simp [wQ]

theorem rowConfig_semiAmbiguous :
    SemiAmbiguousAlong rowConfig rowConfig wS wQ (1, 0) 0 := by
  intro t _
  refine ⟨(0, 0), (0, 2), ?_, ?_, (0, 1), by simp [wS], ?_⟩
  · intro z hz
    simp only [wQ, Finset.mem_singleton] at hz
    subst hz
    simp [rowConfig, Prod.smul_def]
  · intro z hz
    simp only [wQ, Finset.mem_singleton] at hz
    subst hz
    simp [rowConfig, Prod.smul_def]
  · simp [rowConfig]

/-- **Non-vacuity, part 2.**  Every hypothesis of `wordsFrom_ncard_le_of_semiAmbiguous` is
satisfied simultaneously by `rowConfig` with `p = 1`, `Q = {(0,0)} ≠ ∅`, `S = {(0,0),(0,1)}`,
`u' = (1,0)`, `τ = 0`.  In particular the hypothesis bundle is consistent and the deficit
hypothesis `P η S ≤ P η Q + p` is not being used to smuggle in a contradiction. -/
theorem claim42_hypotheses_satisfiable :
    (Set.range rowConfig).Finite ∧
      rowConfig ∈ orbitClosure rowConfig ∧
      wQ ⊆ wS ∧ wQ.Nonempty ∧
      P rowConfig wS ≤ P rowConfig wQ + 1 ∧
      (∀ i : ℕ, i < 1 → ((0, 0) : ℤ × ℤ) + (i : ℤ) • ((1, 0) : ℤ × ℤ) ∈ wQ) ∧
      SemiAmbiguousAlong rowConfig rowConfig wS wQ (1, 0) 0 := by
  refine ⟨rowConfig_range_finite, self_mem_orbitClosure rowConfig, wQ_subset_wS,
    ⟨(0, 0), by simp [wQ]⟩, ?_, rowConfig_hline, rowConfig_semiAmbiguous⟩
  have h1 := P_rowConfig_wS_le_three
  have h2 := two_le_P_rowConfig_wQ
  omega

/-- The conclusion of Claim 4.2 for that witness, obtained by applying the general theorem:
along the line `{(t, 0) : t ≥ 0}` the configuration `rowConfig` reads at most one word of
length `1`.  (Confirms that the general theorem is applicable, not merely true.) -/
theorem claim42_applied_to_rowConfig :
    (wordsFrom (fun t : ℤ => rowConfig (((0, 0) : ℤ × ℤ) + t • ((1, 0) : ℤ × ℤ))) 0 1).Finite ∧
      (wordsFrom (fun t : ℤ => rowConfig (((0, 0) : ℤ × ℤ) + t • ((1, 0) : ℤ × ℤ))) 0 1).ncard
        ≤ 1 := by
  refine wordsFrom_ncard_le_of_semiAmbiguous rowConfig_range_finite
    (self_mem_orbitClosure rowConfig) wQ_subset_wS ?_ rowConfig_hline rowConfig_semiAmbiguous
  have h1 := P_rowConfig_wS_le_three
  have h2 := two_le_P_rowConfig_wQ
  omega

end Nivat.Colle41
