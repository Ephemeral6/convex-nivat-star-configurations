        -- 6b.  The translate that puts the face endpoint `a` at level `K - 1`
        obtain ⟨xK, hxKval⟩ : ∃ f : Config A, ∀ zz : ℤ × ℤ, f zz = x ((z₁ - a) + zz) :=
