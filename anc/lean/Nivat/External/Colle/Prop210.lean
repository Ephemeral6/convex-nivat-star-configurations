namespace Nivat.Colle

variable {A : Type*}

/-! ## Colle's `(ℓ,𝒮)`-ambiguity -/

/-- Colle's `(ℓ,𝒮)`-ambiguity, unfolded.  `x` is `(ℓ,𝒮)`-ambiguous when, for
every `t : ℤ`, the `Q`-pattern `(T^{t v} x)|_Q` (with `Q = 𝒮 \ ℓ_𝒮`) has at
least two distinct extensions to an `𝒮`-pattern of `ξ`, i.e.
`N_𝒮(ℓ, (T^{t v} x)|_Q) > 1`. -/
def AmbiguousAlong (ξ : Config A) (Q S : Finset (ℤ × ℤ)) (x : Config A)
    (v : ℤ × ℤ) : Prop :=
  ∀ t : ℤ, ∃ u₁ u₂ : ℤ × ℤ, pattern ξ S u₁ ≠ pattern ξ S u₂ ∧
    (∀ q ∈ Q, ξ (u₁ + q) = x (t • v + q)) ∧ (∀ q ∈ Q, ξ (u₂ + q) = x (t • v + q))

/-- An `(ℓ,𝒮)`-ambiguous configuration produces, at every `t`, an element of
`ambiguous_patterns` whose underlying function is the shifted `Q`-pattern
of `x`.  This is the bridge to the counting lemma
`ncard_ambiguous_patterns_le_sub`. -/
theorem exists_ambiguous_pattern_of_ambiguousAlong {ξ x : Config A}
    {Q S : Finset (ℤ × ℤ)} (hQS : Q ⊆ S) {v : ℤ × ℤ}
    (hamb : AmbiguousAlong ξ Q S x v) (t : ℤ) :
    ∃ p ∈ ambiguous_patterns ξ hQS, (p : Q → A) = pattern x Q (t • v) := by
  obtain ⟨u₁, u₂, hne, h₁, h₂⟩ := hamb t
  refine ⟨restrict_occurring_pattern ξ hQS ⟨pattern ξ S u₁, u₁, rfl⟩, ?_, ?_⟩
  · refine ⟨⟨pattern ξ S u₁, u₁, rfl⟩, ⟨pattern ξ S u₂, u₂, rfl⟩, ?_, rfl, ?_⟩
    · exact fun hab => hne (congrArg Subtype.val hab)
    · apply Subtype.ext
      funext q
      show ξ (u₂ + (q : ℤ × ℤ)) = ξ (u₁ + (q : ℤ × ℤ))
      rw [h₂ q.1 q.2, h₁ q.1 q.2]
  · funext q
    show ξ (u₁ + (q : ℤ × ℤ)) = x (t • v + (q : ℤ × ℤ))
    exact h₁ q.1 q.2

/-! ## Colle Lemma 2.3: a one-point face kills the direction

If the face `S ∩ ℓ_S` of an `η`-generating set is a single point, that point
is a vertex of `S` (deleting it leaves a lattice-convex set, since it is cut
off by a half plane), hence `η`-generated, hence the half plane `ℋ(ℓ)`
determines every element of the orbit closure: `ℓ ∉ ONED(η)`.
-/

private theorem inner2_neg_normal (w : ℝ × ℝ) (z : ℤ × ℤ) :
    inner2 (-w) z = -inner2 w z := by
  simp only [inner2, Prod.fst_neg, Prod.snd_neg]
  ring

/-- Colle Lemma 2.3 in the coordinates used here: if `S` is an
`η`-generating set whose face at the minimal level `c` of `inner2 w` is a
single point, then no two distinct elements of the orbit closure agree on
the half plane `{z | 0 ≤ inner2 w z}`.  In Colle's language: `ℓ ∉ ONED(η)`. -/
theorem not_oneSidedNonexpansive_of_card_face_le_one {ξ : Config A}
    {S : Finset (ℤ × ℤ)} (hgen : IsGeneratingSet ξ S) {w : ℝ × ℝ} {c : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z)
    (hface : (S.filter fun z => inner2 w z = c).card ≤ 1)
    (hne : (S.filter fun z => inner2 w z = c).Nonempty) :
    ¬ ∃ y ∈ orbitClosure ξ, ∃ y' ∈ orbitClosure ξ, y ≠ y' ∧
        ∀ z : ℤ × ℤ, 0 ≤ inner2 w z → y z = y' z := by
  classical
  rintro ⟨y, hy, y', hy', hyy', hagree⟩
  obtain ⟨a, ha⟩ := hne
  have hcard : (S.filter fun z => inner2 w z = c) = {a} :=
    Finset.eq_singleton_iff_unique_mem.mpr
      ⟨ha, fun b hb => Finset.card_le_one.mp hface b hb a ha⟩
  obtain ⟨haS, hac⟩ := Finset.mem_filter.mp ha
  -- deleting `a` leaves the strict half plane `inner2 (-w) · < -c`, hence
  -- a lattice-convex set, so `a` is a vertex of `S` in Colle's sense
  have herase : S.erase a = S.filter fun z => inner2 (-w) z < -c := by
    ext z
    simp only [Finset.mem_erase, Finset.mem_filter, inner2_neg_normal, neg_lt_neg_iff]
    constructor
    · rintro ⟨hza, hzS⟩
      refine ⟨hzS, lt_of_le_of_ne (hmin z hzS) ?_⟩
      intro hzc
      apply hza
      have : z ∈ S.filter fun z => inner2 w z = c :=
        Finset.mem_filter.mpr ⟨hzS, hzc.symm⟩
      rw [hcard] at this
      exact Finset.mem_singleton.mp this
    · rintro ⟨hzS, hzc⟩
      refine ⟨?_, hzS⟩
      intro hza
      rw [hza, hac] at hzc
      exact lt_irrefl c hzc
  have hdel : LatticeConvex (S.erase a) := by
    rw [herase]
    exact latticeConvex_filter_inner2_lt hgen.2.1 (-w) (-c)
  have hgenA : GeneratesAt ξ S a := hgen.2.2 a haS hdel
  -- `a` is the strict minimiser of `inner2 w` on `S`
  have hstrict : ∀ b ∈ S.erase a, inner2 w a < inner2 w b := by
    intro b hb
    rw [herase] at hb
    obtain ⟨hbS, hbc⟩ := Finset.mem_filter.mp hb
    rw [inner2_neg_normal] at hbc
    rw [hac]
    linarith
  exact hyy' (eq_of_halfPlane_of_generatesAt hy hy' hgenA hstrict hagree)

/-- The contrapositive form used in Proposition 2.10: one-sided
nonexpansiveness of `ℓ` forces the face `S ∩ ℓ_S` of an `η`-generating set
to have at least two points, i.e. `h = |S ∩ ℓ_S| - 1 ≥ 1`. -/
theorem two_le_card_face_of_oneSidedNonexpansive {ξ : Config A}
    {S : Finset (ℤ × ℤ)} (hgen : IsGeneratingSet ξ S) {w : ℝ × ℝ} {c : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z)
    (hne : (S.filter fun z => inner2 w z = c).Nonempty)
    (honed : ∃ y ∈ orbitClosure ξ, ∃ y' ∈ orbitClosure ξ, y ≠ y' ∧
        ∀ z : ℤ × ℤ, 0 ≤ inner2 w z → y z = y' z) :
    2 ≤ (S.filter fun z => inner2 w z = c).card := by
  by_contra hcon
  exact not_oneSidedNonexpansive_of_card_face_le_one hgen hmin (by omega) hne honed

/-! ## The core of Cyr-Kra Lemma 2.24

Ambiguity along `v` bounds the block complexity of the transverse row
sequence, and Morse-Hedlund turns that into a period.
-/

/-- **Cyr-Kra Lemma 2.24, core step.**  Suppose `x` lies in the orbit
closure of a finite-range `ξ`, that `x` is `(ℓ,𝒮)`-ambiguous along `v` with
respect to `Q ⊆ S`, that `P ξ S - P ξ Q ≤ h` with `0 < h`, and that `B` is a
finite set with `B + j • v ⊆ Q` for every `j < h` (the first `h` points of
each row of `Q`).  Then `x` has a non-zero period parallel to `v` on the
union of the lines through `B`.

The proof is Cyr-Kra's verbatim: the `h`-blocks of the row sequence
`g t := x|_{B + t • v}` are all read off from the ambiguous `Q`-patterns of
`x`, of which there are at most `P ξ S - P ξ Q ≤ h`; so the one-dimensional
block complexity satisfies `P_g(h) ≤ h`, and Morse-Hedlund applies. -/
theorem exists_row_period_of_ambiguousAlong {ξ x : Config A}
    (hξ : (Set.range ξ).Finite) (hx : x ∈ orbitClosure ξ)
    {Q S : Finset (ℤ × ℤ)} (hQS : Q ⊆ S) {v : ℤ × ℤ}
    (hamb : AmbiguousAlong ξ Q S x v)
    {B : Finset (ℤ × ℤ)} {h : ℕ} (hh : 0 < h)
    (hrow : ∀ j : ℕ, j < h → ∀ b ∈ B, (j : ℤ) • v + b ∈ Q)
    (hcount : P ξ S - P ξ Q ≤ h) :
    ∃ q : ℕ, 0 < q ∧
      ∀ (t : ℤ) (b : ℤ × ℤ), b ∈ B → x ((t + (q : ℤ)) • v + b) = x (t • v + b) := by
  classical
  have := hξ.to_subtype
  have : Finite (patterns ξ Q) := (patterns_finite_of_range_finite hξ Q).to_subtype
  -- every value of `x` is a value of `ξ`
  have hxr : ∀ z : ℤ × ℤ, x z ∈ Set.range ξ := by
    intro z
    obtain ⟨u, hu⟩ := hx {z}
    exact ⟨u + z, (hu z (Finset.mem_singleton_self z)).symm⟩
  -- every value of a `Q`-pattern of `ξ` is a value of `ξ`
  have hval : ∀ (p : patterns ξ Q) (q : Q), (p : Q → A) q ∈ Set.range ξ := by
    rintro ⟨p, u, rfl⟩ q
    exact ⟨u + (q : ℤ × ℤ), rfl⟩
  -- the transverse row sequence
  set g : ℤ → (B → Set.range ξ) := fun t b => ⟨x (t • v + (b : ℤ × ℤ)), hxr _⟩ with hg
  -- reading an `h`-block off a `Q`-pattern
  set Ψ : patterns ξ Q → (Fin h → (B → Set.range ξ)) := fun p l b =>
    ⟨(p : Q → A) ⟨((l : ℕ) : ℤ) • v + (b : ℤ × ℤ), hrow (l : ℕ) l.isLt (b : ℤ × ℤ) b.2⟩,
      hval p _⟩ with hΨ
  have hsub : subwords g h ⊆ Ψ '' (ambiguous_patterns ξ hQS) := by
    rintro _ ⟨t, rfl⟩
    obtain ⟨p, hp, hpv⟩ := exists_ambiguous_pattern_of_ambiguousAlong hQS hamb t
    refine ⟨p, hp, ?_⟩
    funext l b
    apply Subtype.ext
    show (p : Q → A) _ = x ((t + ((l : ℕ) : ℤ)) • v + (b : ℤ × ℤ))
    rw [hpv]
    show x (t • v + (((l : ℕ) : ℤ) • v + (b : ℤ × ℤ))) =
      x ((t + ((l : ℕ) : ℤ)) • v + (b : ℤ × ℤ))
    congr 1
    rw [add_smul]
    abel
  have hcard : (subwords g h).ncard ≤ h := by
    calc (subwords g h).ncard
        ≤ (Ψ '' (ambiguous_patterns ξ hQS)).ncard :=
          Set.ncard_le_ncard hsub (Set.toFinite _)
      _ ≤ (ambiguous_patterns ξ hQS).ncard := Set.ncard_image_le (Set.toFinite _)
      _ ≤ P ξ S - P ξ Q := ncard_ambiguous_patterns_le_sub hξ hQS
      _ ≤ h := hcount
  obtain ⟨q, hq, hper⟩ := periodic_of_subwords_le g hh hcard
  refine ⟨q, hq, fun t b hb => ?_⟩
  exact congrArg Subtype.val (congrFun (hper t) ⟨b, hb⟩)

/-! ## The geometric input: Cyr-Kra's height lemma

Cyr-Kra's height lemma itself is already available in this repository, proved
unconditionally, as `Nivat.card_row_ge_of_extreme` (`Nivat/Chord.lean`): if two
levels of `pi v = det v ·` on a lattice-convex set each carry at least `n`
points, every intermediate level carries at least `n - 1`.  What remains is to
translate between the real linear form `inner2 w` used by Colle and the integral
form `det v ·`, and to package the rows as contiguous runs.
-/

/-- A non-zero real normal `w` with `inner2 w v = 0`, `v ≠ 0`, is a non-zero real multiple
of the *integral* linear form `det v ·`: both vanish exactly on the real line `ℝ v`. -/
private theorem exists_ratio_of_inner2_eq_zero {v : ℤ × ℤ} (hv0 : v ≠ 0) {w : ℝ × ℝ}
    (hw : w ≠ 0) (hwv : inner2 w v = 0) :
    ∃ μ : ℝ, μ ≠ 0 ∧ ∀ z : ℤ × ℤ, inner2 w z = μ * ((det v z : ℤ) : ℝ) := by
  have hwv' : (v.1 : ℝ) * w.1 + (v.2 : ℝ) * w.2 = 0 := hwv
  have hcoord : ∀ z : ℤ × ℤ, inner2 w z = (z.1 : ℝ) * w.1 + (z.2 : ℝ) * w.2 := fun _ => rfl
  have hdet : ∀ z : ℤ × ℤ,
      ((det v z : ℤ) : ℝ) = (v.1 : ℝ) * (z.2 : ℝ) - (v.2 : ℝ) * (z.1 : ℝ) := by
    intro z
    simp only [det]
    push_cast
    ring
  have hv12 : v.1 ≠ 0 ∨ v.2 ≠ 0 := by
    rcases eq_or_ne v.1 0 with h | h
    · rcases eq_or_ne v.2 0 with h' | h'
      · exact absurd (Prod.ext h h') hv0
      · exact Or.inr h'
    · exact Or.inl h
  rcases hv12 with h1 | h2
  · have h1R : (v.1 : ℝ) ≠ 0 := Int.cast_ne_zero.mpr h1
    have hw2 : w.2 ≠ 0 := by
      intro hc
      apply hw
      have hw1 : w.1 = 0 := by
        rw [hc, mul_zero, add_zero] at hwv'
        exact (mul_eq_zero.mp hwv').resolve_left h1R
      exact Prod.ext hw1 hc
    refine ⟨w.2 / (v.1 : ℝ), div_ne_zero hw2 h1R, fun z => ?_⟩
    rw [hcoord z, hdet z, div_mul_eq_mul_div, eq_div_iff h1R]
    linear_combination (z.1 : ℝ) * hwv'
  · have h2R : (v.2 : ℝ) ≠ 0 := Int.cast_ne_zero.mpr h2
    have hw1 : w.1 ≠ 0 := by
      intro hc
      apply hw
      have hw2 : w.2 = 0 := by
        rw [hc, mul_zero, zero_add] at hwv'
        exact (mul_eq_zero.mp hwv').resolve_left h2R
      exact Prod.ext hc hw2
    refine ⟨-w.1 / (v.2 : ℝ), div_ne_zero (neg_ne_zero.mpr hw1) h2R, fun z => ?_⟩
    rw [hcoord z, hdet z, div_mul_eq_mul_div, eq_div_iff h2R]
    linear_combination (z.2 : ℝ) * hwv'

/-- Each row `{z ∈ S | det v z = t}` of a lattice-convex `S`, read in a unimodular basis
`(v, u)`, is a *contiguous run* of lattice points along `v`: if `z₁, z₂ ∈ S` lie on the row
and `s` lies between their `v`-coordinates `det · u`, then the lattice point of that row with
`v`-coordinate `s` lies in `S`.  This is immediate from convexity: the point in question lies
on the segment `[z₁, z₂]`.

This is the implicit step in Cyr-Kra's Lemma 2.24 where `x_ℓ`, "the bottom-most element of
`ℓ ∩ 𝒮`", is used together with the height lemma to conclude `x_ℓ + (0,i) ∈ 𝒮` for `i < h`. -/
private theorem mem_row_of_between {S : Finset (ℤ × ℤ)} (hS : LatticeConvex S)
    {v u : ℤ × ℤ} (hvu : det v u = 1) {t s : ℤ} {z₁ z₂ : ℤ × ℤ}
    (h₁ : z₁ ∈ S) (h₂ : z₂ ∈ S) (ht₁ : det v z₁ = t) (ht₂ : det v z₂ = t)
    (hs₁ : det z₁ u ≤ s) (hs₂ : s ≤ det z₂ u) : s • v + t • u ∈ S := by
  have e1 : z₁ = det z₁ u • v + t • u := by rw [← ht₁]; exact eq_smul_add_smul hvu z₁
  have e2 : z₂ = det z₂ u • v + t • u := by rw [← ht₂]; exact eq_smul_add_smul hvu z₂
  have tr1 : toReal z₁ = ((det z₁ u : ℤ) : ℝ) • toReal v + ((t : ℤ) : ℝ) • toReal u := by
    rw [← toReal_zsmul_add_zsmul, ← e1]
  have tr2 : toReal z₂ = ((det z₂ u : ℤ) : ℝ) • toReal v + ((t : ℤ) : ℝ) • toReal u := by
    rw [← toReal_zsmul_add_zsmul, ← e2]
  apply hS
  rw [toReal_zsmul_add_zsmul]
  rcases eq_or_lt_of_le (hs₁.trans hs₂) with hab | hab
  · have hse : s = det z₁ u := le_antisymm (by omega) hs₁
    rw [hse, ← tr1]
    exact subset_Conv h₁
  · have hs1R : ((det z₁ u : ℤ) : ℝ) ≤ ((s : ℤ) : ℝ) := by exact_mod_cast hs₁
    have hs2R : ((s : ℤ) : ℝ) ≤ ((det z₂ u : ℤ) : ℝ) := by exact_mod_cast hs₂
    have hden : (0 : ℝ) < ((det z₂ u : ℤ) : ℝ) - ((det z₁ u : ℤ) : ℝ) := by
      have : ((det z₁ u : ℤ) : ℝ) < ((det z₂ u : ℤ) : ℝ) := by exact_mod_cast hab
      linarith
    have hdne : ((det z₂ u : ℤ) : ℝ) - ((det z₁ u : ℤ) : ℝ) ≠ 0 := ne_of_gt hden
    set lam : ℝ :=
      (((det z₂ u : ℤ) : ℝ) - ((s : ℤ) : ℝ)) / (((det z₂ u : ℤ) : ℝ) - ((det z₁ u : ℤ) : ℝ))
      with hlam
    have hlam0 : 0 ≤ lam := div_nonneg (by linarith) hden.le
    have hlam1 : lam ≤ 1 := by rw [hlam, div_le_one hden]; linarith
    have hcomb : lam * ((det z₁ u : ℤ) : ℝ) + (1 - lam) * ((det z₂ u : ℤ) : ℝ)
        = ((s : ℤ) : ℝ) := by
      rw [hlam]; field_simp; ring
    have key : ((s : ℤ) : ℝ) • toReal v + ((t : ℤ) : ℝ) • toReal u
        = lam • toReal z₁ + (1 - lam) • toReal z₂ := by
      rw [tr1, tr2]
      apply Prod.ext <;>
        simp only [Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul, toReal]
      · linear_combination (-(v.1 : ℝ)) * hcomb
      · linear_combination (-(v.2 : ℝ)) * hcomb
    rw [key]
    exact (convex_convexHull ℝ _) (subset_Conv h₁) (subset_Conv h₂) hlam0 (by linarith) (by ring)

/-- `pi v` is by definition `det v`, so the two ways of writing a row agree. -/
private theorem filter_pi_eq_filter_det (S : Finset (ℤ × ℤ)) (v : ℤ × ℤ) (t : ℤ) :
    (S.filter fun z => pi v z = t) = S.filter fun z => det v z = t := rfl

/-- **Cyr-Kra Lemma 2.20 (height lemma) plus row structure.**  Verbatim
(arXiv:1208.4090, `\label{heightlemma}`; numbered Lemma 2.11 in the arXiv v2
rendering, Lemma 2.20 in the published version): "Suppose that `𝒮 ⊂ ℤ²` is a
finite convex set and there are two edges `w₁, w₂ ∈ E(𝒮)` that are antiparallel.
Then any line parallel to `w₁` that has nonempty intersection with `𝒮` contains
at least `min_{i=1,2} {|w_i ∩ 𝒮| - 1}` integer points."

Combined with the fact that, for primitive `v`, each row `{z ∈ S | inner2 w z = d}`
of a lattice-convex `S` is a block of consecutive lattice points `b, b + v, …`,
this yields a finite `B` — the lowest point of each row of `S \ ℓ_S`, Cyr-Kra's
`x_ℓ` — with `B + j • v ⊆ S \ ℓ_S` for all `j < |S ∩ ℓ_S| - 1` (Cyr-Kra's `ℛ ⊆ 𝒮`),
and such that every point of `S \ ℓ_S` lies on a line `{k • v + b}` with `b ∈ B`.

Proved.  The height lemma itself is `Nivat.card_row_ge_of_extreme`
(`Nivat/Chord.lean`, unconditional); `B` is `{b ∈ S \ ℓ_S | b is minimal in its
row}`, the rows are contiguous by `mem_row_of_between`, and `inner2 w` is
converted to `det v ·` by `exists_ratio_of_inner2_eq_zero`. -/
theorem exists_rowBase_of_latticeConvex {S : Finset (ℤ × ℤ)}
    (hSc : LatticeConvex S) {v : ℤ × ℤ} (hv : Primitive v)
    {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0) {c c' : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z) (hmax : ∀ z ∈ S, inner2 w z ≤ c')
    (hle : (S.filter fun z => inner2 w z = c).card ≤
      (S.filter fun z => inner2 w z = c').card) :
    ∃ B : Finset (ℤ × ℤ),
      (∀ j : ℕ, j < (S.filter fun z => inner2 w z = c).card - 1 →
        ∀ b ∈ B, (j : ℤ) • v + b ∈ S.filter fun z => c < inner2 w z) ∧
      (∀ z ∈ S.filter fun z => c < inner2 w z, ∃ b ∈ B, ∃ k : ℤ, z = k • v + b) := by
  obtain ⟨u, hvu⟩ := hv.exists_dual
  obtain ⟨μ, hμ, hμz⟩ := exists_ratio_of_inner2_eq_zero hv.ne_zero hw hwv
  set Q : Finset (ℤ × ℤ) := S.filter (fun z => c < inner2 w z) with hQdef
  have hmemQ : ∀ y : ℤ × ℤ, y ∈ Q ↔ (y ∈ S ∧ c < inner2 w y) := by
    intro y; rw [hQdef]; exact Finset.mem_filter
  -- cancelling the non-zero factor `μ`
  have hcancel : ∀ a b : ℤ, μ * (a : ℝ) ≤ μ * (b : ℝ) →
      (0 < μ → a ≤ b) ∧ (μ < 0 → b ≤ a) := by
    intro a b hab
    refine ⟨fun hp => by exact_mod_cast le_of_mul_le_mul_left hab hp, fun hn => ?_⟩
    by_contra hcon
    have hcR : (a : ℝ) < (b : ℝ) := by exact_mod_cast not_le.mp hcon
    nlinarith [mul_pos (neg_pos.mpr hn) (sub_pos.mpr hcR)]
  -- `B` is Cyr-Kra's `{x_ℓ}`: the points of `Q` minimal in their own row
  refine ⟨Q.filter (fun z => ∀ y ∈ Q, det v y = det v z → det z u ≤ det y u), ?_, ?_⟩
  · -- `B + j • v ⊆ Q` for `j < h`
    intro j hj b hb
    obtain ⟨hbQ, hbmin⟩ := Finset.mem_filter.mp hb
    obtain ⟨hbS, hbc⟩ := (hmemQ b).mp hbQ
    have hm2 : 2 ≤ (S.filter fun z => inner2 w z = c).card := by omega
    obtain ⟨z₀, hz₀⟩ : (S.filter fun z => inner2 w z = c).Nonempty :=
      Finset.card_pos.mp (by omega)
    obtain ⟨hz₀S, hz₀c⟩ := Finset.mem_filter.mp hz₀
    obtain ⟨z₁, hz₁⟩ : (S.filter fun z => inner2 w z = c').Nonempty :=
      Finset.card_pos.mp (by omega)
    obtain ⟨hz₁S, hz₁c⟩ := Finset.mem_filter.mp hz₁
    have hceq : c = μ * ((det v z₀ : ℤ) : ℝ) := by rw [← hz₀c, hμz z₀]
    have hc'eq : c' = μ * ((det v z₁ : ℤ) : ℝ) := by rw [← hz₁c, hμz z₁]
    -- the two extreme faces are exactly the two extreme rows
    have hfacec : (S.filter fun z => inner2 w z = c)
        = S.filter fun z => det v z = det v z₀ := by
      ext y
      simp only [Finset.mem_filter, and_congr_right_iff]
      intro _
      rw [hμz y, hceq]
      exact ⟨fun h => by exact_mod_cast mul_left_cancel₀ hμ h, fun h => by rw [h]⟩
    have hfacec' : (S.filter fun z => inner2 w z = c')
        = S.filter fun z => det v z = det v z₁ := by
      ext y
      simp only [Finset.mem_filter, and_congr_right_iff]
      intro _
      rw [hμz y, hc'eq]
      exact ⟨fun h => by exact_mod_cast mul_left_cancel₀ hμ h, fun h => by rw [h]⟩
    -- `b`'s row lies between the two extreme rows
    have hb1 : μ * ((det v z₀ : ℤ) : ℝ) ≤ μ * ((det v b : ℤ) : ℝ) := by
      rw [← hceq, ← hμz b]; exact hmin b hbS
    have hb2 : μ * ((det v b : ℤ) : ℝ) ≤ μ * ((det v z₁ : ℤ) : ℝ) := by
      rw [← hc'eq, ← hμz b]; exact hmax b hbS
    -- the height lemma
    have hheight : (S.filter fun z => inner2 w z = c).card
        ≤ (S.filter fun z => det v z = det v b).card + 1 := by
      have hr₀ : (S.filter fun z => inner2 w z = c).card
          ≤ (S.filter fun z => pi v z = det v z₀).card := by
        rw [filter_pi_eq_filter_det, ← hfacec]
      have hr₁ : (S.filter fun z => inner2 w z = c).card
          ≤ (S.filter fun z => pi v z = det v z₁).card := by
        rw [filter_pi_eq_filter_det, ← hfacec']; exact hle
      rw [← filter_pi_eq_filter_det]
      rcases lt_or_gt_of_ne hμ with hneg | hpos
      · exact card_row_ge_of_extreme hSc hvu hr₁ hr₀
          ((hcancel _ _ hb2).2 hneg) ((hcancel _ _ hb1).2 hneg)
      · exact card_row_ge_of_extreme hSc hvu hr₀ hr₁
          ((hcancel _ _ hb1).1 hpos) ((hcancel _ _ hb2).1 hpos)
    -- rows of `S` above the bottom face are rows of `Q`
    have hrowQ : ∀ y ∈ S, det v y = det v b → y ∈ Q := by
      intro y hyS hyt
      refine (hmemQ y).mpr ⟨hyS, ?_⟩
      rw [hμz y, hyt, ← hμz b]
      exact hbc
    have hbminS : ∀ y ∈ S, det v y = det v b → det b u ≤ det y u := fun y hyS hyt =>
      hbmin y (hrowQ y hyS hyt) hyt
    have hbR : b ∈ S.filter fun z => det v z = det v b := Finset.mem_filter.mpr ⟨hbS, rfl⟩
    have hInj : Set.InjOn (fun y : ℤ × ℤ => det y u)
        ((S.filter fun z => det v z = det v b : Finset (ℤ × ℤ)) : Set (ℤ × ℤ)) := by
      intro y₁ hy₁ y₂ hy₂ heq
      have e₁ : det v y₁ = det v b := (Finset.mem_filter.mp (Finset.mem_coe.mp hy₁)).2
      have e₂ : det v y₂ = det v b := (Finset.mem_filter.mp (Finset.mem_coe.mp hy₂)).2
      exact eq_of_phi_psi_eq hvu (e₁.trans e₂.symm) heq
    set I : Finset ℤ :=
      (S.filter fun z => det v z = det v b).image (fun y => det y u) with hIdef
    have hIne : I.Nonempty := ⟨det b u, Finset.mem_image_of_mem _ hbR⟩
    have hIcard : I.card = (S.filter fun z => det v z = det v b).card :=
      Finset.card_image_of_injOn hInj
    have hminI : I.min' hIne = det b u := by
      refine le_antisymm (Finset.min'_le _ _ (Finset.mem_image_of_mem _ hbR)) ?_
      refine Finset.le_min' _ _ _ ?_
      intro y hy
      obtain ⟨y', hy'R, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨hy'S, hy't⟩ := Finset.mem_filter.mp hy'R
      exact hbminS y' hy'S hy't
    obtain ⟨zmax, hzmaxR, hzmax0⟩ := Finset.mem_image.mp (I.max'_mem hIne)
    have hzmaxeq : det zmax u = I.max' hIne := hzmax0
    obtain ⟨hzmaxS, hzmaxt⟩ := Finset.mem_filter.mp hzmaxR
    have hspan := sub_max_min_ge (S := I)
      (n := (S.filter fun z => inner2 w z = c).card - 1) (by omega) hIne
    have hjle : det b u + (j : ℤ) ≤ det zmax u := by omega
    have hmemS : (det b u + (j : ℤ)) • v + det v b • u ∈ S :=
      mem_row_of_between hSc hvu hbS hzmaxS rfl hzmaxt (by omega) hjle
    have hpt : (det b u + (j : ℤ)) • v + det v b • u = (j : ℤ) • v + b := by
      have e2 : b = det b u • v + det v b • u := eq_smul_add_smul hvu b
      conv_rhs => rw [e2]
      rw [add_smul]
      abel
    rw [← hpt]
    exact hrowQ _ hmemS (phi_zsmul_add_zsmul hvu _ _)
  · -- every point of `Q` lies on the line through some `b ∈ B`
    intro z hz
    have hzR : z ∈ Q.filter fun y => det v y = det v z := Finset.mem_filter.mpr ⟨hz, rfl⟩
    set J : Finset ℤ := (Q.filter fun y => det v y = det v z).image (fun y => det y u)
      with hJdef
    have hJne : J.Nonempty := ⟨det z u, Finset.mem_image_of_mem _ hzR⟩
    obtain ⟨b, hbR, hb0⟩ := Finset.mem_image.mp (J.min'_mem hJne)
    have hbeq : det b u = J.min' hJne := hb0
    obtain ⟨hbQ, hbt⟩ := Finset.mem_filter.mp hbR
    refine ⟨b, Finset.mem_filter.mpr ⟨hbQ, ?_⟩, det z u - det b u, ?_⟩
    · intro y hyQ hyt
      rw [hbeq]
      exact Finset.min'_le _ _ (Finset.mem_image_of_mem _
        (Finset.mem_filter.mpr ⟨hyQ, hyt.trans hbt⟩))
    · have e2 : b = det b u • v + det v z • u := by
        have h := eq_smul_add_smul hvu b
        rwa [hbt] at h
      calc z = det z u • v + det v z • u := eq_smul_add_smul hvu z
        _ = (det z u - det b u) • v + (det b u • v + det v z • u) := by
            rw [← add_assoc, ← add_smul]
            have hsum : det z u - det b u + det b u = det z u := by ring
            rw [hsum]
        _ = (det z u - det b u) • v + b := by rw [← e2]

/-! ## Strip periodicity (Cyr-Kra Lemma 2.24, assembled) -/

/-- Cyr-Kra Lemma 2.24 in Colle's setting: an `(ℓ,𝒮)`-ambiguous `x` has a
non-zero period parallel to `ℓ` on the strip swept out by the lines through
`𝒮 \ ℓ_𝒮`.

Proved unconditionally.  The geometric input
`exists_rowBase_of_latticeConvex` is now also proved; `LatticeConvex S`
comes from `hgen.2.1`, so no extra hypothesis is needed. -/
theorem exists_strip_period_of_ambiguousAlong {ξ x : Config A}
    (hξ : (Set.range ξ).Finite) (hx : x ∈ orbitClosure ξ)
    {S : Finset (ℤ × ℤ)} (hgen : IsGeneratingSet ξ S)
    {v : ℤ × ℤ} (hv : Primitive v) {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0)
    {c c' : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z) (hmax : ∀ z ∈ S, inner2 w z ≤ c')
    (hfc : (S.filter fun z => inner2 w z = c).Nonempty)
    (hle : (S.filter fun z => inner2 w z = c).card ≤
      (S.filter fun z => inner2 w z = c').card)
    (hcount : P ξ S - P ξ (S.filter fun z => c < inner2 w z) ≤
      (S.filter fun z => inner2 w z = c).card - 1)
    (honed : ∃ y ∈ orbitClosure ξ, ∃ y' ∈ orbitClosure ξ, y ≠ y' ∧
        ∀ z : ℤ × ℤ, 0 ≤ inner2 w z → y z = y' z)
    (hamb : AmbiguousAlong ξ (S.filter fun z => c < inner2 w z) S x v) :
    ∃ u : ℤ × ℤ, u ≠ 0 ∧ inner2 w u = 0 ∧
      ∀ z₀ ∈ S.filter (fun z => c < inner2 w z), ∀ k : ℤ,
        x (k • v + z₀ + u) = x (k • v + z₀) := by
  classical
  obtain ⟨B, hrow, hcover⟩ :=
    exists_rowBase_of_latticeConvex hgen.2.1 hv hw hwv hmin hmax hle
  have h2 := two_le_card_face_of_oneSidedNonexpansive hgen hmin hfc honed
  have hh : 0 < (S.filter fun z => inner2 w z = c).card - 1 := by omega
  obtain ⟨q, hq, hper⟩ :=
    exists_row_period_of_ambiguousAlong hξ hx (Finset.filter_subset _ _) hamb hh
      (fun j hj b hb => hrow j hj b hb) hcount
  refine ⟨(q : ℤ) • v, ?_, ?_, ?_⟩
  · exact smul_ne_zero (by exact_mod_cast hq.ne') hv.ne_zero
  · rw [inner2_zsmul, hwv, mul_zero]
  · intro z₀ hz₀ k
    obtain ⟨b, hb, m, rfl⟩ := hcover z₀ hz₀
    have := hper (k + m) b hb
    calc x (k • v + (m • v + b) + (q : ℤ) • v)
        = x ((k + m + (q : ℤ)) • v + b) := by congr 1; rw [add_smul, add_smul]; abel
      _ = x ((k + m) • v + b) := this
      _ = x (k • v + (m • v + b)) := by congr 1; rw [add_smul]; abel

/-! ## The subshift of finite type `X_𝒮(η)` (Cyr-Kra §4.2)

Cyr-Kra run their §4.2 induction inside `X_𝒮(η)`, not inside the orbit closure:
the gluing construction of §4.2.2 produces a configuration that need not lie in
`orbitClosure ξ`, but does lie in `X_𝒮(η)`.  This section supplies that space and
the four facts §4.2 uses about it. -/

/-- `sftOf ξ S` is Cyr-Kra's `X_𝒮(η)`: every `S`-window of `y`, at every anchor,
carries a pattern that already occurs in `ξ`. -/
def sftOf (ξ : Config A) (S : Finset (ℤ × ℤ)) : Set (Config A) :=
  {y | ∀ u : ℤ × ℤ, pattern y S u ∈ patterns ξ S}

/-- Non-degeneracy, satisfiability half: `ξ` itself lies in its own SFT. -/
theorem self_mem_sftOf (ξ : Config A) (S : Finset (ℤ × ℤ)) : ξ ∈ sftOf ξ S :=
  fun u => ⟨u, rfl⟩

/-- Non-degeneracy, refutation half: `sftOf` is not all of `Config A`. -/
theorem not_mem_sftOf_example :
    (fun _ => true) ∉ sftOf (fun _ => false : Config Bool) {(0, 0)} := by
  intro h
  obtain ⟨u, hu⟩ := h 0
  have := congrFun hu ⟨(0, 0), Finset.mem_singleton_self _⟩
  exact Bool.noConfusion this

/-- The orbit closure sits inside the SFT.  (Cyr-Kra use this silently; the
converse is false, which is exactly why §4.2.2 needs the SFT.) -/
theorem orbitClosure_subset_sftOf (ξ : Config A) (S : Finset (ℤ × ℤ)) :
    orbitClosure ξ ⊆ sftOf ξ S :=
  fun _ hx u => patterns_subset_of_mem_orbitClosure hx S ⟨u, rfl⟩

/-- Translates of members of the SFT stay in the SFT. -/
theorem T_mem_sftOf {ξ : Config A} {S : Finset (ℤ × ℤ)} {y : Config A}
    (hy : y ∈ sftOf ξ S) (t : ℤ × ℤ) : T t y ∈ sftOf ξ S := by
  intro u
  have heq : pattern (T t y) S u = pattern y S (u + t) := by
    funext q
    show y ((u + (q : ℤ × ℤ)) + t) = y ((u + t) + (q : ℤ × ℤ))
    congr 1
    abel
  rw [heq]
  exact hy (u + t)

/-- **Generation propagates into the SFT.**  If `a` is `η`-generated by `S` in
Colle's pattern-count sense, then the value at `u + a` of *any* member of the SFT
is determined by its values on `u + (S \ {a})`.

This is the step that makes §4.2 possible outside the orbit closure: Colle's
Definition 2.2 is a statement about *pattern counts of `ξ`*, and a pattern count
controls every member of the SFT, not merely of the orbit closure. -/
theorem sft_eq_of_generatesAt {ξ : Config A} (hfin : (Set.range ξ).Finite)
    {S : Finset (ℤ × ℤ)} {a : ℤ × ℤ} (ha : a ∈ S)
    (hP : P ξ (S.erase a) = P ξ S)
    {y y' : Config A} (hy : y ∈ sftOf ξ S) (hy' : y' ∈ sftOf ξ S) (u : ℤ × ℤ)
    (hagree : ∀ z ∈ S.erase a, y (u + z) = y' (u + z)) :
    y (u + a) = y' (u + a) := by
  classical
  let py : patterns ξ S := ⟨pattern y S u, hy u⟩
  let py' : patterns ξ S := ⟨pattern y' S u, hy' u⟩
  have hres : restrict_occurring_pattern ξ (Finset.erase_subset a S) py =
      restrict_occurring_pattern ξ (Finset.erase_subset a S) py' := by
    apply Subtype.ext
    funext z
    exact hagree z.1 z.2
  have heq := restrict_occurring_pattern_injective_of_P_eq hfin
    (Finset.erase_subset a S) hP hres
  exact congrArg (fun p : patterns ξ S => p.1 ⟨a, ha⟩) heq

/-! ## Cyr-Kra Definition 4.5(ii): the endpoints of the `ℓ`-face are `η`-generated

Cyr-Kra's `ℓ`-balanced sets *assume* "the endpoints of `ℓ(𝒮)` are `η`-generated".
For an `η`-generating set in Colle's sense (every *vertex* is generated) this is
not an extra hypothesis but a theorem: an endpoint of the face `𝒮 ∩ ℓ_𝒮` is a
vertex, because it is the unique minimiser on `𝒮` of a slightly tilted real
linear functional `w + ε v`. -/

/-- The Euclidean pairing, used to order the points of a single face. -/
def dotZ (z v : ℤ × ℤ) : ℤ := z.1 * v.1 + z.2 * v.2

private theorem inner2_add_pair (w : ℝ × ℝ) (x y : ℤ × ℤ) :
    inner2 w (x + y) = inner2 w x + inner2 w y := by
  simp only [inner2, Prod.fst_add, Prod.snd_add, Int.cast_add]; ring

private theorem inner2_sub_pair (w : ℝ × ℝ) (x y : ℤ × ℤ) :
    inner2 w (x - y) = inner2 w x - inner2 w y := by
  simp only [inner2, Prod.fst_sub, Prod.snd_sub, Int.cast_sub]; ring

private theorem dotZ_add_pair (x y v : ℤ × ℤ) : dotZ (x + y) v = dotZ x v + dotZ y v := by
  simp only [dotZ, Prod.fst_add, Prod.snd_add]; ring

private theorem dotZ_sub_pair (x y v : ℤ × ℤ) : dotZ (x - y) v = dotZ x v - dotZ y v := by
  simp only [dotZ, Prod.fst_sub, Prod.snd_sub]; ring

/-- On a single level `{z | inner2 w z = c}` the integral pairing `dotZ · v`
separates points: the level is a coset of `ℤ v`, and `dotZ v v > 0`.  This is what
makes "the endpoints of the face" well defined. -/
theorem eq_of_dotZ_eq_on_level {v : ℤ × ℤ} (hv : Primitive v)
    {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0) {c : ℝ}
    {z a : ℤ × ℤ} (hzc : inner2 w z = c) (hac : inner2 w a = c)
    (h : dotZ z v = dotZ a v) : z = a := by
  have hvsq : 0 < dotZ v v := by
    have hv0 : v ≠ 0 := hv.ne_zero
    have hor : v.1 ≠ 0 ∨ v.2 ≠ 0 := by
      rcases eq_or_ne v.1 0 with h1 | h1
      · rcases eq_or_ne v.2 0 with h2 | h2
        · exact absurd (Prod.ext h1 h2) hv0
        · exact Or.inr h2
      · exact Or.inl h1
    simp only [dotZ]
    rcases hor with h1 | h1
    · nlinarith [sq_nonneg v.1, sq_nonneg v.2, mul_self_pos.mpr h1]
    · nlinarith [sq_nonneg v.1, sq_nonneg v.2, mul_self_pos.mpr h1]
  have hzero : inner2 w (z - a) = 0 := by
    rw [inner2_sub_pair w z a, hzc, hac, sub_self]
  obtain ⟨k, hk⟩ := Nivat.eq_zsmul_of_det_eq_zero hv
    (det_eq_zero_of_inner2_eq_zero hw hwv hzero)
  have hdz : dotZ z v - dotZ a v = k * dotZ v v := by
    have h1 : z.1 - a.1 = k * v.1 := by
      have := congrArg Prod.fst hk; simpa [Prod.smul_def] using this
    have h2 : z.2 - a.2 = k * v.2 := by
      have := congrArg Prod.snd hk; simpa [Prod.smul_def] using this
    simp only [dotZ]
    linear_combination v.1 * h1 + v.2 * h2
  have hk0 : k = 0 := by
    have hz0 : k * dotZ v v = 0 := by rw [← hdz, h]; ring
    rcases mul_eq_zero.mp hz0 with h' | h'
    · exact h'
    · omega
  have : z - a = 0 := by rw [hk, hk0, zero_smul]
  exact sub_eq_zero.mp this

/-- **Cyr-Kra Definition 4.5(ii), proved (one endpoint).**  The `dotZ`-minimal
point of the face `{z ∈ S | inner2 w z = c}` at the extreme level `c` of an
`η`-generating set `S` is `η`-generated by `S`. -/
theorem generatesAt_of_min_on_face {ξ : Config A} {S : Finset (ℤ × ℤ)}
    (hgen : IsGeneratingSet ξ S) {v : ℤ × ℤ} (hv : Primitive v)
    {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0) {c : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z)
    {a : ℤ × ℤ} (ha : a ∈ S) (hac : inner2 w a = c)
    (hext : ∀ z ∈ S, inner2 w z = c → dotZ a v ≤ dotZ z v) :
    GeneratesAt ξ S a := by
  classical
  -- (1) on the face, `dotZ · v` separates points, so `a` is a *strict* minimum
  have hstrict : ∀ z ∈ S, inner2 w z = c → z ≠ a → dotZ a v < dotZ z v := by
    intro z hz hzc hza
    refine lt_of_le_of_ne (hext z hz hzc) ?_
    intro heq
    exact hza (eq_of_dotZ_eq_on_level hv hw hwv hzc hac heq.symm)
  -- (2) a uniform bound on the `dotZ`-spread of `S`
  obtain ⟨M, hM⟩ : ∃ M : ℤ, ∀ z ∈ S, |dotZ z v - dotZ a v| ≤ M := by
    have hne : (S.image fun z => |dotZ z v - dotZ a v|).Nonempty :=
      ⟨_, Finset.mem_image_of_mem _ ha⟩
    refine ⟨(S.image fun z => |dotZ z v - dotZ a v|).max' hne, fun z hz => ?_⟩
    exact Finset.le_max' _ _ (Finset.mem_image_of_mem (fun z => |dotZ z v - dotZ a v|) hz)
  have hM0 : (0 : ℤ) ≤ M := by simpa using hM a ha
  -- (3) a uniform positive gap between the face level and the rest of `S`
  obtain ⟨δ, hδpos, hδ⟩ : ∃ δ : ℝ, 0 < δ ∧
      ∀ z ∈ S, inner2 w z ≠ c → c + δ ≤ inner2 w z := by
    by_cases hT : (S.filter fun z => inner2 w z ≠ c).Nonempty
    · have hTi : ((S.filter fun z => inner2 w z ≠ c).image fun z => inner2 w z).Nonempty :=
        hT.image _
      set m := ((S.filter fun z => inner2 w z ≠ c).image fun z => inner2 w z).min' hTi with hm
      have hmem := Finset.min'_mem _ hTi
      rw [← hm] at hmem
      obtain ⟨z₀, hz₀, hz₀eq⟩ := Finset.mem_image.mp hmem
      obtain ⟨hz₀S, hz₀ne⟩ := Finset.mem_filter.mp hz₀
      have hmc : c < m := lt_of_le_of_ne (hz₀eq ▸ hmin z₀ hz₀S)
        (by rw [← hz₀eq]; exact fun h => hz₀ne h.symm)
      refine ⟨m - c, by linarith, fun z hz hzne => ?_⟩
      have : m ≤ inner2 w z :=
        Finset.min'_le _ _ (Finset.mem_image_of_mem _ (Finset.mem_filter.mpr ⟨hz, hzne⟩))
      linarith
    · refine ⟨1, one_pos, fun z hz hzne => ?_⟩
      exact absurd (Finset.mem_filter.mpr ⟨hz, hzne⟩) (fun hmem => hT ⟨z, hmem⟩)
  -- (4) the tilted normal `w' = w + ε v`
  set ε : ℝ := δ / ((M : ℝ) + 1) with hε
  have hMpos : (0 : ℝ) < (M : ℝ) + 1 := by
    have : (0 : ℝ) ≤ (M : ℝ) := by exact_mod_cast hM0
    linarith
  have hεpos : 0 < ε := div_pos hδpos hMpos
  set w' : ℝ × ℝ := (w.1 + ε * (v.1 : ℝ), w.2 + ε * (v.2 : ℝ)) with hw'
  have hw'val : ∀ z : ℤ × ℤ, inner2 w' z = inner2 w z + ε * ((dotZ z v : ℤ) : ℝ) := by
    intro z
    simp only [inner2, dotZ, hw', Int.cast_add, Int.cast_mul]
    ring
  -- (5) `a` is the unique minimiser of `inner2 w'` on `S`
  have hunique : ∀ z ∈ S, z ≠ a → inner2 w' a < inner2 w' z := by
    intro z hz hza
    rw [hw'val, hw'val, hac]
    by_cases hzc : inner2 w z = c
    · rw [hzc]
      have := hstrict z hz hzc hza
      have hcast : ((dotZ a v : ℤ) : ℝ) < ((dotZ z v : ℤ) : ℝ) := by exact_mod_cast this
      nlinarith
    · have h1 : c + δ ≤ inner2 w z := hδ z hz hzc
      have h2 : |dotZ z v - dotZ a v| ≤ M := hM z hz
      have h3 : -(M : ℤ) ≤ dotZ z v - dotZ a v := neg_le_of_abs_le h2
      have h3' : -((M : ℝ)) ≤ ((dotZ z v : ℤ) : ℝ) - ((dotZ a v : ℤ) : ℝ) := by
        exact_mod_cast h3
      have hεM : ε * (M : ℝ) < δ := by
        rw [hε, div_mul_eq_mul_div, div_lt_iff₀ hMpos]
        nlinarith
      nlinarith
  -- (6) hence `S.erase a` is cut out by a strict real half plane, so `a` is a vertex
  have hneg : ∀ z : ℤ × ℤ, inner2 (-w') z = -(inner2 w' z) := by
    intro z
    simp only [inner2, Prod.fst_neg, Prod.snd_neg]
    ring
  have herase : S.erase a = S.filter fun z => inner2 (-w') z < -(inner2 w' a) := by
    ext z
    simp only [Finset.mem_erase, Finset.mem_filter, hneg, neg_lt_neg_iff]
    constructor
    · rintro ⟨hza, hzS⟩
      exact ⟨hzS, hunique z hzS hza⟩
    · rintro ⟨hzS, hlt⟩
      exact ⟨fun h => absurd (h ▸ hlt) (lt_irrefl _), hzS⟩
  have hdel : LatticeConvex (S.erase a) := by
    rw [herase]
    exact latticeConvex_filter_inner2_lt hgen.2.1 (-w') (-(inner2 w' a))
  exact hgen.2.2 a ha hdel

/-- **Cyr-Kra Definition 4.5(ii), proved (other endpoint).**  Together with
`generatesAt_of_min_on_face` this is exactly "the endpoints of `ℓ(𝒮)` are
`η`-generated", for `η`-generating `S` in Colle's sense. -/
theorem generatesAt_of_max_on_face {ξ : Config A} {S : Finset (ℤ × ℤ)}
    (hgen : IsGeneratingSet ξ S) {v : ℤ × ℤ} (hv : Primitive v)
    {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0) {c : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z)
    {a : ℤ × ℤ} (ha : a ∈ S) (hac : inner2 w a = c)
    (hext : ∀ z ∈ S, inner2 w z = c → dotZ z v ≤ dotZ a v) :
    GeneratesAt ξ S a := by
  have hvneg : Primitive (-v) := by
    obtain ⟨p, q, hpq⟩ := hv
    exact ⟨-p, -q, by simp only [Prod.fst_neg, Prod.snd_neg]; linear_combination hpq⟩
  have hwvneg : inner2 w (-v) = 0 := by
    have : inner2 w (-v) = -(inner2 w v) := by
      simp only [inner2, Prod.fst_neg, Prod.snd_neg, Int.cast_neg]; ring
    rw [this, hwv, neg_zero]
  refine generatesAt_of_min_on_face hgen hvneg hw hwvneg hmin ha hac ?_
  intro z hz hzc
  have hflip : ∀ y : ℤ × ℤ, dotZ y (-v) = -(dotZ y v) := by
    intro y
    simp only [dotZ, Prod.fst_neg, Prod.snd_neg]
    ring
  rw [hflip, hflip]
  exact neg_le_neg (hext z hz hzc)

/-- **The determinism sweep along a multi-point face** (Cyr-Kra §4.2.1, final
step: "Since the endpoints of `w` are `η`-generated by `𝒮`, an easy induction
argument shows that `f|𝒮(K,i+k)` and `f|𝒮(K,j+k)` coincide for all `k`").

Let `a` be the `dotZ`-minimal point of the extreme face
`{z ∈ S | inner2 w z = c}` of an `η`-generating set `S`.  Let `y, y'` be members
of the SFT that agree everywhere strictly above level `d`, and agree on the part
of level `d` with `dotZ · v > n₀`.  Then they agree on the whole closed region
`inner2 w z ≥ d`: anchoring `S` so that `a` lands on the next unknown point puts
the rest of the window either strictly above level `d` or further along the face,
in both cases already known, and the induction runs down the level.

This is the multi-point-face replacement for `eq_of_halfPlane_of_generatesAt`
(`GeneratedHalfPlane.lean`), which requires the generating site to be a *strict*
minimiser of `inner2 w` on `S`, i.e. a one-point face — precisely the case that
`two_le_card_face_of_oneSidedNonexpansive` rules out in this setting. -/
theorem eq_on_closed_level_of_face_sweep {ξ : Config A}
    (hfin : (Set.range ξ).Finite) {S : Finset (ℤ × ℤ)}
    (hgen : IsGeneratingSet ξ S) {v : ℤ × ℤ} (hv : Primitive v)
    {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0) {c : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z)
    {a : ℤ × ℤ} (ha : a ∈ S) (hac : inner2 w a = c)
    (hext : ∀ z ∈ S, inner2 w z = c → dotZ a v ≤ dotZ z v)
    {y y' : Config A} (hy : y ∈ sftOf ξ S) (hy' : y' ∈ sftOf ξ S)
    {d : ℝ} {n₀ : ℤ}
    (hknown : ∀ z : ℤ × ℤ, d < inner2 w z → y z = y' z)
    (hseed : ∀ z : ℤ × ℤ, inner2 w z = d → n₀ < dotZ z v → y z = y' z) :
    ∀ z : ℤ × ℤ, d ≤ inner2 w z → y z = y' z := by
  classical
  have hP : P ξ (S.erase a) = P ξ S :=
    P_eq_of_generatesAt hfin (generatesAt_of_min_on_face hgen hv hw hwv hmin ha hac hext)
  -- one application of generation, anchored so that the generated site lands on `p`
  have hstep : ∀ p : ℤ × ℤ, inner2 w p = d →
      (∀ s ∈ S.erase a, y ((p - a) + s) = y' ((p - a) + s)) → y p = y' p := by
    intro p _ hagr
    have h := sft_eq_of_generatesAt hfin ha hP hy hy' (p - a) hagr
    have hpa : (p - a) + a = p := by abel
    rwa [hpa] at h
  -- the sweep: downward induction on `dotZ · v` along level `d`
  have key : ∀ k : ℕ, ∀ z : ℤ × ℤ, inner2 w z = d → n₀ - (k : ℤ) < dotZ z v →
      y z = y' z := by
    intro k
    induction k with
    | zero => intro z hz hn; exact hseed z hz (by omega)
    | succ k ih =>
      intro z hz hn
      by_cases hgt : n₀ - (k : ℤ) < dotZ z v
      · exact ih z hz hgt
      · -- `dotZ z v = n₀ - k`; everything the window needs is already known
        have hzn : dotZ z v = n₀ - (k : ℤ) := by push_cast at hn ⊢; omega
        refine hstep z hz ?_
        intro s hs
        obtain ⟨hsa, hsS⟩ := Finset.mem_erase.mp hs
        have hlev : inner2 w ((z - a) + s) = d - c + inner2 w s := by
          rw [inner2_add_pair w (z - a) s, inner2_sub_pair w z a, hz, hac]
        rcases eq_or_lt_of_le (hmin s hsS) with hsc | hsc
        · -- `s` is on the face: same level `d`, strictly larger `dotZ`
          have hlev' : inner2 w ((z - a) + s) = d := by rw [hlev, ← hsc]; ring
          have hstrict : dotZ a v < dotZ s v := by
            refine lt_of_le_of_ne (hext s hsS hsc.symm) ?_
            intro heq
            exact hsa (eq_of_dotZ_eq_on_level hv hw hwv hsc.symm hac heq.symm)
          have hdz : dotZ ((z - a) + s) v = dotZ z v + (dotZ s v - dotZ a v) := by
            rw [dotZ_add_pair (z - a) s v, dotZ_sub_pair z a v]; ring
          refine ih ((z - a) + s) hlev' ?_
          rw [hdz, hzn]
          omega
        · -- `s` is strictly above the face: the point is strictly above level `d`
          exact hknown _ (by rw [hlev]; linarith)
  intro z hd
  rcases eq_or_lt_of_le hd with hdz | hdz
  · exact key (n₀ - dotZ z v + 1).toNat z hdz.symm (by omega)
  · exact hknown z hdz

/-! ## Cyr-Kra §4.2.2: the gluing step

Verbatim from the source (arXiv:1208.4090, §4.2.2), with `f ↾ B_K` written
`f|B_K`:

> `g(x,y) = f(x,y)` if `x ≥ K`; `f(x,y+p)` if `x < K`.
> Since `f ∈ X_𝒮(η)`, `f|B_K` is periodic, and `diam_w(B_K) = diam_w(𝒮̃)`, we
> are guaranteed that `g ∈ X_𝒮(η)`.

The load-bearing numerology is that the periodic strip is exactly one level
*narrower* than `S`, so an `S`-translate straddling the seam has its entire
upper part inside the strip. -/

private theorem det_add_right_aux (u z z' : ℤ × ℤ) :
    det u (z + z') = det u z + det u z' := by
  simp only [det, Prod.fst_add, Prod.snd_add]
  ring

/-- **Cyr-Kra §4.2.2, gluing step.**  Let `S` occupy the `det v`-levels
`[m₀, m₁]`, let `f` be in the SFT, and let `f` be `u`-periodic on the strip of
levels `[K, K + (m₁ - m₀))` — a strip of exactly `m₁ - m₀` levels, i.e. one
fewer than `S` occupies.  Then the configuration obtained by gluing `f` above
level `K` to its translate below level `K` is again in the SFT. -/
theorem sftOf_glue {ξ f : Config A} {S : Finset (ℤ × ℤ)} (hf : f ∈ sftOf ξ S)
    {v : ℤ × ℤ} {m₀ m₁ : ℤ}
    (hSmin : ∀ z ∈ S, m₀ ≤ det v z) (hSmax : ∀ z ∈ S, det v z ≤ m₁)
    {u : ℤ × ℤ} {K : ℤ}
    (hper : ∀ z : ℤ × ℤ, K ≤ det v z → det v z < K + (m₁ - m₀) → f (z + u) = f z) :
    (fun z => if K ≤ det v z then f z else f (z + u)) ∈ sftOf ξ S := by
  classical
  intro t
  by_cases hcase : K ≤ det v t + m₀
  · -- the whole translate `S + t` sits above the seam: `g` agrees with `f` there
    have : (pattern (fun z => if K ≤ det v z then f z else f (z + u)) S t)
        = pattern f S t := by
      funext q
      show (if K ≤ det v (t + (q : ℤ × ℤ)) then f (t + (q : ℤ × ℤ))
        else f (t + (q : ℤ × ℤ) + u)) = f (t + (q : ℤ × ℤ))
      rw [if_pos]
      rw [det_add_right_aux]
      have := hSmin (q : ℤ × ℤ) q.2
      omega
    rw [this]
    exact hf t
  · -- the translate straddles the seam: `g` agrees with the translate on *all* of it
    have : (pattern (fun z => if K ≤ det v z then f z else f (z + u)) S t) =
        pattern f S (t + u) := by
      funext q
      show (if K ≤ det v (t + (q : ℤ × ℤ)) then f (t + (q : ℤ × ℤ))
        else f (t + (q : ℤ × ℤ) + u)) = f (t + u + (q : ℤ × ℤ))
      have hrw : t + (q : ℤ × ℤ) + u = t + u + (q : ℤ × ℤ) := by abel
      by_cases hq : K ≤ det v (t + (q : ℤ × ℤ))
      · rw [if_pos hq, ← hrw]
        -- the upper part of a straddling translate lies inside the periodic strip
        refine (hper (t + (q : ℤ × ℤ)) hq ?_).symm
        rw [det_add_right_aux] at hq ⊢
        have := hSmax (q : ℤ × ℤ) q.2
        omega
      · rw [if_neg hq, hrw]
    rw [this]
    exact hf (t + u)

/-- Cyr-Kra §4.2.2 hypothesis (ii), "the coloring of `B_K` given by `f|B_K`
extends uniquely to an `η`-coloring of `B_K ∪ {(K-1,y) : y ∈ ℤ}`", rendered in
the SFT: any member of `X_𝒮(η)` agreeing with `f` on the closed upper region
`det v ≥ K` must also agree with it on the next level down. -/
def ExtendsUniquelyBelow (ξ : Config A) (S : Finset (ℤ × ℤ)) (v : ℤ × ℤ) (K : ℤ)
    (f : Config A) : Prop :=
  ∀ g ∈ sftOf ξ S, (∀ z : ℤ × ℤ, K ≤ det v z → g z = f z) →
    ∀ z : ℤ × ℤ, det v z = K - 1 → g z = f z

/-- Non-degeneracy, satisfiability half (weak form): over a one-point alphabet
every extension is unique.  This alone would be a poor witness — the property
holds by `rfl` and says nothing — so the genuine witness
`extendsUniquelyBelow_altColumns` below is given as well. -/
theorem extendsUniquelyBelow_example (ξ : Config Unit) (S : Finset (ℤ × ℤ))
    (v : ℤ × ℤ) (K : ℤ) (f : Config Unit) : ExtendsUniquelyBelow ξ S v K f :=
  fun _ _ _ _ _ => rfl

/-! #### A non-degenerate satisfiability witness

With `v = (0,1)` one has `det v z = -z.1`, so the `det v`-levels are the columns
of `ℤ²` (level `K` is the column `z.1 = -K`).  Take the two-site horizontal
window `{(0,0),(1,0)}` and the alternating-columns configuration
`ξ (x,y) = [x even]`.  The pattern set of the window is `{(tt,ff),(ff,tt)}`, so
every member of the SFT satisfies `g (x+1,y) = !g (x,y)`; the column left of a
known half plane really is forced, over a two-letter alphabet, by a `ξ` that is
not constant.  This is what makes the hypothesis of `downward_step_of_unique`
non-vacuous in a situation where it has content. -/

/-- The alternating-columns configuration. -/
def altColumns : Config Bool := fun z => decide (z.1 % 2 = 0)

/-- The two-site horizontal window. -/
def pairWindow : Finset (ℤ × ℤ) := {(0, 0), (1, 0)}

theorem mem_pairWindow_zero : ((0, 0) : ℤ × ℤ) ∈ pairWindow := by decide

theorem mem_pairWindow_one : ((1, 0) : ℤ × ℤ) ∈ pairWindow := by decide

/-- `det (0,1) z = -z.1`: the levels for `v = (0,1)` are the columns. -/
theorem det_eq_neg_fst (z : ℤ × ℤ) : det (0, 1) z = -z.1 := by simp [det]

/-- `altColumns` is not constant, so the witness below is not the `Unit`
degeneracy in disguise. -/
theorem altColumns_not_constant : altColumns (0, 0) ≠ altColumns (1, 0) := by decide

/-- **Non-degeneracy, satisfiability half (genuine form).**  Over a two-letter
alphabet with a non-constant `ξ`, the half plane `z.1 ≤ 0` really does determine
the column `z.1 = 1`. -/
theorem extendsUniquelyBelow_altColumns :
    ExtendsUniquelyBelow altColumns pairWindow (0, 1) 0 altColumns := by
  classical
  intro g hg hagree z hz
  -- level `K - 1 = -1` is the column `z.1 = 1`
  have hz1 : z.1 = 1 := by rw [det_eq_neg_fst] at hz; omega
  -- the anchor site of the window sits on the known side
  have hg0 : g (0, z.2) = true := by
    have h := hagree (0, z.2) (by rw [det_eq_neg_fst]; simp)
    rw [h]; rfl
  obtain ⟨u, hu⟩ := hg (0, z.2)
  have e0 : altColumns (u + ((0, 0) : ℤ × ℤ)) = g (((0, z.2) : ℤ × ℤ) + (0, 0)) :=
    congrFun hu ⟨(0, 0), mem_pairWindow_zero⟩
  have e1 : altColumns (u + ((1, 0) : ℤ × ℤ)) = g (((0, z.2) : ℤ × ℤ) + (1, 0)) :=
    congrFun hu ⟨(1, 0), mem_pairWindow_one⟩
  have hsum0 : u + ((0, 0) : ℤ × ℤ) = u := by simp
  have hsum0' : ((0, z.2) : ℤ × ℤ) + (0, 0) = (0, z.2) := by simp
  have hsum1' : ((0, z.2) : ℤ × ℤ) + (1, 0) = (1, z.2) := by simp
  rw [hsum0, hsum0', hg0] at e0
  rw [hsum1'] at e1
  -- `altColumns u = true` forces `u.1` even, hence `altColumns (u + (1,0)) = false`
  have hue : u.1 % 2 = 0 := of_decide_eq_true e0
  have halt1 : altColumns (u + ((1, 0) : ℤ × ℤ)) = false := by
    show decide ((u + ((1, 0) : ℤ × ℤ)).1 % 2 = 0) = false
    simp only [Prod.fst_add, decide_eq_false_iff_not]
    omega
  have hz' : z = (1, z.2) := Prod.ext hz1 rfl
  rw [hz', ← e1, halt1]
  show false = altColumns (1, z.2)
  rfl

/-- Non-degeneracy, refutation half: with `S` a single site and `ξ`
non-constant, the SFT is everything, so nothing below level `K` is determined. -/
theorem not_extendsUniquelyBelow_example :
    ¬ ExtendsUniquelyBelow (fun z => decide (z = (0, 0)))
        ({(0, 0)} : Finset (ℤ × ℤ)) (0, 1) 0 (fun _ => false) := by
  intro h
  -- `det (0,1) z = -z.1`, so level `K - 1 = -1` is the column `z.1 = 1`
  have hdet : ∀ z : ℤ × ℤ, det (0, 1) z = -z.1 := by
    intro z; simp [det]
  set g : Config Bool := fun z => decide (z.1 = 1) with hg
  have hgmem : g ∈ sftOf (fun z => decide (z = (0, 0))) ({(0, 0)} : Finset (ℤ × ℤ)) := by
    intro u
    by_cases hu : u.1 = 1
    · refine ⟨(0, 0), ?_⟩
      funext q
      have hq : (q : ℤ × ℤ) = (0, 0) := Finset.mem_singleton.mp q.2
      show decide (((0, 0) : ℤ × ℤ) + (q : ℤ × ℤ) = (0, 0)) = decide ((u + (q : ℤ × ℤ)).1 = 1)
      rw [hq]
      simp [hu]
    · refine ⟨(1, 0), ?_⟩
      funext q
      have hq : (q : ℤ × ℤ) = (0, 0) := Finset.mem_singleton.mp q.2
      show decide (((1, 0) : ℤ × ℤ) + (q : ℤ × ℤ) = (0, 0)) = decide ((u + (q : ℤ × ℤ)).1 = 1)
      rw [hq]
      simp [hu]
  have hup : ∀ z : ℤ × ℤ, (0 : ℤ) ≤ det (0, 1) z → g z = false := by
    intro z hz
    rw [hdet] at hz
    show decide (z.1 = 1) = false
    simp only [decide_eq_false_iff_not]
    omega
  have := h g hgmem hup (1, 0) (by simp [hdet])
  simp [hg] at this

/-- **Cyr-Kra §4.2.2, complete.**  If `f` lies in the SFT, is `u`-periodic on the
strip of levels `[K, K + (m₁ - m₀))`, and extends uniquely below level `K`, then
`f` is `u`-periodic on level `K - 1` as well.

This is the entire content of §4.2.2, and it is the step that genuinely needs the
SFT rather than the orbit closure: the glued configuration produced by
`sftOf_glue` need not lie in `orbitClosure ξ`. -/
theorem downward_step_of_unique {ξ f : Config A} {S : Finset (ℤ × ℤ)}
    (hf : f ∈ sftOf ξ S) {v : ℤ × ℤ} {m₀ m₁ : ℤ}
    (hSmin : ∀ z ∈ S, m₀ ≤ det v z) (hSmax : ∀ z ∈ S, det v z ≤ m₁)
    {u : ℤ × ℤ} {K : ℤ}
    (hper : ∀ z : ℤ × ℤ, K ≤ det v z → det v z < K + (m₁ - m₀) → f (z + u) = f z)
    (huniq : ExtendsUniquelyBelow ξ S v K f) :
    ∀ z : ℤ × ℤ, det v z = K - 1 → f (z + u) = f z := by
  classical
  have hgmem : (fun z => if K ≤ det v z then f z else f (z + u)) ∈ sftOf ξ S :=
    sftOf_glue hf hSmin hSmax hper
  have hagree : ∀ z : ℤ × ℤ, K ≤ det v z →
      (if K ≤ det v z then f z else f (z + u)) = f z := fun z hz => if_pos hz
  intro z hz
  have h2 : (if K ≤ det v z then f z else f (z + u)) = f z :=
    huniq _ hgmem hagree z hz
  rwa [if_neg (by omega : ¬ K ≤ det v z)] at h2

/-! ### The full hypothesis bundle of §4.2.2 is satisfiable

The individual non-degeneracy witnesses above do not yet rule out the worst
failure mode: five hypotheses that are each satisfiable but never *together*.
The three lemmas below complete the `altColumns` instance, and
`downward_step_instance` obtains the conclusion by applying
`downward_step_of_unique` itself, so the bundle is checked as a bundle.

Honest caveat, from an independent audit of this block.  In this particular
instance the conclusion also holds for an independent reason: `altColumns z`
does not depend on `z.2`, so `(0,1)` is a *global* period, and `altColumns_per`
proves `hper` while discarding both strip bounds (`intro z _ _`).  Two
consequences, neither of which the instance repairs:

* the instance does not witness `ExtendsUniquelyBelow` in a load-bearing role —
  the conclusion would hold here even without `huniq`;
* the instance does not exercise the strip-width numerology
  `diam_w(B_K) = diam_w(𝒮̃)`, which is the genuinely load-bearing part of
  `sftOf_glue`: `hper` would be satisfied here for *any* strip width.

What shows that `ExtendsUniquelyBelow` is not automatic is the refutation
witness `not_extendsUniquelyBelow_example`, not this instance.  A sharper
instance, with a `u` that is a period only on the strip, would tighten the
documentation; HARD RULE 4 (satisfiability of the premise bundle) is already
discharged without it. -/

/-- `pairWindow` occupies exactly the `det (0,1)`-levels `[-1, 0]` (lower bound). -/
theorem pairWindow_det_lb : ∀ z ∈ pairWindow, (-1 : ℤ) ≤ det (0, 1) z := by
  intro z hz
  rcases Finset.mem_insert.mp hz with h | h
  · subst h; simp [det]
  · rw [Finset.mem_singleton] at h; subst h; simp [det]

/-- `pairWindow` occupies exactly the `det (0,1)`-levels `[-1, 0]` (upper bound). -/
theorem pairWindow_det_ub : ∀ z ∈ pairWindow, det (0, 1) z ≤ 0 := by
  intro z hz
  rcases Finset.mem_insert.mp hz with h | h
  · subst h; simp [det]
  · rw [Finset.mem_singleton] at h; subst h; simp [det]

/-- `altColumns` is `(0,1)`-periodic on the one-level strip `[0, 0 + (0 - -1))`,
which is the strip width `sftOf_glue` requires. -/
theorem altColumns_per :
    ∀ z : ℤ × ℤ, (0 : ℤ) ≤ det (0, 1) z → det (0, 1) z < 0 + (0 - -1) →
      altColumns (z + (0, 1)) = altColumns z := by
  intro z _ _
  show decide ((z + ((0, 1) : ℤ × ℤ)).1 % 2 = 0) = decide (z.1 % 2 = 0)
  simp

/-- **All five hypotheses of `downward_step_of_unique` hold simultaneously**, over
a two-letter alphabet with a non-constant `ξ` (`altColumns_not_constant`).  The
conclusion is produced by applying the theorem, so this is a machine-checked
instance of the whole bundle rather than five unrelated instances. -/
theorem downward_step_instance :
    ∀ z : ℤ × ℤ, det (0, 1) z = 0 - 1 → altColumns (z + (0, 1)) = altColumns z :=
  downward_step_of_unique (self_mem_sftOf altColumns pairWindow)
    pairWindow_det_lb pairWindow_det_ub altColumns_per extendsUniquelyBelow_altColumns

/-! ## Levels form of the strip statement

`exists_strip_period_of_ambiguousAlong` delivers periodicity along the lines
through `𝒮 \ ℓ_𝒮`.  The induction of §4.2 needs it as a statement about *levels*:
`x` is `u`-periodic at every lattice point of level in `(c, c']`.  Converting
requires knowing that `det v ·` takes every intermediate value on `S`.

**This is not automatic**, and the naive statement is false: lattice convexity
does *not* make `det v '' S` an interval of `ℤ`.  For `S = {(0,0), (1,2)}`
(lattice-convex, since the open segment between its points has no lattice point)
and `v = (1,0)`, the levels are `{0, 2}` and level `1` is skipped.  What repairs
it is `Nivat.card_row_ge_of_extreme` with `n = 2`: if *both* extreme rows carry
at least two points, every intermediate row carries at least one.  Hence the
hypothesis `hfc2` below, which at the call site is exactly
`two_le_card_face_of_oneSidedNonexpansive hgen hmin hfc honed`. -/

/-- Cancelling the non-zero scaling factor `μ` against an inequality, keeping
track of its sign. -/
private theorem cancel_mu {μ : ℝ} (a b : ℤ) (hab : μ * (a : ℝ) ≤ μ * (b : ℝ)) :
    (0 < μ → a ≤ b) ∧ (μ < 0 → b ≤ a) := by
  refine ⟨fun hp => by exact_mod_cast le_of_mul_le_mul_left hab hp, fun hn => ?_⟩
  by_contra hcon
  have hcR : (a : ℝ) < (b : ℝ) := by exact_mod_cast not_le.mp hcon
  nlinarith [mul_pos (neg_pos.mpr hn) (sub_pos.mpr hcR)]

/-- **Level surjectivity.**  If the two extreme levels `c`, `c'` of a
lattice-convex `S` each carry at least two points of `S` (`hfc2` with `hle`),
then every lattice point whose level lies in `[c, c']` has the level of some
point of `S`.  `hmin`, `hmax` are not used by the proof — once `c` and `c'` are
known to be *attained*, that they also bound `inner2 w` on `S` is superfluous —
and are kept only for signature compatibility with the call site. -/
theorem exists_mem_level {S : Finset (ℤ × ℤ)} (hconv : LatticeConvex S)
    {v : ℤ × ℤ} (hv : Primitive v) {w : ℝ × ℝ} (hw : w ≠ 0)
    (hwv : inner2 w v = 0) {c c' : ℝ}
    (hfc2 : 2 ≤ (S.filter fun z => inner2 w z = c).card)
    (hle : (S.filter fun z => inner2 w z = c).card
            ≤ (S.filter fun z => inner2 w z = c').card)
    {z : ℤ × ℤ} (hz1 : c ≤ inner2 w z) (hz2 : inner2 w z ≤ c') :
    ∃ z₀ ∈ S, inner2 w z₀ = inner2 w z := by
  classical
  obtain ⟨u, hvu⟩ := hv.exists_dual
  obtain ⟨μ, hμ, hμz⟩ := exists_ratio_of_inner2_eq_zero hv.ne_zero hw hwv
  obtain ⟨z₀, hz₀⟩ : (S.filter fun y => inner2 w y = c).Nonempty :=
    Finset.card_pos.mp (by omega)
  obtain ⟨hz₀S, hz₀c⟩ := Finset.mem_filter.mp hz₀
  obtain ⟨z₁, hz₁⟩ : (S.filter fun y => inner2 w y = c').Nonempty :=
    Finset.card_pos.mp (by omega)
  obtain ⟨hz₁S, hz₁c⟩ := Finset.mem_filter.mp hz₁
  have hceq : c = μ * ((det v z₀ : ℤ) : ℝ) := by rw [← hz₀c, hμz z₀]
  have hc'eq : c' = μ * ((det v z₁ : ℤ) : ℝ) := by rw [← hz₁c, hμz z₁]
  have hfacec : (S.filter fun y => inner2 w y = c)
      = S.filter fun y => det v y = det v z₀ := by
    ext y
    simp only [Finset.mem_filter, and_congr_right_iff]
    intro _
    rw [hμz y, hceq]
    exact ⟨fun h => by exact_mod_cast mul_left_cancel₀ hμ h, fun h => by rw [h]⟩
  have hfacec' : (S.filter fun y => inner2 w y = c')
      = S.filter fun y => det v y = det v z₁ := by
    ext y
    simp only [Finset.mem_filter, and_congr_right_iff]
    intro _
    rw [hμz y, hc'eq]
    exact ⟨fun h => by exact_mod_cast mul_left_cancel₀ hμ h, fun h => by rw [h]⟩
  have hb1 : μ * ((det v z₀ : ℤ) : ℝ) ≤ μ * ((det v z : ℤ) : ℝ) := by
    rw [← hceq, ← hμz z]; exact hz1
  have hb2 : μ * ((det v z : ℤ) : ℝ) ≤ μ * ((det v z₁ : ℤ) : ℝ) := by
    rw [← hc'eq, ← hμz z]; exact hz2
  have hr₀ : 2 ≤ (S.filter fun y => pi v y = det v z₀).card := by
    show 2 ≤ (S.filter fun y => det v y = det v z₀).card
    rw [← hfacec]; exact hfc2
  have hr₁ : 2 ≤ (S.filter fun y => pi v y = det v z₁).card := by
    show 2 ≤ (S.filter fun y => det v y = det v z₁).card
    rw [← hfacec']; exact le_trans hfc2 hle
  have hrow : 2 ≤ (S.filter fun y => pi v y = det v z).card + 1 := by
    rcases lt_or_gt_of_ne hμ with hneg | hpos
    · exact card_row_ge_of_extreme hconv hvu hr₁ hr₀
        ((cancel_mu _ _ hb2).2 hneg) ((cancel_mu _ _ hb1).2 hneg)
    · exact card_row_ge_of_extreme hconv hvu hr₀ hr₁
        ((cancel_mu _ _ hb1).1 hpos) ((cancel_mu _ _ hb2).1 hpos)
  obtain ⟨z₂, hz₂⟩ : (S.filter fun y => pi v y = det v z).Nonempty :=
    Finset.card_pos.mp (by omega)
  obtain ⟨hz₂S, hz₂t⟩ := Finset.mem_filter.mp hz₂
  have hz₂t' : det v z₂ = det v z := hz₂t
  exact ⟨z₂, hz₂S, by rw [hμz z₂, hμz z, hz₂t']⟩

/-- **Strip periodicity, levels form.**  The output of
`exists_strip_period_of_ambiguousAlong` re-expressed as: `x` is `u`-periodic at
every lattice point whose level lies in `(c, c']`.  This is Cyr-Kra's base case
"`f|B₀` is vertically periodic". -/
theorem period_of_strip {x : Config A}
    {S : Finset (ℤ × ℤ)} (hconv : LatticeConvex S)
    {v : ℤ × ℤ} (hv : Primitive v) {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0)
    {c c' : ℝ}
    (hfc2 : 2 ≤ (S.filter fun z => inner2 w z = c).card)
    (hle : (S.filter fun z => inner2 w z = c).card
            ≤ (S.filter fun z => inner2 w z = c').card)
    {u : ℤ × ℤ}
    (hstrip : ∀ z₀ ∈ S.filter (fun z => c < inner2 w z), ∀ k : ℤ,
        x (k • v + z₀ + u) = x (k • v + z₀)) :
    ∀ z : ℤ × ℤ, c < inner2 w z → inner2 w z ≤ c' → x (z + u) = x z := by
  classical
  intro z hzc hzc'
  obtain ⟨μ, hμ, hμz⟩ := exists_ratio_of_inner2_eq_zero hv.ne_zero hw hwv
  obtain ⟨z₀, hz₀S, hz₀eq⟩ := exists_mem_level hconv hv hw hwv hfc2 hle hzc.le hzc'
  have hz₀mem : z₀ ∈ S.filter fun y => c < inner2 w y :=
    Finset.mem_filter.mpr ⟨hz₀S, by rw [hz₀eq]; exact hzc⟩
  have hdet : det v z₀ = det v z := by
    have h := hz₀eq
    rw [hμz z₀, hμz z] at h
    exact_mod_cast mul_left_cancel₀ hμ h
  have hd0 : det v (z - z₀) = 0 := by
    have h : det v (z - z₀) = det v z - det v z₀ := pi_sub v z z₀
    rw [h, hdet, sub_self]
  obtain ⟨k, hk⟩ := Nivat.eq_zsmul_of_det_eq_zero hv hd0
  have hzk : z = k • v + z₀ := by rw [← hk]; abel
  rw [hzk]
  exact hstrip z₀ hz₀mem k

/-! ## §4.2.1, part 1: window determinacy in place of a *bounded* period

Cyr-Kra's §4.2.1 uses "the minimal vertical period of `f|B_K` is at most `h`":
the pigeonhole over `0 ≤ i < j ≤ 2h` produces a candidate shift `j - i`, and the
bound on the *minimal* period is what lets them conclude that the shift is a
period of the whole strip.  The Morse-Hedlund theorem available here
(`Nivat.periodic_of_subwords_le`) returns *some* period with no bound at all, so
that route is not open.

The replacement used below is a *determinacy* form of Morse-Hedlund: from
`(subwords y n).ncard ≤ n` one extracts a window length `k ≤ n` such that two
positions carrying the same length-`k` window carry the same *whole future and
past*.  That is strictly what §4.2.1 needs, it is bounded by `h` by
construction, and the candidate shift may then be taken from an unrelated
pigeonhole (over `S`-patterns) whose range is bounded by `P_η(𝒮)`. -/

/-- Two-sided determinacy propagates: if a length-`k` window determines the next
symbol and the previous symbol, then it determines the entire bi-infinite
sequence. -/
private theorem agree_of_window_step {β : Type*} (y : ℤ → β) {k : ℕ} (hk : 0 < k)
    (hfwd : ∀ i j : ℤ, (∀ l : ℕ, l < k → y (i + l) = y (j + l)) → y (i + k) = y (j + k))
    (hbwd : ∀ i j : ℤ, (∀ l : ℕ, l < k → y (i + l) = y (j + l)) → y (i - 1) = y (j - 1)) :
    ∀ i j : ℤ, (∀ l : ℕ, l < k → y (i + l) = y (j + l)) →
      ∀ t : ℤ, y (i + t) = y (j + t) := by
  intro i j hij
  have hall : ∀ t : ℤ, ∀ l : ℕ, l < k → y (i + t + l) = y (j + t + l) := by
    intro t
    induction t using Int.induction_on with
    | zero => intro l hl; simpa using hij l hl
    | succ N ih =>
      intro l hl
      rcases Nat.lt_or_ge (l + 1) k with hlk | hlk
      · have hh := ih (l + 1) hlk
        have e1 : i + ((N : ℤ) + 1) + (l : ℤ) = i + (N : ℤ) + ((l + 1 : ℕ) : ℤ) := by
          push_cast; ring
        have e2 : j + ((N : ℤ) + 1) + (l : ℤ) = j + (N : ℤ) + ((l + 1 : ℕ) : ℤ) := by
          push_cast; ring
        rw [e1, e2]; exact hh
      · have hh := hfwd (i + (N : ℤ)) (j + (N : ℤ)) ih
        have hlk2 : (l : ℤ) + 1 = (k : ℤ) := by omega
        have e1 : i + ((N : ℤ) + 1) + (l : ℤ) = i + (N : ℤ) + (k : ℤ) := by linarith
        have e2 : j + ((N : ℤ) + 1) + (l : ℤ) = j + (N : ℤ) + (k : ℤ) := by linarith
        rw [e1, e2]; exact hh
    | pred N ih =>
      intro l hl
      rcases Nat.eq_zero_or_pos l with rfl | hl0
      · have hh := hbwd (i + -(N : ℤ)) (j + -(N : ℤ)) ih
        have e1 : i + (-(N : ℤ) - 1) + ((0 : ℕ) : ℤ) = i + -(N : ℤ) - 1 := by push_cast; ring
        have e2 : j + (-(N : ℤ) - 1) + ((0 : ℕ) : ℤ) = j + -(N : ℤ) - 1 := by push_cast; ring
        rw [e1, e2]; exact hh
      · have hh := ih (l - 1) (by omega)
        have hc : ((l - 1 : ℕ) : ℤ) = (l : ℤ) - 1 := by omega
        rw [hc] at hh
        have e1 : i + (-(N : ℤ) - 1) + (l : ℤ) = i + -(N : ℤ) + ((l : ℤ) - 1) := by ring
        have e2 : j + (-(N : ℤ) - 1) + (l : ℤ) = j + -(N : ℤ) + ((l : ℤ) - 1) := by ring
        rw [e1, e2]; exact hh
  intro t
  simpa using hall t 0 hk

/-- **Morse-Hedlund, determinacy form.**  If a bi-infinite sequence over a finite
alphabet has at most `n` subwords of length `n` (`n > 0`), then there is a window
length `k ≤ n` such that any two positions carrying the same length-`k` window
carry the same sequence from then on, in both directions.

The proof is the proof of `Nivat.periodic_of_subwords_le` up to its case split;
in Case A the sequence is constant and `k = 1` works, and in Case B the plateau
`p k = p (k+1)` with `1 ≤ k < n` gives exactly the two-sided determinacy that
`agree_of_window_step` propagates. -/
private theorem exists_window_determinacy {β : Type*} [Finite β] (y : ℤ → β) {n : ℕ}
    (hn : 0 < n) (h : (subwords y n).ncard ≤ n) :
    ∃ k : ℕ, 0 < k ∧ k ≤ n ∧ ∀ i j : ℤ,
      (∀ l : ℕ, l < k → y (i + l) = y (j + l)) → ∀ t : ℤ, y (i + t) = y (j + t) := by
  classical
  let W : ∀ k : ℕ, ℤ → (Fin k → β) := fun k i l => y (i + (l.val : ℤ))
  have hsub : ∀ k : ℕ, subwords y k = Set.range (W k) := fun k => rfl
  let dl : ∀ k : ℕ, (Fin (k + 1) → β) → (Fin k → β) := fun k wd l => wd ⟨l.val, by omega⟩
  let dr : ∀ k : ℕ, (Fin (k + 1) → β) → (Fin k → β) := fun k wd l => wd ⟨l.val + 1, by omega⟩
  have hdl_W : ∀ k i, dl k (W (k + 1) i) = W k i := by
    intro k i; funext l; rfl
  have hdr_W : ∀ k i, dr k (W (k + 1) i) = W k (i + 1) := by
    intro k i; funext l
    show y (i + ((⟨l.val + 1, by omega⟩ : Fin (k + 1)).val : ℤ)) = y (i + 1 + (l.val : ℤ))
    congr 1; push_cast; ring
  have himg_dl : ∀ k : ℕ, dl k '' subwords y (k + 1) = subwords y k := by
    intro k
    rw [hsub k, hsub (k + 1)]
    apply Set.Subset.antisymm
    · rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩; exact ⟨i, hdl_W k i⟩
    · rintro _ ⟨i, rfl⟩; exact ⟨W (k + 1) i, ⟨i, rfl⟩, hdl_W k i⟩
  have himg_dr : ∀ k : ℕ, dr k '' subwords y (k + 1) = subwords y k := by
    intro k
    rw [hsub k, hsub (k + 1)]
    apply Set.Subset.antisymm
    · rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩; exact ⟨i + 1, (hdr_W k i).symm⟩
    · rintro _ ⟨i, rfl⟩
      refine ⟨W (k + 1) (i - 1), ⟨i - 1, rfl⟩, ?_⟩
      rw [hdr_W k (i - 1)]
      congr 1
      ring
  have hfin : ∀ k : ℕ, (subwords y k).Finite := fun k => Set.toFinite _
  have hne : ∀ k : ℕ, (subwords y k).Nonempty := fun k => ⟨W k 0, 0, rfl⟩
  set p : ℕ → ℕ := fun k => (subwords y k).ncard with hp_def
  have h' : p n ≤ n := h
  have hp_mono : ∀ k : ℕ, p k ≤ p (k + 1) := by
    intro k
    have hle := Set.ncard_image_le (f := dl k) (hfin (k + 1))
    rw [himg_dl k] at hle
    exact hle
  have hp1_pos : 0 < p 1 := (Set.ncard_pos (hfin 1)).2 (hne 1)
  by_cases hstrict : ∀ k : ℕ, 1 ≤ k → k < n → p k < p (k + 1)
  · have hind : ∀ m : ℕ, 1 ≤ m → m ≤ n → p 1 + (m - 1) ≤ p m := by
      intro m hm
      induction m, hm using Nat.le_induction with
      | base => intro _; omega
      | succ m hm ih =>
        intro hmn
        have hstep := hstrict m hm (by omega)
        have := ih (by omega)
        omega
    have hi := hind n hn (le_refl n)
    have hp1_eq : p 1 = 1 := by omega
    obtain ⟨aa, ha⟩ := Set.ncard_eq_one.mp hp1_eq
    have hWa : ∀ i : ℤ, W 1 i = aa := by
      intro i
      have : W 1 i ∈ subwords y 1 := ⟨i, rfl⟩
      rw [ha] at this
      exact this
    have hconst : ∀ i : ℤ, y i = aa ⟨0, by omega⟩ := by
      intro i
      have := congrFun (hWa i) ⟨0, by omega⟩
      simpa [W] using this
    exact ⟨1, one_pos, hn, fun i j _ t => by rw [hconst (i + t), hconst (j + t)]⟩
  · push Not at hstrict
    obtain ⟨k, hk1, hkn, hknlt⟩ := hstrict
    have hpk_eq : p k = p (k + 1) := le_antisymm (hp_mono k) hknlt
    have hk_pos : 0 < k := hk1
    have hinj_dl : Set.InjOn (dl k) (subwords y (k + 1)) := by
      apply Set.injOn_of_ncard_image_eq (hs := hfin (k + 1))
      rw [himg_dl k]
      exact hpk_eq
    have hinj_dr : Set.InjOn (dr k) (subwords y (k + 1)) := by
      apply Set.injOn_of_ncard_image_eq (hs := hfin (k + 1))
      rw [himg_dr k]
      exact hpk_eq
    have hwin_eq : ∀ i j : ℤ, (∀ l : ℕ, l < k → y (i + l) = y (j + l)) → W k i = W k j := by
      intro i j hij
      funext l
      show y (i + (l.val : ℤ)) = y (j + (l.val : ℤ))
      exact hij l.val l.isLt
    have hfwd : ∀ i j : ℤ,
        (∀ l : ℕ, l < k → y (i + l) = y (j + l)) → y (i + k) = y (j + k) := by
      intro i j hij
      have heq : dl k (W (k + 1) i) = dl k (W (k + 1) j) := by
        rw [hdl_W k i, hdl_W k j]; exact hwin_eq i j hij
      have hmem_i : W (k + 1) i ∈ subwords y (k + 1) := ⟨i, rfl⟩
      have hmem_j : W (k + 1) j ∈ subwords y (k + 1) := ⟨j, rfl⟩
      have h2 := hinj_dl hmem_i hmem_j heq
      have h3 := congrFun h2 ⟨k, by omega⟩
      simpa [W] using h3
    have hbwd : ∀ i j : ℤ,
        (∀ l : ℕ, l < k → y (i + l) = y (j + l)) → y (i - 1) = y (j - 1) := by
      intro i j hij
      have heq : dr k (W (k + 1) (i - 1)) = dr k (W (k + 1) (j - 1)) := by
        rw [hdr_W k (i - 1), hdr_W k (j - 1), show i - 1 + 1 = i by ring,
          show j - 1 + 1 = j by ring]
        exact hwin_eq i j hij
      have hmem_i : W (k + 1) (i - 1) ∈ subwords y (k + 1) := ⟨i - 1, rfl⟩
      have hmem_j : W (k + 1) (j - 1) ∈ subwords y (k + 1) := ⟨j - 1, rfl⟩
      have h2 := hinj_dr hmem_i hmem_j heq
      have h3 := congrFun h2 ⟨0, by omega⟩
      simpa [W] using h3
    exact ⟨k, hk_pos, by omega, agree_of_window_step y hk_pos hfwd hbwd⟩

/-- **Cyr-Kra Lemma 2.24, determinacy form.**  Same hypotheses as
`exists_row_period_of_ambiguousAlong`; instead of an unbounded period of the
transverse row sequence, it returns a window length `k ≤ h` that *determines*
the row sequence.  This is the form §4.2.1 needs. -/
theorem exists_row_determinacy_of_ambiguousAlong {ξ x : Config A}
    (hξ : (Set.range ξ).Finite) (hx : x ∈ orbitClosure ξ)
    {Q S : Finset (ℤ × ℤ)} (hQS : Q ⊆ S) {v : ℤ × ℤ}
    (hamb : AmbiguousAlong ξ Q S x v)
    {B : Finset (ℤ × ℤ)} {h : ℕ} (hh : 0 < h)
    (hrow : ∀ j : ℕ, j < h → ∀ b ∈ B, (j : ℤ) • v + b ∈ Q)
    (hcount : P ξ S - P ξ Q ≤ h) :
    ∃ k : ℕ, 0 < k ∧ k ≤ h ∧ ∀ i j : ℤ,
      (∀ l : ℕ, l < k → ∀ b ∈ B, x ((i + (l : ℤ)) • v + b) = x ((j + (l : ℤ)) • v + b)) →
      ∀ t : ℤ, ∀ b ∈ B, x ((i + t) • v + b) = x ((j + t) • v + b) := by
  classical
  have := hξ.to_subtype
  have : Finite (patterns ξ Q) := (patterns_finite_of_range_finite hξ Q).to_subtype
  have hxr : ∀ z : ℤ × ℤ, x z ∈ Set.range ξ := by
    intro z
    obtain ⟨u, hu⟩ := hx {z}
    exact ⟨u + z, (hu z (Finset.mem_singleton_self z)).symm⟩
  have hval : ∀ (p : patterns ξ Q) (q : Q), (p : Q → A) q ∈ Set.range ξ := by
    rintro ⟨p, u, rfl⟩ q
    exact ⟨u + (q : ℤ × ℤ), rfl⟩
  set g : ℤ → (B → Set.range ξ) := fun t b => ⟨x (t • v + (b : ℤ × ℤ)), hxr _⟩ with hg
  set Ψ : patterns ξ Q → (Fin h → (B → Set.range ξ)) := fun p l b =>
    ⟨(p : Q → A) ⟨((l : ℕ) : ℤ) • v + (b : ℤ × ℤ), hrow (l : ℕ) l.isLt (b : ℤ × ℤ) b.2⟩,
      hval p _⟩ with hΨ
  have hsub : subwords g h ⊆ Ψ '' (ambiguous_patterns ξ hQS) := by
    rintro _ ⟨t, rfl⟩
    obtain ⟨p, hp, hpv⟩ := exists_ambiguous_pattern_of_ambiguousAlong hQS hamb t
    refine ⟨p, hp, ?_⟩
    funext l b
    apply Subtype.ext
    show (p : Q → A) _ = x ((t + ((l : ℕ) : ℤ)) • v + (b : ℤ × ℤ))
    rw [hpv]
    show x (t • v + (((l : ℕ) : ℤ) • v + (b : ℤ × ℤ))) =
      x ((t + ((l : ℕ) : ℤ)) • v + (b : ℤ × ℤ))
    congr 1
    rw [add_smul]
    abel
  have hcard : (subwords g h).ncard ≤ h := by
    calc (subwords g h).ncard
        ≤ (Ψ '' (ambiguous_patterns ξ hQS)).ncard :=
          Set.ncard_le_ncard hsub (Set.toFinite _)
      _ ≤ (ambiguous_patterns ξ hQS).ncard := Set.ncard_image_le (Set.toFinite _)
      _ ≤ P ξ S - P ξ Q := ncard_ambiguous_patterns_le_sub hξ hQS
      _ ≤ h := hcount
  obtain ⟨k, hk, hkh, hdet⟩ := exists_window_determinacy g hh hcard
  refine ⟨k, hk, hkh, fun i j hij t b hb => ?_⟩
  have hgg : ∀ s s' : ℤ, (∀ b ∈ B, x (s • v + b) = x (s' • v + b)) → g s = g s' := by
    intro s s' hs
    funext b
    exact Subtype.ext (hs (b : ℤ × ℤ) b.2)
  have hij' : ∀ l : ℕ, l < k → g (i + (l : ℤ)) = g (j + (l : ℤ)) :=
    fun l hl => hgg _ _ (hij l hl)
  exact congrArg Subtype.val (congrFun (hdet i j hij' t) ⟨b, hb⟩)

/-! ## §4.2.1, part 2: geometric helpers -/

/-- A face of a lattice-convex set is a *contiguous* run along `v`: if `a` and
`m • v + a` both lie in `S`, so does every `r • v + a` with `0 ≤ r ≤ m`. -/
private theorem mem_face_run {S : Finset (ℤ × ℤ)} (hS : LatticeConvex S)
    {v : ℤ × ℤ} (hv : Primitive v) {a : ℤ × ℤ} (ha : a ∈ S) {m : ℤ}
    (hbS : m • v + a ∈ S) {r : ℤ} (hr0 : 0 ≤ r) (hrm : r ≤ m) : r • v + a ∈ S := by
  classical
  obtain ⟨u, hvu⟩ := hv.exists_dual
  have hdet_smul : ∀ (s : ℤ) (z : ℤ × ℤ), det v (s • v + z) = det v z := by
    intro s z
    simp only [det, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    ring
  have hdu : ∀ (s : ℤ) (z : ℤ × ℤ), det (s • v + z) u = s * det v u + det z u := by
    intro s z
    simp only [det, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    ring
  have hs2 : det a u + r ≤ det (m • v + a) u := by
    rw [hdu m a, hvu]; linarith
  have key := mem_row_of_between hS hvu ha hbS (rfl : det v a = det v a) (hdet_smul m a)
    (by linarith : det a u ≤ det a u + r) hs2
  have he : (det a u + r) • v + (det v a) • u = r • v + a := by
    have hsplit := eq_smul_add_smul hvu a
    rw [add_smul]
    rw [show det a u • v + r • v + det v a • u = r • v + (det a u • v + det v a • u) by abel,
      ← hsplit]
  rwa [he] at key

/-- Iterating a period: if `u` preserves the `det v`-levels and is a period of
`x` on a band of levels, so is every integer multiple of `u`. -/
private theorem zsmul_period_on_levels {x : Config A} {v u : ℤ × ℤ} (hdu : det v u = 0)
    {lo hi : ℤ} (hper : ∀ z : ℤ × ℤ, lo ≤ det v z → det v z ≤ hi → x (z + u) = x z)
    (e : ℤ) : ∀ z : ℤ × ℤ, lo ≤ det v z → det v z ≤ hi → x (z + e • u) = x z := by
  have hlev : ∀ (s : ℤ) (z : ℤ × ℤ), det v (z + s • u) = det v z := by
    intro s z
    have hd : det v (z + s • u) = det v z + s * det v u := by
      simp only [det, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
      ring
    rw [hd, hdu, mul_zero, add_zero]
  intro z hlo hhi
  induction e using Int.induction_on with
  | zero => simp
  | succ N ih =>
    have h1 : z + ((N : ℤ) + 1) • u = (z + (N : ℤ) • u) + u := by
      rw [add_smul, one_smul]; abel
    rw [h1, hper (z + (N : ℤ) • u) (by rw [hlev]; exact hlo) (by rw [hlev]; exact hhi), ih]
  | pred N ih =>
    have h1 : (z + (-(N : ℤ) - 1) • u) + u = z + (-(N : ℤ)) • u := by
      rw [sub_smul, one_smul]; abel
    have h2 := hper (z + (-(N : ℤ) - 1) • u) (by rw [hlev]; exact hlo) (by rw [hlev]; exact hhi)
    rw [h1] at h2
    rw [← h2, ih]

/-- Translates of a member of the orbit closure stay in the orbit closure. -/
private theorem translate_mem_orbitClosure {ξ x : Config A} (hx : x ∈ orbitClosure ξ)
    (t : ℤ × ℤ) : (fun z => x (t + z)) ∈ orbitClosure ξ := by
  classical
  intro W
  obtain ⟨u, hu⟩ := hx (W.image fun w => t + w)
  refine ⟨u + t, fun wq hwq => ?_⟩
  have h := hu (t + wq) (Finset.mem_image_of_mem _ hwq)
  show x (t + wq) = ξ (u + t + wq)
  rw [h]; congr 1; abel

/-- **Two-sided face sweep, localized.**  This is the variant of
`eq_on_closed_level_of_face_sweep` that §4.2.1 actually needs, differing in two
ways.

*The seed is finite.*  `eq_on_closed_level_of_face_sweep` seeds the sweep with a
half-line of level `d` (`dotZ · v > n₀`) and can therefore only run downwards.
Here the seed is the *face translate* `{r • v + p : 0 ≤ r ≤ m}`, a run of `m + 1`
consecutive points, which is exactly what a single agreeing `S`-window supplies;
the sweep then runs in *both* directions, downwards off the `dotZ`-minimal
endpoint `a` and upwards off the `dotZ`-maximal endpoint `m • v + a`.

*The prior knowledge is localized.*  `hknown` is only assumed on the band
`d < inner2 w z ≤ d + (c' - c)`, i.e. on `diam_w(S)` many levels above `d`, and
not on the whole open half-plane above `d`.  (The proof of
`eq_on_closed_level_of_face_sweep` never uses more than this either; but its
statement does, and in §4.2.1 only the band is available.) -/
private theorem eq_on_level_of_face_seed {ξ : Config A}
    (hfin : (Set.range ξ).Finite) {S : Finset (ℤ × ℤ)}
    (hgen : IsGeneratingSet ξ S) {v : ℤ × ℤ} (hv : Primitive v)
    {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0) {c c' : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z) (hmax : ∀ z ∈ S, inner2 w z ≤ c')
    {a : ℤ × ℤ} (ha : a ∈ S) (hac : inner2 w a = c)
    (hamin : ∀ z ∈ S, inner2 w z = c → dotZ a v ≤ dotZ z v)
    {m : ℤ} (hm0 : 0 ≤ m) (hbS : m • v + a ∈ S)
    (hbmax : ∀ z ∈ S, inner2 w z = c → dotZ z v ≤ dotZ (m • v + a) v)
    {y y' : Config A} (hy : y ∈ sftOf ξ S) (hy' : y' ∈ sftOf ξ S)
    {d : ℝ}
    (hknown : ∀ z : ℤ × ℤ, d < inner2 w z → inner2 w z ≤ d + (c' - c) → y z = y' z)
    {p : ℤ × ℤ} (hp : inner2 w p = d)
    (hseed : ∀ r : ℤ, 0 ≤ r → r ≤ m → y (r • v + p) = y' (r • v + p)) :
    ∀ z : ℤ × ℤ, inner2 w z = d → y z = y' z := by
  classical
  have hepos : 0 < dotZ v v := by
    have hv0 : v ≠ 0 := hv.ne_zero
    have hor : v.1 ≠ 0 ∨ v.2 ≠ 0 := by
      rcases eq_or_ne v.1 0 with h1 | h1
      · rcases eq_or_ne v.2 0 with h2 | h2
        · exact absurd (Prod.ext h1 h2) hv0
        · exact Or.inr h2
      · exact Or.inl h1
    simp only [dotZ]
    rcases hor with h1 | h1
    · nlinarith [sq_nonneg v.1, sq_nonneg v.2, mul_self_pos.mpr h1]
    · nlinarith [sq_nonneg v.1, sq_nonneg v.2, mul_self_pos.mpr h1]
  have hsmulZ : ∀ (r : ℤ) (z : ℤ × ℤ), dotZ (r • v + z) v = r * dotZ v v + dotZ z v := by
    intro r z
    simp only [dotZ, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    ring
  have hinner_smul : ∀ (r : ℤ) (z : ℤ × ℤ), inner2 w (r • v + z) = inner2 w z := by
    intro r z
    rw [inner2_add_pair, inner2_zsmul, hwv, mul_zero, zero_add]
  have hbc : inner2 w (m • v + a) = c := by rw [hinner_smul, hac]
  -- the face is exactly the run `{r • v + a : 0 ≤ r ≤ m}`
  have hface : ∀ s ∈ S, inner2 w s = c → ∃ r : ℤ, 0 ≤ r ∧ r ≤ m ∧ s = r • v + a := by
    intro s hs hsc
    have hzero : inner2 w (s - a) = 0 := by rw [inner2_sub_pair, hsc, hac, sub_self]
    obtain ⟨r, hr⟩ :=
      Nivat.eq_zsmul_of_det_eq_zero hv (det_eq_zero_of_inner2_eq_zero hw hwv hzero)
    have hs_eq : s = r • v + a := by rw [← hr]; abel
    refine ⟨r, ?_, ?_, hs_eq⟩
    · have h1 := hamin s hs hsc
      rw [hs_eq, hsmulZ] at h1
      nlinarith
    · have h2 := hbmax s hs hsc
      rw [hs_eq, hsmulZ, hsmulZ] at h2
      nlinarith
  have hline : ∀ z : ℤ × ℤ, inner2 w z = d → ∃ r : ℤ, z = r • v + p := by
    intro z hz
    have hzero : inner2 w (z - p) = 0 := by rw [inner2_sub_pair, hz, hp, sub_self]
    obtain ⟨r, hr⟩ :=
      Nivat.eq_zsmul_of_det_eq_zero hv (det_eq_zero_of_inner2_eq_zero hw hwv hzero)
    exact ⟨r, by rw [← hr]; abel⟩
  have hPa : P ξ (S.erase a) = P ξ S :=
    P_eq_of_generatesAt hfin (generatesAt_of_min_on_face hgen hv hw hwv hmin ha hac hamin)
  have hPb : P ξ (S.erase (m • v + a)) = P ξ S :=
    P_eq_of_generatesAt hfin (generatesAt_of_max_on_face hgen hv hw hwv hmin hbS hbc hbmax)
  -- sweep downwards off the `dotZ`-minimal endpoint
  have hdown : ∀ N : ℕ, ∀ r : ℤ, -(N : ℤ) ≤ r → r ≤ m → y (r • v + p) = y' (r • v + p) := by
    intro N
    induction N with
    | zero => intro r h1 h2; exact hseed r (by omega) h2
    | succ N ih =>
      intro r h1 h2
      by_cases hr : -(N : ℤ) ≤ r
      · exact ih r hr h2
      · have hrv : r = -(N : ℤ) - 1 := by omega
        have hlevr : inner2 w (r • v + p) = d := by rw [hinner_smul, hp]
        have hagr : ∀ s ∈ S.erase a,
            y (((r • v + p) - a) + s) = y' (((r • v + p) - a) + s) := by
          intro s hs
          obtain ⟨hsa, hsS⟩ := Finset.mem_erase.mp hs
          rcases eq_or_lt_of_le (hmin s hsS) with hsc | hsc
          · obtain ⟨r', hr'0, hr'm, rfl⟩ := hface s hsS hsc.symm
            have hr'1 : 1 ≤ r' := by
              rcases eq_or_lt_of_le hr'0 with he | he
              · exact absurd (by rw [← he, zero_smul, zero_add]) hsa
              · omega
            have he : (r • v + p) - a + (r' • v + a) = (r + r') • v + p := by
              rw [add_smul]; abel
            rw [he]
            exact ih (r + r') (by omega) (by omega)
          · have hlev : inner2 w ((r • v + p) - a + s) = d - c + inner2 w s := by
              rw [inner2_add_pair, inner2_sub_pair, hlevr, hac]
            refine hknown _ (by rw [hlev]; linarith) ?_
            have := hmax s hsS
            rw [hlev]; linarith
        have hg := sft_eq_of_generatesAt hfin ha hPa hy hy' ((r • v + p) - a) hagr
        rwa [show ((r • v + p) - a) + a = r • v + p by abel] at hg
  -- sweep upwards off the `dotZ`-maximal endpoint
  have hup : ∀ N : ℕ, ∀ r : ℤ, 0 ≤ r → r ≤ m + (N : ℤ) →
      y (r • v + p) = y' (r • v + p) := by
    intro N
    induction N with
    | zero => intro r h1 h2; exact hseed r h1 (by omega)
    | succ N ih =>
      intro r h1 h2
      by_cases hr : r ≤ m + (N : ℤ)
      · exact ih r h1 hr
      · have hrv : r = m + (N : ℤ) + 1 := by omega
        have hlevr : inner2 w (r • v + p) = d := by rw [hinner_smul, hp]
        have hagr : ∀ s ∈ S.erase (m • v + a),
            y (((r • v + p) - (m • v + a)) + s) = y' (((r • v + p) - (m • v + a)) + s) := by
          intro s hs
          obtain ⟨hsa, hsS⟩ := Finset.mem_erase.mp hs
          rcases eq_or_lt_of_le (hmin s hsS) with hsc | hsc
          · obtain ⟨r', hr'0, hr'm, rfl⟩ := hface s hsS hsc.symm
            have hr'lt : r' < m := by
              rcases eq_or_lt_of_le hr'm with he | he
              · exact absurd (by rw [he]) hsa
              · exact he
            have he2 : (r • v + p) - (m • v + a) + (r' • v + a) = (r - m + r') • v + p := by
              rw [add_smul, sub_smul]; abel
            rw [he2]
            exact ih (r - m + r') (by omega) (by omega)
          · have hlev : inner2 w ((r • v + p) - (m • v + a) + s) = d - c + inner2 w s := by
              rw [inner2_add_pair, inner2_sub_pair, hlevr, hbc]
            refine hknown _ (by rw [hlev]; linarith) ?_
            have := hmax s hsS
            rw [hlev]; linarith
        have hg := sft_eq_of_generatesAt hfin hbS hPb hy hy'
          ((r • v + p) - (m • v + a)) hagr
        rwa [show ((r • v + p) - (m • v + a)) + (m • v + a) = r • v + p by abel] at hg
  intro z hz
  obtain ⟨r, rfl⟩ := hline z hz
  by_cases hrm : r ≤ m
  · exact hdown (-r).toNat r (by omega) hrm
  · exact hup (r - m).toNat r (by omega) (by omega)

/-! ## Proposition 2.10 -/

/-! ## Cyr-Kra Proposition 4.8: downward induction (proved)

The downward induction `B_K → B_{K-1}` of Cyr-Kra §4.2.1-§4.2.3 is proved at
`cyrKra_downward_induction` below, via the core
`cyrKra_downward_induction_pos`.  §4.2.2 is `downward_step_of_unique`; §4.2.1
is replaced by a determinacy-window argument
(`exists_row_determinacy_of_ambiguousAlong` plus a pattern pigeonhole) rather
than Cyr-Kra's Corollary 2.25; §4.2.4-§4.2.5 (uniformisation of the per-level
periods) is handled by taking the shift `M • v` with
`M = |q| · (P η(𝒮))!`, which every per-level period divides. -/

/-! ### Notes on Proposition 2.10: how it is proved

**Colle, arXiv:1909.08195v4, Proposition 2.10** (quoted verbatim in the
module docstring), in the conventions fixed there.

`honed` is Colle's `ℓ ∈ ONED(η)`, written out; `hgen` is "`𝒮` is an
`η`-generating set"; `hle` is `|𝒮 ∩ ℓ_𝒮| ≤ |𝒮 ∩ -ℓ_𝒮|`; `hcount` is
`P_η(𝒮) - P_η(𝒮 \ ℓ_𝒮) ≤ |𝒮 ∩ ℓ_𝒮| - 1`; `hamb` is "`x` is
`(ℓ,𝒮)`-ambiguous"; the conclusion is "the restriction of `x` to `ℋ(-ℓ_𝒮)`
is periodic with period parallel to `ℓ`".

`colle_prop_2_10` is a two-line consequence of `cyrKra_downward_induction`,
which is now proved; neither carries a `sorry`.  The items below record which
piece plays which role.

#### The pieces, all proved unconditionally

* `exists_strip_period_of_ambiguousAlong` — a non-zero period `q•v` for `x` on
  the strip swept by `𝒮 \ ℓ_𝒮` (Cyr-Kra Lemma 2.24).  This is Cyr-Kra's base
  case "`f|B₀` is vertically periodic of period at most `h`".
* `period_of_strip` — the same statement in *levels* form, `c < inner2 w z ≤ c'`.
  Note the correction recorded at that lemma: lattice convexity alone does not
  make the level set an interval, and the repair needs `2 ≤ |𝒮 ∩ ℓ_𝒮|`, which is
  `two_le_card_face_of_oneSidedNonexpansive`.
* `sftOf` and `sft_eq_of_generatesAt` — the subshift of finite type `X_𝒮(η)`,
  and the fact that Colle-style generation, being a statement about *pattern
  counts of `ξ`*, controls every member of the SFT and not merely the orbit
  closure.
* `generatesAt_of_min_on_face`, `generatesAt_of_max_on_face` — **Cyr-Kra
  Definition 4.5(ii)** ("the endpoints of `ℓ(𝒮)` are `η`-generated"), which the
  paper *assumes*, is here a *theorem* for Colle-style generating sets: a face
  endpoint is the unique minimiser of the tilted functional `w + ε v`, hence a
  vertex in Colle's sense.
* `sftOf_glue` and `downward_step_of_unique` — **all of §4.2.2**.  An earlier
  version of this note called the gluing step "a real obstruction, not
  bookkeeping"; that was correct about the orbit closure and wrong about the
  difficulty.  Once `X_𝒮(η)` exists the gluing is short, and the load-bearing
  fact is the numerology `diam_w(B_K) = diam_w(𝒮̃)`: the periodic strip is
  exactly one level narrower than `𝒮`, so an `𝒮`-translate straddling the seam
  has its whole upper part inside the strip.
* `downward_step_instance` — the five hypotheses of `downward_step_of_unique`
  shown to hold *simultaneously*, over a two-letter alphabet with a non-constant
  `ξ` (`altColumns_not_constant`), with the conclusion obtained by applying the
  theorem.  This is the non-degeneracy check that matters for an induction step:
  individually satisfiable hypotheses that never co-occur would make the lemma
  worthless.  (The `Unit`-alphabet witness `extendsUniquelyBelow_example` is kept
  only as the trivial lower bound; it proves nothing on its own.)
* `eq_of_dotZ_eq_on_level` and `eq_on_closed_level_of_face_sweep` — **the final
  step of §4.2.1**, the "easy induction argument" that propagates an agreement
  from one anchor along the face.  An earlier version of this note listed this as
  blocked, on the ground that the repository's only determinism lemma
  `eq_of_halfPlane_of_generatesAt` needs a *one-point* face, which
  `two_le_card_face_of_oneSidedNonexpansive` rules out.  That diagnosis was
  right about `eq_of_halfPlane_of_generatesAt` and wrong about the obstruction:
  the multi-point-face version is proved above by sweeping down the face from its
  `dotZ`-minimal endpoint, each step anchoring `𝒮` so that the generated site
  lands on the next unknown point.
* `eq_on_level_of_face_seed` — the *localised* version of the same sweep, and the
  one actually used below.  `eq_on_closed_level_of_face_sweep` demands agreement
  on the whole closed region above the level, which is never available during the
  downward induction; this variant demands it only on the single strip of
  thickness `c' - c` sitting directly above, sweeps in *both* directions off the
  two face endpoints, and takes its seed on the face run itself.
* `exists_row_determinacy_of_ambiguousAlong` and its engine
  `exists_window_determinacy` — a *bounded determinacy window* `k ≤ h`, in place
  of Cyr-Kra's bounded minimal period.  Proof: the two-sided Morse-Hedlund
  plateau argument of `Nivat.periodic_of_subwords_le`, stopped one step earlier
  so that the plateau length, not a period, is what is returned.
* `mem_face_run` — the face of a lattice-convex `𝒮` is a contiguous run
  `{r • v + a : 0 ≤ r ≤ m}`; `zsmul_period_on_levels` — a period on a band of
  levels may be multiplied by any integer; `translate_mem_orbitClosure`.

#### How §4.2.1 is closed here, and how it departs from the source

1. **Cyr-Kra Corollary 2.25 is *not* used.**  The source derives "`f|B_K` does
   not extend uniquely ⇒ `f|B_K` is periodic of period `≤ h`" from `Ext_w`, the
   `(𝒮̃,w)`-border of a half plane, `j`-subextensions and `m`-interiors, none of
   which exist in this repository — and the two statements that do exist,
   `periodic_border_of_ambiguous` / `periodic_interior_of_ambiguous_extension`
   in `Nivat.External.Colle.CyrKra224`, are **machine-refuted there as stated**
   (by `periodic_border_of_ambiguous_false` and
   `periodic_interior_of_ambiguous_extension_false`).  Nothing below cites them.

   The substitute is a *bounded determinacy window* instead of a bounded
   period.  `exists_row_determinacy_of_ambiguousAlong` (proved above, by the
   two-sided Morse-Hedlund plateau argument transplanted from
   `Nivat.periodic_of_subwords_le`) yields `k ≤ h` such that any two `v`-rows of
   `x` over the row base `B` that agree on `k` consecutive steps agree
   everywhere.  This is strictly weaker than "the minimal period is `≤ h`", and
   it is all the argument needs, because the *candidate* shift is obtained
   separately.

2. **The pigeonhole.**  The shift comes from `P η(𝒮) + 1` translates
   `pattern x 𝒮 (i • v)`, `0 ≤ i ≤ P η(𝒮)`, of which two must coincide; their
   gap `1 ≤ d ≤ P η(𝒮)` is the candidate.  A coincidence of full `𝒮`-patterns
   supplies both (i) the `k` consecutive row agreements demanded by item 1,
   since the row base sits inside `𝒮̃` at heights `0, …, h-1`, and (ii) the seed
   for the face sweep.  `hcount` and `hh : 0 < h` enter only through
   `exists_row_determinacy_of_ambiguousAlong`; `hle` only feeds the height
   lemma `exists_rowBase_of_latticeConvex`.  The count of the source
   (`P_η(𝒮) - (P_η(𝒮̃) - h) ≤ 2h`) is therefore replaced, not reproduced.

3. **Uniformity of the period (§4.2.4-§4.2.5).**  The conclusion asks for a
   *single* `u'` on the whole half-plane.  Cyr-Kra pass to `(2|w ∩ 𝒮| - 2)!`;
   here the uniform shift is `M • v` with `M = |q| · (P η(𝒮))!`, where `q • v`
   is the given strip period.  Every per-level shift produced in the induction
   is `d • v` with `1 ≤ d ≤ P η(𝒮)`, so `d ∣ M`, and `zsmul_period_on_levels`
   promotes it; likewise `q ∣ M` on the strip.  `M ≠ 0` gives `u' ≠ 0`.

4. **`c = c'` is not a special case here.**  If `c = c'` then
   `𝒮.filter (c < inner2 w ·)` is empty and `hstrip` is vacuous; the proof still
   runs, because the base of the descent is then also vacuous and the face
   sweep in `eq_on_level_of_face_seed` never needs its strip hypothesis
   `hknown` (all of `𝒮` lies on the single face level).  No case split on
   `c < c'` appears below.

#### One remaining mismatch with the source, recorded rather than patched

Cyr-Kra's Lemma 4.7 delivers an `ℓ`-*balanced* `𝒮` (Definition 4.5), which is
a strictly weaker condition than Colle's `IsGeneratingSet`: balancedness only
asks that the two *face endpoints* be generated, whereas `IsGeneratingSet`
asks it of every convexity-preserving site.  So `hgen` here is Colle's
hypothesis, and the §4.2 argument is re-run with it rather than transported
verbatim.  The direction that matters is the easy one and is proved above
(`generatesAt_of_*_on_face`). -/

/-- **Cyr-Kra Proposition 4.8, downward step: the positively-oriented core.**
Same statement as `cyrKra_downward_induction` below, plus the normalisation
`inner2 w · = μ * det v ·` with `μ > 0`; the general case follows by swapping
`v` for `-v`. -/
private theorem cyrKra_downward_induction_pos {ξ x : Config A}
    (hξ : (Set.range ξ).Finite) (hx : x ∈ orbitClosure ξ)
    {S : Finset (ℤ × ℤ)} (hgen : IsGeneratingSet ξ S)
    {v : ℤ × ℤ} (hv : Primitive v) {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0)
    {μ : ℝ} (hμpos : 0 < μ)
    (hμz : ∀ z : ℤ × ℤ, inner2 w z = μ * ((det v z : ℤ) : ℝ))
    {c c' : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z) (hmax : ∀ z ∈ S, inner2 w z ≤ c')
    (hfc : (S.filter fun z => inner2 w z = c).Nonempty)
    (hle : (S.filter fun z => inner2 w z = c).card ≤
      (S.filter fun z => inner2 w z = c').card)
    (hcount : P ξ S - P ξ (S.filter fun z => c < inner2 w z) ≤
      (S.filter fun z => inner2 w z = c).card - 1)
    (honed : ∃ y ∈ orbitClosure ξ, ∃ y' ∈ orbitClosure ξ, y ≠ y' ∧
        ∀ z : ℤ × ℤ, 0 ≤ inner2 w z → y z = y' z)
    {u : ℤ × ℤ} (hu0 : u ≠ 0) (huw : inner2 w u = 0)
    (hupers : ∀ z₀ ∈ S.filter (fun z => c < inner2 w z), ∀ k : ℤ,
      x (k • v + z₀ + u) = x (k • v + z₀)) :
    ∃ u' : ℤ × ℤ, u' ≠ 0 ∧ inner2 w u' = 0 ∧
      ∀ z : ℤ × ℤ, inner2 w z ≤ c → x (z + u') = x z := by
  classical
  -- ### 0.  Dictionary between the real form `inner2 w ·` and the integral form `det v ·`
  have hge_iff : ∀ (z : ℤ × ℤ) (n : ℤ), μ * (n : ℝ) ≤ inner2 w z ↔ n ≤ det v z := by
    intro z n
    rw [hμz z]
    constructor
    · intro hh; exact_mod_cast le_of_mul_le_mul_left hh hμpos
    · intro hh; exact mul_le_mul_of_nonneg_left (by exact_mod_cast hh) hμpos.le
  have hle_iff : ∀ (z : ℤ × ℤ) (n : ℤ), inner2 w z ≤ μ * (n : ℝ) ↔ det v z ≤ n := by
    intro z n
    rw [hμz z]
    constructor
    · intro hh; exact_mod_cast le_of_mul_le_mul_left hh hμpos
    · intro hh; exact mul_le_mul_of_nonneg_left (by exact_mod_cast hh) hμpos.le
  have hlt_iff : ∀ (z : ℤ × ℤ) (n : ℤ), μ * (n : ℝ) < inner2 w z ↔ n < det v z := by
    intro z n
    rw [hμz z]
    constructor
    · intro hh; exact_mod_cast lt_of_mul_lt_mul_left hh hμpos.le
    · intro hh
      have hcast : ((n : ℤ) : ℝ) < ((det v z : ℤ) : ℝ) := by exact_mod_cast hh
      nlinarith
  have heq_iff : ∀ (z : ℤ × ℤ) (n : ℤ), inner2 w z = μ * (n : ℝ) ↔ det v z = n := by
    intro z n
    rw [hμz z]
    constructor
    · intro hh; exact_mod_cast mul_left_cancel₀ (ne_of_gt hμpos) hh
    · intro hh; rw [hh]
  have hdetadd : ∀ p q : ℤ × ℤ, det v (p + q) = det v p + det v q := by
    intro p q; simp only [det, Prod.fst_add, Prod.snd_add]; ring
  have hdetsub : ∀ p q : ℤ × ℤ, det v (p - q) = det v p - det v q := by
    intro p q; simp only [det, Prod.fst_sub, Prod.snd_sub]; ring
  have hdetrun : ∀ (r : ℤ) (z : ℤ × ℤ), det v (r • v + z) = det v z := by
    intro r z
    simp only [det, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    ring
  have hdetv : ∀ r : ℤ, det v (r • v) = 0 := by
    intro r
    simp only [det, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]; ring
  have hepos : 0 < dotZ v v := by
    have hv0 : v ≠ 0 := hv.ne_zero
    have hor : v.1 ≠ 0 ∨ v.2 ≠ 0 := by
      rcases eq_or_ne v.1 0 with h1 | h1
      · rcases eq_or_ne v.2 0 with h2 | h2
        · exact absurd (Prod.ext h1 h2) hv0
        · exact Or.inr h2
      · exact Or.inl h1
    simp only [dotZ]
    rcases hor with h1 | h1
    · nlinarith [sq_nonneg v.1, sq_nonneg v.2, mul_self_pos.mpr h1]
    · nlinarith [sq_nonneg v.1, sq_nonneg v.2, mul_self_pos.mpr h1]
  have hsmulZ : ∀ (r : ℤ) (z : ℤ × ℤ), dotZ (r • v + z) v = r * dotZ v v + dotZ z v := by
    intro r z
    simp only [dotZ, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    ring
  -- ### 1.  The two extreme levels of `S`
  have hfc2 : 2 ≤ (S.filter fun z => inner2 w z = c).card :=
    two_le_card_face_of_oneSidedNonexpansive hgen hmin hfc honed
  obtain ⟨zc, hzcmem⟩ := hfc
  obtain ⟨hzcS, hzcc⟩ := Finset.mem_filter.mp hzcmem
  obtain ⟨zc', hzc'mem⟩ : (S.filter fun z => inner2 w z = c').Nonempty :=
    Finset.card_pos.mp (by omega)
  obtain ⟨hzc'S, hzc'c⟩ := Finset.mem_filter.mp hzc'mem
  obtain ⟨m₀, hm₀⟩ : ∃ n : ℤ, det v zc = n := ⟨_, rfl⟩
  obtain ⟨m₁, hm₁⟩ : ∃ n : ℤ, det v zc' = n := ⟨_, rfl⟩
  have hc : c = μ * (m₀ : ℝ) := by rw [← hzcc, hμz zc, hm₀]
  have hc' : c' = μ * (m₁ : ℝ) := by rw [← hzc'c, hμz zc', hm₁]
  have hSmin : ∀ z ∈ S, m₀ ≤ det v z := by
    intro z hz; exact (hge_iff z m₀).mp (by rw [← hc]; exact hmin z hz)
  have hSmax : ∀ z ∈ S, det v z ≤ m₁ := by
    intro z hz; exact (hle_iff z m₁).mp (by rw [← hc']; exact hmax z hz)
  have hm01 : m₀ ≤ m₁ := by have := hSmin zc' hzc'S; omega
  have hQlev : ∀ s ∈ S.filter (fun z => c < inner2 w z), m₀ + 1 ≤ det v s := by
    intro s hs
    obtain ⟨hsS, hsc⟩ := Finset.mem_filter.mp hs
    have := (hlt_iff s m₀).mp (by rw [← hc]; exact hsc)
    omega
  -- ### 2.  The face `ℓ(S)` is a contiguous run `{r • v + a : 0 ≤ r ≤ m}`
  obtain ⟨a, haF, haminF⟩ :=
    (S.filter fun z => inner2 w z = c).exists_min_image (fun z => dotZ z v) ⟨zc, hzcmem⟩
  obtain ⟨bb, hbF, hbmaxF⟩ :=
    (S.filter fun z => inner2 w z = c).exists_max_image (fun z => dotZ z v) ⟨zc, hzcmem⟩
  obtain ⟨haS, hac⟩ := Finset.mem_filter.mp haF
  obtain ⟨hbS0, hbc0⟩ := Finset.mem_filter.mp hbF
  have hamin : ∀ z ∈ S, inner2 w z = c → dotZ a v ≤ dotZ z v :=
    fun z hz hzc => haminF z (Finset.mem_filter.mpr ⟨hz, hzc⟩)
  have hbmax0 : ∀ z ∈ S, inner2 w z = c → dotZ z v ≤ dotZ bb v :=
    fun z hz hzc => hbmaxF z (Finset.mem_filter.mpr ⟨hz, hzc⟩)
  have hzeroab : inner2 w (bb - a) = 0 := by rw [inner2_sub_pair, hbc0, hac, sub_self]
  obtain ⟨m, hmeq⟩ :=
    Nivat.eq_zsmul_of_det_eq_zero hv (det_eq_zero_of_inner2_eq_zero hw hwv hzeroab)
  have hbeq : bb = m • v + a := by rw [← hmeq]; abel
  have hm0 : 0 ≤ m := by
    have h1 := hamin bb hbS0 hbc0
    rw [hbeq, hsmulZ] at h1
    nlinarith
  have hbS : m • v + a ∈ S := by rw [← hbeq]; exact hbS0
  have hbc : inner2 w (m • v + a) = c := by rw [← hbeq]; exact hbc0
  have hbmax : ∀ z ∈ S, inner2 w z = c → dotZ z v ≤ dotZ (m • v + a) v := by
    intro z hz hzc; rw [← hbeq]; exact hbmax0 z hz hzc
  have hcontig : ∀ r : ℤ, 0 ≤ r → r ≤ m → r • v + a ∈ S :=
    fun r h1 h2 => mem_face_run hgen.2.1 hv haS hbS h1 h2
  have hface : ∀ s ∈ S, inner2 w s = c → ∃ r : ℤ, 0 ≤ r ∧ r ≤ m ∧ s = r • v + a := by
    intro s hs hsc
    have hzero : inner2 w (s - a) = 0 := by rw [inner2_sub_pair, hsc, hac, sub_self]
    obtain ⟨r, hr⟩ :=
      Nivat.eq_zsmul_of_det_eq_zero hv (det_eq_zero_of_inner2_eq_zero hw hwv hzero)
    have hs_eq : s = r • v + a := by rw [← hr]; abel
    refine ⟨r, ?_, ?_, hs_eq⟩
    · have h1 := hamin s hs hsc
      rw [hs_eq, hsmulZ] at h1
      nlinarith
    · have h2 := hbmax s hs hsc
      rw [hs_eq, hsmulZ, hsmulZ] at h2
      nlinarith
  have hdeta : det v a = m₀ := (heq_iff a m₀).mp (by rw [hac]; exact hc)
  have hdetb : det v (m • v + a) = m₀ := by rw [hdetrun, hdeta]
  have hPa : P ξ (S.erase a) = P ξ S :=
    P_eq_of_generatesAt hξ (generatesAt_of_min_on_face hgen hv hw hwv hmin haS hac hamin)
  have hPb : P ξ (S.erase (m • v + a)) = P ξ S :=
    P_eq_of_generatesAt hξ (generatesAt_of_max_on_face hgen hv hw hwv hmin hbS hbc hbmax)
  -- ### 3.  The given period `u` is an integer multiple of `v`; enlarge it to `u'`
  have hdvu : det v u = 0 := by
    have h := huw
    rw [hμz u] at h
    rcases mul_eq_zero.mp h with h' | h'
    · exact absurd h' (ne_of_gt hμpos)
    · exact_mod_cast h'
  obtain ⟨q, hq⟩ := Nivat.eq_zsmul_of_det_eq_zero hv hdvu
  have hq0 : q ≠ 0 := by
    intro hzz; rw [hzz, zero_smul] at hq; exact hu0 hq
  obtain ⟨Mval, hMdef⟩ :
      ∃ t : ℤ, ((q.natAbs : ℤ)) * ((Nat.factorial (P ξ S) : ℕ) : ℤ) = t := ⟨_, rfl⟩
  have hMpos : 0 < Mval := by
    rw [← hMdef]
    have h1 : 0 < (q.natAbs : ℤ) := by
      have : q.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hq0
      omega
    have h2 : 0 < ((Nat.factorial (P ξ S) : ℕ) : ℤ) := by
      exact_mod_cast Nat.factorial_pos (P ξ S)
    exact mul_pos h1 h2
  have hqdvd : q ∣ Mval := by
    rw [← hMdef]
    exact Dvd.dvd.mul_right (Int.dvd_natAbs.mpr dvd_rfl) _
  have hu'ne : Mval • v ≠ 0 := by
    intro hzero
    have h1 : dotZ (Mval • v) v = Mval * dotZ v v := by
      simp only [dotZ, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]; ring
    rw [hzero] at h1
    have h2 : dotZ ((0 : ℤ × ℤ)) v = 0 := by simp only [dotZ]; ring_nf; simp
    rw [h2] at h1
    exact absurd h1.symm (ne_of_gt (mul_pos hMpos hepos))
  refine ⟨Mval • v, hu'ne, by rw [inner2_zsmul, hwv, mul_zero], ?_⟩
  have hxsft : x ∈ sftOf ξ S := orbitClosure_subset_sftOf ξ S hx
  -- ### 4.  Base case of the descent: periodicity on the strip, with period `u'`
  have hstrip_per : ∀ z : ℤ × ℤ, c < inner2 w z → inner2 w z ≤ c' → x (z + u) = x z :=
    period_of_strip hgen.2.1 hv hw hwv hfc2 hle hupers
  have hbase1 : ∀ z : ℤ × ℤ, m₀ + 1 ≤ det v z → det v z ≤ m₁ → x (z + u) = x z := by
    intro z h1 h2
    refine hstrip_per z ?_ ?_
    · rw [hc]; exact (hlt_iff z m₀).mpr (by omega)
    · rw [hc']; exact (hle_iff z m₁).mpr h2
  obtain ⟨e₀, he₀⟩ := hqdvd
  have hu'alt : Mval • v = e₀ • u := by
    rw [hq, smul_smul, he₀, mul_comm]
  have hbase : ∀ z : ℤ × ℤ, m₀ + 1 ≤ det v z → det v z ≤ m₁ → x (z + Mval • v) = x z := by
    intro z h1 h2
    rw [hu'alt]
    exact zsmul_period_on_levels hdvu hbase1 e₀ z h1 h2
  -- ### 5.  Cyr-Kra's row base for the strip
  obtain ⟨B, hrowB, hcoverB⟩ :=
    exists_rowBase_of_latticeConvex hgen.2.1 hv hw hwv hmin hmax hle
  have hhpos : 0 < (S.filter fun z => inner2 w z = c).card - 1 := by omega
  -- ### 6.  The descent
  have hmain : ∀ N : ℕ, ∀ z : ℤ × ℤ, m₀ + 1 - (N : ℤ) ≤ det v z → det v z ≤ m₁ →
      x (z + Mval • v) = x z := by
    intro N
    induction N with
    | zero => intro z h1 h2; exact hbase z (by omega) h2
    | succ N ih =>
      intro z h1 h2
      by_cases hzge : m₀ + 1 - (N : ℤ) ≤ det v z
      · exact ih z hzge h2
      obtain ⟨K, hKdef⟩ : ∃ t : ℤ, m₀ + 1 - (N : ℤ) = t := ⟨_, rfl⟩
      have hzK : det v z = K - 1 := by omega
      by_cases huniq : ExtendsUniquelyBelow ξ S v K x
      · -- §4.2.2: the extension below is unique, so the period simply propagates
        refine downward_step_of_unique hxsft hSmin hSmax ?_ huniq z hzK
        intro zz hzz1 hzz2
        exact ih zz (by omega) (by omega)
      · -- §4.2.1: the extension below is *not* unique
        have huniq' : ∃ g ∈ sftOf ξ S,
            (∀ zz : ℤ × ℤ, K ≤ det v zz → g zz = x zz) ∧
            ∃ zz : ℤ × ℤ, det v zz = K - 1 ∧ g zz ≠ x zz := by
          by_contra hcon
          push_neg at hcon
          exact huniq (fun g hg hga zz hzz => hcon g hg hga zz hzz)
        obtain ⟨g, hgmem, hgagree, z₁, hz₁lev, hz₁ne⟩ := huniq'
        -- 6a.  A disagreement at `t` forces another one within `m` steps, both ways
        have hprop_r : ∀ t : ℤ, g (t • v + z₁) ≠ x (t • v + z₁) →
            ∃ r : ℤ, 1 ≤ r ∧ r ≤ m ∧ g ((t + r) • v + z₁) ≠ x ((t + r) • v + z₁) := by
          intro t ht
          by_contra hcon
          push_neg at hcon
          apply ht
          have hagr : ∀ s ∈ S.erase a,
              g ((t • v + z₁) - a + s) = x ((t • v + z₁) - a + s) := by
            intro s hs
            obtain ⟨hsa, hsS⟩ := Finset.mem_erase.mp hs
            rcases eq_or_lt_of_le (hmin s hsS) with hsc | hsc
            · obtain ⟨r', hr'0, hr'm, rfl⟩ := hface s hsS hsc.symm
              have hr'1 : 1 ≤ r' := by
                rcases eq_or_lt_of_le hr'0 with he | he
                · exact absurd (by rw [← he, zero_smul, zero_add]) hsa
                · omega
              have he : (t • v + z₁) - a + (r' • v + a) = (t + r') • v + z₁ := by
                simp only [add_smul]; abel
              rw [he]
              exact hcon r' hr'1 hr'm
            · refine hgagree _ ?_
              have hlev : det v ((t • v + z₁) - a + s) = det v z₁ - det v a + det v s := by
                rw [hdetadd, hdetsub, hdetrun]
              have hsa' : m₀ + 1 ≤ det v s := by
                have := (hlt_iff s m₀).mp (by rw [← hc]; exact hsc)
                omega
              rw [hlev, hz₁lev, hdeta]
              omega
          have hg2 := sft_eq_of_generatesAt hξ haS hPa hgmem hxsft ((t • v + z₁) - a) hagr
          rwa [show (t • v + z₁) - a + a = t • v + z₁ by abel] at hg2
        have hprop_l : ∀ t : ℤ, g (t • v + z₁) ≠ x (t • v + z₁) →
            ∃ r : ℤ, 1 ≤ r ∧ r ≤ m ∧ g ((t - r) • v + z₁) ≠ x ((t - r) • v + z₁) := by
          intro t ht
          by_contra hcon
          push_neg at hcon
          apply ht
          have hagr : ∀ s ∈ S.erase (m • v + a),
              g ((t • v + z₁) - (m • v + a) + s) = x ((t • v + z₁) - (m • v + a) + s) := by
            intro s hs
            obtain ⟨hsa, hsS⟩ := Finset.mem_erase.mp hs
            rcases eq_or_lt_of_le (hmin s hsS) with hsc | hsc
            · obtain ⟨r', hr'0, hr'm, rfl⟩ := hface s hsS hsc.symm
              have hr'lt : r' < m := by
                rcases eq_or_lt_of_le hr'm with he | he
                · exact absurd (by rw [he]) hsa
                · exact he
              have he2 : (t • v + z₁) - (m • v + a) + (r' • v + a)
                  = (t - (m - r')) • v + z₁ := by
                simp only [sub_smul, add_smul]; abel
              rw [he2]
              exact hcon (m - r') (by omega) (by omega)
            · refine hgagree _ ?_
              have hlev : det v ((t • v + z₁) - (m • v + a) + s)
                  = det v z₁ - det v (m • v + a) + det v s := by
                simp only [det, Prod.fst_add, Prod.snd_add, Prod.fst_sub, Prod.snd_sub,
                  Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
                ring
              have hsa' : m₀ + 1 ≤ det v s := by
                have := (hlt_iff s m₀).mp (by rw [← hc]; exact hsc)
                omega
              rw [hlev, hz₁lev, hdetb]
              omega
          have hg2 := sft_eq_of_generatesAt hξ hbS hPb hgmem hxsft
            ((t • v + z₁) - (m • v + a)) hagr
          rwa [show (t • v + z₁) - (m • v + a) + (m • v + a) = t • v + z₁ by abel] at hg2
        have hdis0 : g ((0 : ℤ) • v + z₁) ≠ x ((0 : ℤ) • v + z₁) := by
          rw [zero_smul, zero_add]; exact hz₁ne
        have hR : ∀ n : ℕ, ∃ j : ℤ, (n : ℤ) ≤ j ∧ j ≤ (n : ℤ) + m ∧
            g (j • v + z₁) ≠ x (j • v + z₁) := by
          intro n
          induction n with
          | zero => exact ⟨0, by omega, by omega, hdis0⟩
          | succ n ihn =>
            obtain ⟨j, hj1, hj2, hj3⟩ := ihn
            rcases eq_or_lt_of_le hj1 with he | he
            · obtain ⟨r, hr1, hrm, hr3⟩ := hprop_r j hj3
              exact ⟨j + r, by omega, by omega, hr3⟩
            · exact ⟨j, by omega, by omega, hj3⟩
        have hL : ∀ n : ℕ, ∃ j : ℤ, -(n : ℤ) - m ≤ j ∧ j ≤ -(n : ℤ) ∧
            g (j • v + z₁) ≠ x (j • v + z₁) := by
          intro n
          induction n with
          | zero => exact ⟨0, by omega, by omega, hdis0⟩
          | succ n ihn =>
            obtain ⟨j, hj1, hj2, hj3⟩ := ihn
            rcases eq_or_lt_of_le hj2 with he | he
            · obtain ⟨r, hr1, hrm, hr3⟩ := hprop_l j hj3
