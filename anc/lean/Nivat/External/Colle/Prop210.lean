          have hcardt : hPfin.toFinset.card = P ξ S := by
            rw [show P ξ S = (patterns ξ S).ncard from rfl,
              Set.ncard_eq_toFinset_card _ hPfin]
          have hlt : hPfin.toFinset.card < (Finset.range (P ξ S + 1)).card := by
            rw [hcardt, Finset.card_range]; omega
          obtain ⟨i, hi, j, hj, hne, heq⟩ :=
            Finset.exists_ne_map_eq_of_card_lt_of_maps_to hlt
