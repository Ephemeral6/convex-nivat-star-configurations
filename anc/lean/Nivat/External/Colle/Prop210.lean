        have hdd0 : 0 < dd := by omega
        have hddb : dd ≤ P ξ S := by omega
        have hjeq : (j : ℤ) = (i : ℤ) + (dd : ℤ) := by omega
        have hwin : ∀ s ∈ S, xK ((i : ℤ) • v + s) = xK ((j : ℤ) • v + s) := by
          intro s hs
          exact congrFun heqp ⟨s, hs⟩
        -- 6f.  The window agreement feeds the determinacy, giving a `dd • v` period on the strip
        have hrows : ∀ t : ℤ, ∀ b ∈ B,
            xK (((i : ℤ) + t) • v + b) = xK (((j : ℤ) + t) • v + b) := by
          refine hdetm (i : ℤ) (j : ℤ) ?_
          intro l hl b hb
          have hmem : (l : ℤ) • v + b ∈ S.filter (fun z => c < inner2 w z) :=
