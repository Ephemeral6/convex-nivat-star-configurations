        -- 6e.  Pigeonhole: two `v`-translates of `xK` carry the same `S`-pattern
        have hPfin : (patterns ξ S).Finite := patterns_finite_of_range_finite hξ S
        obtain ⟨i, j, hij, hjb, heqp⟩ : ∃ i j : ℕ, i < j ∧ j ≤ P ξ S ∧
