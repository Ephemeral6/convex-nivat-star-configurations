        have hxKsft : xK ∈ sftOf ξ S := orbitClosure_subset_sftOf ξ S hxKmem
        -- 6c.  Every `v`-row of `xK` over `Q` extends ambiguously
        have hamb : AmbiguousAlong ξ (S.filter fun z => c < inner2 w z) S xK v := by
          intro t
          obtain ⟨j, hj1, hj2, hj3⟩ := hDwin t
          obtain ⟨u₁, hu₁⟩ := hxsft ((z₁ - a) + t • v)
          obtain ⟨u₂, hu₂⟩ := hgmem ((z₁ - a) + t • v)
          refine ⟨u₁, u₂, ?_, ?_, ?_⟩
          · rw [hu₁, hu₂]
            intro heq
            apply hj3
            have hmem : (j - t) • v + a ∈ S := hcontig (j - t) (by omega) (by omega)
            have hval : x ((z₁ - a) + t • v + ((j - t) • v + a))
                = g ((z₁ - a) + t • v + ((j - t) • v + a)) :=
              congrFun heq ⟨(j - t) • v + a, hmem⟩
            have he3 : (z₁ - a) + t • v + ((j - t) • v + a) = j • v + z₁ := by
              simp only [sub_smul]; abel
            rw [he3] at hval
            exact hval.symm
