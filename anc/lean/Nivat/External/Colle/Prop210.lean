          have hmemS : (l : ℤ) • v + b ∈ S := (Finset.filter_subset _ _) hmem
          have hh := hwin ((l : ℤ) • v + b) hmemS
          have e1 : ((i : ℤ) + (l : ℤ)) • v + b = (i : ℤ) • v + ((l : ℤ) • v + b) := by
            simp only [add_smul]; abel
          have e2 : ((j : ℤ) + (l : ℤ)) • v + b = (j : ℤ) • v + ((l : ℤ) • v + b) := by
            simp only [add_smul]; abel
          rw [e1, e2]; exact hh
        have hshift : ∀ (s : ℤ), ∀ b ∈ B, xK (s • v + b) = xK ((s + (dd : ℤ)) • v + b) := by
          intro s b hb
          have hh := hrows (s - (i : ℤ)) b hb
          have e1 : (i : ℤ) + (s - (i : ℤ)) = s := by ring
          have e2 : (j : ℤ) + (s - (i : ℤ)) = s + (dd : ℤ) := by omega
          rw [e1, e2] at hh
          exact hh
        have hstripK : ∀ z₀ ∈ S.filter (fun z => c < inner2 w z), ∀ k : ℤ,
            xK (k • v + z₀ + (dd : ℤ) • v) = xK (k • v + z₀) := by
          intro z₀ hz₀ k
          obtain ⟨b, hb, k', rfl⟩ := hcoverB z₀ hz₀
          have h1 := hshift (k + k') b hb
          have e1 : k • v + (k' • v + b) + (dd : ℤ) • v = (k + k' + (dd : ℤ)) • v + b := by
            simp only [add_smul]; abel
          have e2 : k • v + (k' • v + b) = (k + k') • v + b := by
            simp only [add_smul]; abel
          rw [e1, e2]
          exact h1.symm
        have hperK := period_of_strip hgen.2.1 hv hw hwv hfc2 hle hstripK
        have hperKdet : ∀ zz : ℤ × ℤ, m₀ + 1 ≤ det v zz → det v zz ≤ m₁ →
            xK (zz + (dd : ℤ) • v) = xK zz := by
          intro zz h1' h2'
          refine hperK zz ?_ ?_
          · rw [hc]; exact (hlt_iff zz m₀).mpr (by omega)
          · rw [hc']; exact (hle_iff zz m₁).mpr h2'
        -- 6g.  Transport back to `x`, and sweep the level `K - 1`
        obtain ⟨yy', hyy'val⟩ : ∃ f : Config A, ∀ zz : ℤ × ℤ, f zz = x (zz + (dd : ℤ) • v) :=
          ⟨_, fun _ => rfl⟩
        have hyy'sft : yy' ∈ sftOf ξ S := by
          have hh := T_mem_sftOf hxsft ((dd : ℤ) • v)
          rwa [show T ((dd : ℤ) • v) x = yy' from funext fun zz => (hyy'val zz).symm] at hh
        have hknowndet : ∀ zz : ℤ × ℤ, K ≤ det v zz → det v zz ≤ K - 1 + (m₁ - m₀) →
            x zz = yy' zz := by
          intro zz h1' h2'
          have hlev : det v (zz - (z₁ - a)) = det v zz - (K - 1) + m₀ := by
            rw [hdetsub, hdetsub, hz₁lev, hdeta]; ring
          have h3 := hperKdet (zz - (z₁ - a)) (by rw [hlev]; omega) (by rw [hlev]; omega)
          rw [hxKval, hxKval] at h3
          have e1 : (z₁ - a) + (zz - (z₁ - a) + (dd : ℤ) • v) = zz + (dd : ℤ) • v := by abel
          have e2 : (z₁ - a) + (zz - (z₁ - a)) = zz := by abel
          rw [e1, e2] at h3
          rw [hyy'val]
          exact h3.symm
        have hknownR : ∀ zz : ℤ × ℤ, μ * ((K - 1 : ℤ) : ℝ) < inner2 w zz →
            inner2 w zz ≤ μ * ((K - 1 : ℤ) : ℝ) + (c' - c) → x zz = yy' zz := by
          intro zz h1' h2'
          refine hknowndet zz ?_ ?_
          · have := (hlt_iff zz (K - 1)).mp h1'; omega
          · refine (hle_iff zz (K - 1 + (m₁ - m₀))).mp ?_
            have hcc : μ * ((K - 1 : ℤ) : ℝ) + (c' - c)
                = μ * ((K - 1 + (m₁ - m₀) : ℤ) : ℝ) := by
              rw [hc, hc']; push_cast; ring
            rw [← hcc]; exact h2'
        have hpK : inner2 w ((i : ℤ) • v + z₁) = μ * ((K - 1 : ℤ) : ℝ) := by
          refine (heq_iff _ (K - 1)).mpr ?_
          rw [hdetrun]; exact hz₁lev
        have hseedS : ∀ r : ℤ, 0 ≤ r → r ≤ m →
            x (r • v + ((i : ℤ) • v + z₁)) = yy' (r • v + ((i : ℤ) • v + z₁)) := by
          intro r hr0 hrm
          have hmem : r • v + a ∈ S := hcontig r hr0 hrm
          have h1 := hwin (r • v + a) hmem
          rw [hxKval, hxKval] at h1
          have e1 : (z₁ - a) + ((i : ℤ) • v + (r • v + a)) = r • v + ((i : ℤ) • v + z₁) := by
            abel
          have e2 : (z₁ - a) + ((j : ℤ) • v + (r • v + a))
              = r • v + ((i : ℤ) • v + z₁) + (dd : ℤ) • v := by
            rw [hjeq]; simp only [add_smul]; abel
          rw [e1, e2] at h1
          rw [hyy'val]
          exact h1
        have hlevelK : ∀ zz : ℤ × ℤ, inner2 w zz = μ * ((K - 1 : ℤ) : ℝ) → x zz = yy' zz :=
          eq_on_level_of_face_seed hξ hgen hv hw hwv hmin hmax haS hac hamin hm0 hbS hbmax
            hxsft hyy'sft hknownR hpK hseedS
        have hddper : ∀ zz : ℤ × ℤ, K - 1 ≤ det v zz → det v zz ≤ K - 1 →
            x (zz + (dd : ℤ) • v) = x zz := by
          intro zz h1' h2'
          have hh := hlevelK zz ((heq_iff zz (K - 1)).mpr (by omega))
          rw [hyy'val] at hh
          exact hh.symm
        -- 6h.  Upgrade the period `dd • v` to the uniform period `u'`
        have hdvd : (dd : ℤ) ∣ Mval := by
          rw [← hMdef]
          exact Dvd.dvd.mul_left
            (Int.natCast_dvd_natCast.mpr (Nat.dvd_factorial hdd0 hddb)) _
        obtain ⟨ee, hee⟩ := hdvd
        have hu'alt2 : Mval • v = ee • ((dd : ℤ) • v) := by
          rw [smul_smul, hee, mul_comm]
        rw [hu'alt2]
        exact zsmul_period_on_levels (hdetv (dd : ℤ)) hddper ee z (by omega) (by omega)
  intro z hz
  have hzm₀ : det v z ≤ m₀ := (hle_iff z m₀).mp (by rw [← hc]; exact hz)
  exact hmain (m₀ + 1 - det v z).toNat z (by omega) (by omega)

/-- **Cyr-Kra Proposition 4.8, downward step** (arXiv:1208.4090, §4.2.1-§4.2.3).
Given periodicity on a strip above level `c`, extend it down to the half-plane
below level `c`.  This is the content of the "does not extend uniquely" case
(§4.2.1) plus the "does extend uniquely" case (§4.2.2), packaged as an implication.

The hypothesis `hstrip` is the output of `exists_strip_period_of_ambiguousAlong`
(Cyr-Kra Lemma 2.24, proved above).  The conclusion is half-plane periodicity,
which is the goal of Proposition 2.10.

**Source**: Cyr-Kra, *Nonexpansive ℤ²-subdynamics and Nivat's conjecture*,
arXiv:1208.4090, Proposition 4.8 "Periodicity of `f|_{B_K}` for `K < 0`".

**2026-09-13:** converted from `axiom` to `theorem ... := by sorry`, per the
project's anti-cheat clause -- a bespoke `axiom` is invisible to the kernel audit
in `scripts/audit_axioms_raw.lean`, whereas `sorryAx` is not.  An adversarial
audit rated this statement PLAUSIBLE (no counterexample found, no quantifier
defect of the kind that made the Lemma45 and KMLemma16 axioms outright
inconsistent), but that is weak evidence, not a proof.  The audit suggested the
likeliest point of failure is whether `hcount` and `hle` together really support
the pigeonhole count of §4.2.1.

**2026-09-14: proved**, signature unchanged, no `sorry` and no new `axiom`;
`#print axioms` gives `[propext, Classical.choice, Quot.sound]`.  The proof is
`cyrKra_downward_induction_pos` above plus the `±v` orientation normalisation.
It does **not** follow the source at §4.2.1: Cyr-Kra Corollary 2.25 is replaced
by a bounded *determinacy window* (`exists_row_determinacy_of_ambiguousAlong`)
together with an independent pigeonhole over `𝒮`-patterns, and the per-level
shifts are uniformised by `M = |q| · (P η(𝒮))!` rather than by Cyr-Kra's
`(2|w ∩ 𝒮| - 2)!`.  Consequently the audit's suspicion about the §4.2.1 count is
moot: that count is never performed.  `hcount` and `hh : 0 < h` are consumed by
the determinacy lemma, `hle` by the height lemma.  The `c = c'` case needs no
separate treatment.  See the notes above.

This closes a `sorry`; it does **not** shrink the project's axiom closure.
Neither `Nivat.colle_doublyPeriodic` nor `Nivat.colle_region` depends on this
theorem or on `colle_prop_2_10`. -/
theorem cyrKra_downward_induction {A : Type*} {ξ x : Config A}
    (hξ : (Set.range ξ).Finite) (hx : x ∈ orbitClosure ξ)
    {S : Finset (ℤ × ℤ)} (hgen : IsGeneratingSet ξ S)
    {v : ℤ × ℤ} (hv : Primitive v) {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0)
    {c c' : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z) (hmax : ∀ z ∈ S, inner2 w z ≤ c')
    (hfc : (S.filter fun z => inner2 w z = c).Nonempty)
    (hle : (S.filter fun z => inner2 w z = c).card ≤
      (S.filter fun z => inner2 w z = c').card)
    (hcount : P ξ S - P ξ (S.filter fun z => c < inner2 w z) ≤
      (S.filter fun z => inner2 w z = c).card - 1)
    (honed : ∃ y ∈ orbitClosure ξ, ∃ y' ∈ orbitClosure ξ, y ≠ y' ∧
        ∀ z : ℤ × ℤ, 0 ≤ inner2 w z → y z = y' z)
    {u : ℤ × ℤ} (hstrip : u ≠ 0 ∧ inner2 w u = 0 ∧
      ∀ z₀ ∈ S.filter (fun z => c < inner2 w z), ∀ k : ℤ,
        x (k • v + z₀ + u) = x (k • v + z₀)) :
    ∃ u' : ℤ × ℤ, u' ≠ 0 ∧ inner2 w u' = 0 ∧
      ∀ z : ℤ × ℤ, inner2 w z ≤ c → x (z + u') = x z := by
  -- Normalise the orientation: `inner2 w ·` and `det v ·` differ by a non-zero
  -- real factor `μ` (`exists_ratio_of_inner2_eq_zero`).  If `μ > 0` apply the
  -- core directly; otherwise replace `v` by `-v`, which flips the sign of
  -- `det v ·` and leaves every hypothesis of the core invariant.
  obtain ⟨hu0, huw, hupers⟩ := hstrip
  obtain ⟨μ, hμ, hμz⟩ := exists_ratio_of_inner2_eq_zero hv.ne_zero hw hwv
  rcases lt_or_gt_of_ne hμ with hneg | hpos
  · have hvneg : Primitive (-v) := by
      obtain ⟨p, q, hpq⟩ := hv
      exact ⟨-p, -q, by simp only [Prod.fst_neg, Prod.snd_neg]; linear_combination hpq⟩
    have hwvneg : inner2 w (-v) = 0 := by
      have hh : inner2 w (-v) = -(inner2 w v) := by
        simp only [inner2, Prod.fst_neg, Prod.snd_neg, Int.cast_neg]; ring
      rw [hh, hwv, neg_zero]
    have hdetneg : ∀ z : ℤ × ℤ, det (-v) z = -(det v z) := by
      intro z; simp only [det, Prod.fst_neg, Prod.snd_neg]; ring
    have hμz' : ∀ z : ℤ × ℤ, inner2 w z = (-μ) * ((det (-v) z : ℤ) : ℝ) := by
      intro z; rw [hμz z, hdetneg z]; push_cast; ring
    have hupers' : ∀ z₀ ∈ S.filter (fun z => c < inner2 w z), ∀ k : ℤ,
        x (k • (-v) + z₀ + u) = x (k • (-v) + z₀) := by
      intro z₀ hz₀ k
      have hh := hupers z₀ hz₀ (-k)
      rwa [show (-k) • v = k • (-v) by rw [smul_neg, neg_smul]] at hh
    exact cyrKra_downward_induction_pos hξ hx hgen hvneg hw hwvneg
      (by linarith) hμz' hmin hmax hfc hle hcount honed hu0 huw hupers'
  · exact cyrKra_downward_induction_pos hξ hx hgen hv hw hwv hpos hμz
      hmin hmax hfc hle hcount honed hu0 huw hupers

/-! ## Collé `b3_colle2.txt:355`: existence of `(ℓ,𝒮)`-ambiguous configurations

"It is not difficult to see that there always exist `(ℓ,𝒮)`-ambiguous configurations in
`X_η` if `ℓ ∈ nexpd(η)` and `𝒮 ⊂ ℤ²` is an `η`-generating set."

No compactness is needed.  Take `y ≠ y'` in `X_η` agreeing on the closed half plane
`{0 ≤ inner2 w ·}`, let `K < 0` be the top `det v`-level on which they disagree, and let
`a, a + v, …, a + m • v` be the `inner2 w`-minimal face of `S`.  Both endpoints are
`η`-generated (`generatesAt_of_min_on_face`, `generatesAt_of_max_on_face`), so a disagreement
of `y, y'` at `t • v + z₁` on level `K` forces one at `(t + r) • v + z₁` for some `1 ≤ r ≤ m`,
and symmetrically at `(t - r) • v + z₁`.  Hence every window of `m + 1` consecutive sites of
level `K` carries a disagreement, and the translate of `y` placing `a` at `z₁` is ambiguous at
every `t`, with the two extensions read off `y` and `y'`.  (`m = 0` is not excluded by the
hypotheses; then the window has one site and the forcing step is vacuous — Lemma 2.3.)
-/

/-- **Positively oriented core.**  Given a one-sided nonexpansive pair `y ≠ y'` agreeing on
`{0 ≤ inner2 w ·}`, the translates of `y` **and of `y'`** that put the `dotZ`-minimal face
endpoint `a` on the top disagreement level are both `(ℓ,𝒮)`-ambiguous along `v`; they
disagree at `a` itself (a point of the face line `{inner2 w · = c}`) and agree strictly above
it.

The conclusion was widened on 2026-09-19 (lane Amink) from "`x` ambiguous, some partner `x'`
differing somewhere and agreeing on some half plane" to the four conjuncts below.  Nothing in
the proof changed: the partner was already `T (z₁ - a) y'`, its ambiguity is the same
`hDwin` argument read off `y'` instead of `y`, and the disagreement at `a` is `hz₁ne`
(`a + (z₁ - a) = z₁`).  See `exists_ambiguousPair_of_oneSidedNonexpansive` for why the
extra conjuncts are needed. -/
private theorem exists_ambiguousAlong_pos {ξ : Config A}
    {S : Finset (ℤ × ℤ)} (hgen : IsGeneratingSet ξ S)
    {v : ℤ × ℤ} (hv : Primitive v) {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0)
    {μ : ℝ} (hμpos : 0 < μ)
    (hμz : ∀ z : ℤ × ℤ, inner2 w z = μ * ((det v z : ℤ) : ℝ))
    {c : ℝ} (hmin : ∀ z ∈ S, c ≤ inner2 w z)
    (hfc : (S.filter fun z => inner2 w z = c).Nonempty)
    {y y' : Config A} (hy : y ∈ orbitClosure ξ) (hy' : y' ∈ orbitClosure ξ)
    (hne : y ≠ y') (hagree0 : ∀ z : ℤ × ℤ, 0 ≤ inner2 w z → y z = y' z) :
    ∃ x ∈ orbitClosure ξ, ∃ x' ∈ orbitClosure ξ,
      AmbiguousAlong ξ (S.filter fun z => c < inner2 w z) S x v ∧
      AmbiguousAlong ξ (S.filter fun z => c < inner2 w z) S x' v ∧
      (∃ g ∈ S, inner2 w g = c ∧ x g ≠ x' g) ∧
      ∀ z : ℤ × ℤ, c < inner2 w z → x z = x' z := by
  classical
  -- ### 0. dictionary between `inner2 w` and `det v`
  have hge_iff : ∀ (z : ℤ × ℤ) (n : ℤ), μ * (n : ℝ) ≤ inner2 w z ↔ n ≤ det v z := by
    intro z n
    rw [hμz z]
    constructor
    · intro hh; exact_mod_cast le_of_mul_le_mul_left hh hμpos
    · intro hh; exact mul_le_mul_of_nonneg_left (by exact_mod_cast hh) hμpos.le
  have hlt_iff : ∀ (z : ℤ × ℤ) (n : ℤ), μ * (n : ℝ) < inner2 w z ↔ n < det v z := by
    intro z n
    rw [hμz z]
    constructor
    · intro hh; exact_mod_cast lt_of_mul_lt_mul_left hh hμpos.le
    · intro hh
      have hcast : ((n : ℤ) : ℝ) < ((det v z : ℤ) : ℝ) := by exact_mod_cast hh
      nlinarith
  have heq_iff : ∀ (z : ℤ × ℤ) (n : ℤ), inner2 w z = μ * (n : ℝ) ↔ det v z = n := by
    intro z n
    rw [hμz z]
    constructor
    · intro hh; exact_mod_cast mul_left_cancel₀ (ne_of_gt hμpos) hh
    · intro hh; rw [hh]
  have hdetadd : ∀ p q : ℤ × ℤ, det v (p + q) = det v p + det v q := by
    intro p q; simp only [det, Prod.fst_add, Prod.snd_add]; ring
  have hdetsub : ∀ p q : ℤ × ℤ, det v (p - q) = det v p - det v q := by
    intro p q; simp only [det, Prod.fst_sub, Prod.snd_sub]; ring
  have hdetrun : ∀ (r : ℤ) (z : ℤ × ℤ), det v (r • v + z) = det v z := by
    intro r z
    simp only [det, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    ring
  have hdetv : ∀ r : ℤ, det v (r • v) = 0 := by
    intro r
    simp only [det, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]; ring
  have hepos : 0 < dotZ v v := by
    have hv0 : v ≠ 0 := hv.ne_zero
    have hor : v.1 ≠ 0 ∨ v.2 ≠ 0 := by
      rcases eq_or_ne v.1 0 with h1 | h1
      · rcases eq_or_ne v.2 0 with h2 | h2
        · exact absurd (Prod.ext h1 h2) hv0
        · exact Or.inr h2
      · exact Or.inl h1
    simp only [dotZ]
    rcases hor with h1 | h1
    · nlinarith [sq_nonneg v.1, sq_nonneg v.2, mul_self_pos.mpr h1]
    · nlinarith [sq_nonneg v.1, sq_nonneg v.2, mul_self_pos.mpr h1]
  have hsmulZ : ∀ (r : ℤ) (z : ℤ × ℤ), dotZ (r • v + z) v = r * dotZ v v + dotZ z v := by
    intro r z
    simp only [dotZ, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
    ring
  have hagreeD : ∀ z : ℤ × ℤ, 0 ≤ det v z → y z = y' z := by
    intro z hz
    apply hagree0
    have := (hge_iff z 0).mpr hz
    rwa [Int.cast_zero, mul_zero] at this
  -- ### 1. the face `{z ∈ S | inner2 w z = c}` is the run `{r • v + a : 0 ≤ r ≤ m}`
  obtain ⟨zc, hzcmem⟩ := hfc
  obtain ⟨hzcS, hzcc⟩ := Finset.mem_filter.mp hzcmem
  obtain ⟨m₀, hm₀⟩ : ∃ n : ℤ, det v zc = n := ⟨_, rfl⟩
  have hc : c = μ * (m₀ : ℝ) := by rw [← hzcc, hμz zc, hm₀]
  have hQlev : ∀ s ∈ S.filter (fun z => c < inner2 w z), m₀ + 1 ≤ det v s := by
    intro s hs
    obtain ⟨hsS, hsc⟩ := Finset.mem_filter.mp hs
    have := (hlt_iff s m₀).mp (by rw [← hc]; exact hsc)
    omega
  obtain ⟨a, haF, haminF⟩ :=
    (S.filter fun z => inner2 w z = c).exists_min_image (fun z => dotZ z v) ⟨zc, hzcmem⟩
  obtain ⟨bb, hbF, hbmaxF⟩ :=
    (S.filter fun z => inner2 w z = c).exists_max_image (fun z => dotZ z v) ⟨zc, hzcmem⟩
  obtain ⟨haS, hac⟩ := Finset.mem_filter.mp haF
  obtain ⟨hbS0, hbc0⟩ := Finset.mem_filter.mp hbF
  have hamin : ∀ z ∈ S, inner2 w z = c → dotZ a v ≤ dotZ z v :=
    fun z hz hzc => haminF z (Finset.mem_filter.mpr ⟨hz, hzc⟩)
  have hbmax0 : ∀ z ∈ S, inner2 w z = c → dotZ z v ≤ dotZ bb v :=
    fun z hz hzc => hbmaxF z (Finset.mem_filter.mpr ⟨hz, hzc⟩)
  have hzeroab : inner2 w (bb - a) = 0 := by rw [inner2_sub_pair, hbc0, hac, sub_self]
  obtain ⟨m, hmeq⟩ :=
    Nivat.eq_zsmul_of_det_eq_zero hv (det_eq_zero_of_inner2_eq_zero hw hwv hzeroab)
  have hbeq : bb = m • v + a := by rw [← hmeq]; abel
  have hm0 : 0 ≤ m := by
    have h1 := hamin bb hbS0 hbc0
    rw [hbeq, hsmulZ] at h1
    nlinarith
  have hbS : m • v + a ∈ S := by rw [← hbeq]; exact hbS0
  have hbc : inner2 w (m • v + a) = c := by rw [← hbeq]; exact hbc0
  have hbmax : ∀ z ∈ S, inner2 w z = c → dotZ z v ≤ dotZ (m • v + a) v := by
    intro z hz hzc; rw [← hbeq]; exact hbmax0 z hz hzc
  have hcontig : ∀ r : ℤ, 0 ≤ r → r ≤ m → r • v + a ∈ S :=
    fun r h1 h2 => mem_face_run hgen.2.1 hv haS hbS h1 h2
  have hface : ∀ s ∈ S, inner2 w s = c → ∃ r : ℤ, 0 ≤ r ∧ r ≤ m ∧ s = r • v + a := by
    intro s hs hsc
    have hzero : inner2 w (s - a) = 0 := by rw [inner2_sub_pair, hsc, hac, sub_self]
    obtain ⟨r, hr⟩ :=
      Nivat.eq_zsmul_of_det_eq_zero hv (det_eq_zero_of_inner2_eq_zero hw hwv hzero)
    have hs_eq : s = r • v + a := by rw [← hr]; abel
    refine ⟨r, ?_, ?_, hs_eq⟩
    · have h1 := hamin s hs hsc
      rw [hs_eq, hsmulZ] at h1
      nlinarith
    · have h2 := hbmax s hs hsc
      rw [hs_eq, hsmulZ, hsmulZ] at h2
      nlinarith
  have hdeta : det v a = m₀ := (heq_iff a m₀).mp (by rw [hac]; exact hc)
  have hdetb : det v (m • v + a) = m₀ := by rw [hdetrun, hdeta]
  -- ### 2. both endpoints of the face are `η`-generated (Cyr-Kra Def. 4.5(ii), proved)
  have hgenA : GeneratesAt ξ S a :=
    generatesAt_of_min_on_face hgen hv hw hwv hmin haS hac hamin
  have hgenB : GeneratesAt ξ S (m • v + a) :=
    generatesAt_of_max_on_face hgen hv hw hwv hmin hbS hbc hbmax
  -- ### 3. the top disagreement level `K` of `y, y'`
  obtain ⟨z₀, hz₀⟩ : ∃ z, y z ≠ y' z := by
    by_contra hcon
    push_neg at hcon
    exact hne (funext hcon)
  have hz₀neg : det v z₀ < 0 := by
    by_contra hcon
    push_neg at hcon
    exact hz₀ (hagreeD z₀ hcon)
  have hex : ∃ n : ℕ, ∃ z : ℤ × ℤ, y z ≠ y' z ∧ det v z = -((n : ℤ) + 1) := by
    obtain ⟨n, hn⟩ := Int.eq_ofNat_of_zero_le (show 0 ≤ -(det v z₀) - 1 by omega)
    exact ⟨n, z₀, hz₀, by omega⟩
  obtain ⟨z₁, hz₁ne, hz₁lev⟩ := Nat.find_spec hex
  obtain ⟨K, hK⟩ : ∃ K : ℤ, K = -((Nat.find hex : ℤ) + 1) := ⟨_, rfl⟩
  rw [← hK] at hz₁lev
  have hagree : ∀ z : ℤ × ℤ, K < det v z → y z = y' z := by
    intro z hz
    by_contra hcon
    rcases le_or_gt 0 (det v z) with h0 | h0
    · exact hcon (hagreeD z h0)
    · obtain ⟨n, hn⟩ := Int.eq_ofNat_of_zero_le (show 0 ≤ -(det v z) - 1 by omega)
      have hlt : n < Nat.find hex := by omega
      exact Nat.find_min hex hlt ⟨z, hcon, by omega⟩
  -- ### 4. a disagreement at `t` forces another within `m` steps, in both directions
  have hprop_r : ∀ t : ℤ, y (t • v + z₁) ≠ y' (t • v + z₁) →
      ∃ r : ℤ, 1 ≤ r ∧ r ≤ m ∧ y ((t + r) • v + z₁) ≠ y' ((t + r) • v + z₁) := by
    intro t ht
    by_contra hcon
    push_neg at hcon
    apply ht
    have hTy : T (t • v + z₁ - a) y ∈ orbitClosure ξ := T_mem_of_mem_orbitClosure hy _
    have hTy' : T (t • v + z₁ - a) y' ∈ orbitClosure ξ := T_mem_of_mem_orbitClosure hy' _
    have hagr : ∀ s ∈ S.erase a,
        T (t • v + z₁ - a) y s = T (t • v + z₁ - a) y' s := by
      intro s hs
      obtain ⟨hsa, hsS⟩ := Finset.mem_erase.mp hs
      simp only [T_apply]
      rcases eq_or_lt_of_le (hmin s hsS) with hsc | hsc
      · obtain ⟨r', hr'0, hr'm, rfl⟩ := hface s hsS hsc.symm
        have hr'1 : 1 ≤ r' := by
          rcases eq_or_lt_of_le hr'0 with he | he
          · exact absurd (by rw [← he, zero_smul, zero_add]) hsa
          · omega
        have he : r' • v + a + (t • v + z₁ - a) = (t + r') • v + z₁ := by
          simp only [add_smul]; abel
        rw [he]
        exact hcon r' hr'1 hr'm
      · apply hagree
        have hlev : det v (s + (t • v + z₁ - a)) = det v s + det v z₁ - det v a := by
          rw [hdetadd, hdetsub, hdetrun]; ring
        have hsa' : m₀ + 1 ≤ det v s := by
          have := (hlt_iff s m₀).mp (by rw [← hc]; exact hsc)
          omega
        rw [hlev, hz₁lev, hdeta]
        omega
    have h2 := hgenA.2 _ hTy _ hTy' hagr
    simp only [T_apply] at h2
    rwa [show a + (t • v + z₁ - a) = t • v + z₁ by abel] at h2
  have hprop_l : ∀ t : ℤ, y (t • v + z₁) ≠ y' (t • v + z₁) →
      ∃ r : ℤ, 1 ≤ r ∧ r ≤ m ∧ y ((t - r) • v + z₁) ≠ y' ((t - r) • v + z₁) := by
    intro t ht
    by_contra hcon
    push_neg at hcon
    apply ht
    have hTy : T (t • v + z₁ - (m • v + a)) y ∈ orbitClosure ξ :=
      T_mem_of_mem_orbitClosure hy _
    have hTy' : T (t • v + z₁ - (m • v + a)) y' ∈ orbitClosure ξ :=
      T_mem_of_mem_orbitClosure hy' _
    have hagr : ∀ s ∈ S.erase (m • v + a),
        T (t • v + z₁ - (m • v + a)) y s = T (t • v + z₁ - (m • v + a)) y' s := by
      intro s hs
      obtain ⟨hsa, hsS⟩ := Finset.mem_erase.mp hs
      simp only [T_apply]
      rcases eq_or_lt_of_le (hmin s hsS) with hsc | hsc
      · obtain ⟨r', hr'0, hr'm, rfl⟩ := hface s hsS hsc.symm
        have hr'lt : r' < m := by
          rcases eq_or_lt_of_le hr'm with he | he
          · exact absurd (by rw [he]) hsa
          · exact he
        have he2 : r' • v + a + (t • v + z₁ - (m • v + a)) = (t - (m - r')) • v + z₁ := by
          simp only [sub_smul]; abel
        rw [he2]
        exact hcon (m - r') (by omega) (by omega)
      · apply hagree
        have hlev : det v (s + (t • v + z₁ - (m • v + a)))
            = det v s + det v z₁ - det v (m • v + a) := by
          rw [hdetadd, hdetsub, hdetrun]; ring
        have hsa' : m₀ + 1 ≤ det v s := by
          have := (hlt_iff s m₀).mp (by rw [← hc]; exact hsc)
          omega
        rw [hlev, hz₁lev, hdetb]
        omega
    have h2 := hgenB.2 _ hTy _ hTy' hagr
    simp only [T_apply] at h2
    rwa [show m • v + a + (t • v + z₁ - (m • v + a)) = t • v + z₁ by abel] at h2
  -- ### 5. hence every window of `m + 1` consecutive points on level `K` meets a disagreement
  have hdis0 : y ((0 : ℤ) • v + z₁) ≠ y' ((0 : ℤ) • v + z₁) := by
    rw [zero_smul, zero_add]; exact hz₁ne
  have hR : ∀ n : ℕ, ∃ j : ℤ, (n : ℤ) ≤ j ∧ j ≤ (n : ℤ) + m ∧
      y (j • v + z₁) ≠ y' (j • v + z₁) := by
    intro n
    induction n with
    | zero => exact ⟨0, by omega, by omega, hdis0⟩
    | succ n ihn =>
      obtain ⟨j, hj1, hj2, hj3⟩ := ihn
      rcases eq_or_lt_of_le hj1 with he | he
      · obtain ⟨r, hr1, hrm, hr3⟩ := hprop_r j hj3
        exact ⟨j + r, by omega, by omega, hr3⟩
      · exact ⟨j, by omega, by omega, hj3⟩
  have hL : ∀ n : ℕ, ∃ j : ℤ, -(n : ℤ) - m ≤ j ∧ j ≤ -(n : ℤ) ∧
      y (j • v + z₁) ≠ y' (j • v + z₁) := by
    intro n
    induction n with
    | zero => exact ⟨0, by omega, by omega, hdis0⟩
    | succ n ihn =>
      obtain ⟨j, hj1, hj2, hj3⟩ := ihn
      rcases eq_or_lt_of_le hj2 with he | he
      · obtain ⟨r, hr1, hrm, hr3⟩ := hprop_l j hj3
        exact ⟨j - r, by omega, by omega, hr3⟩
      · exact ⟨j, by omega, by omega, hj3⟩
  have hDwin : ∀ t : ℤ, ∃ j : ℤ, t ≤ j ∧ j ≤ t + m ∧ y (j • v + z₁) ≠ y' (j • v + z₁) := by
    intro t
    by_cases ht : 0 ≤ t
    · obtain ⟨j, hj1, hj2, hj3⟩ := hR t.toNat
      exact ⟨j, by omega, by omega, hj3⟩
    by_cases ht2 : 0 ≤ t + m
    · exact ⟨0, by omega, by omega, hdis0⟩
    obtain ⟨j, hj1, hj2, hj3⟩ := hL (-(t + m)).toNat
    exact ⟨j, by omega, by omega, hj3⟩
  -- ### 6. the translates putting `a` on `z₁` — both members of the pair
  -- `x := T (z₁ - a) y` and `x' := T (z₁ - a) y'` are Collé's `x_per, y_per` of
  -- `b3_colle2.txt:774`, the two members of the `ℓ`-non-expansiveness witness translated
  -- together.  Three facts about the pair, all read off what is already on the table:
  -- (a) they agree strictly above the face level `c` (`hagree`, since the translation puts
  --     level `K` of `y, y'` on level `m₀` of the face);
  -- (b) they disagree at `a` (`hz₁ne`, since `a + (z₁ - a) = z₁`);
  -- (c) each is ambiguous at every `t`, with the *same* witnesses `u₁, u₂`: the `Q`-patterns of
  --     `x` and `x'` at every translate coincide by (a), because `Q` sits strictly above `c`.
  have hagree_above : ∀ z : ℤ × ℤ, c < inner2 w z → T (z₁ - a) y z = T (z₁ - a) y' z := by
    intro z hz
    simp only [T_apply]
    apply hagree
    have hlev : det v (z + (z₁ - a)) = det v z + K - m₀ := by
      rw [hdetadd, hdetsub, hz₁lev, hdeta]; ring
    rw [hlev]
    have := (hlt_iff z m₀).mp (by rw [← hc]; exact hz)
    omega
  -- the same, at every `v`-translate (the level is `v`-invariant)
  have hagree_shift : ∀ (t : ℤ) (q : ℤ × ℤ), c < inner2 w q →
      T (z₁ - a) y (t • v + q) = T (z₁ - a) y' (t • v + q) := by
    intro t q hq
    simp only [T_apply]
    apply hagree
    have hlev : det v (t • v + q + (z₁ - a)) = det v q + K - m₀ := by
      rw [hdetadd, hdetrun, hdetsub, hz₁lev, hdeta]; ring
    rw [hlev]
    have := (hlt_iff q m₀).mp (by rw [← hc]; exact hq)
    omega
  -- the common witnesses, with the second pattern read off `y'` and the first off `y`
  have hwit : ∀ t : ℤ, ∃ u₁ u₂ : ℤ × ℤ, pattern ξ S u₁ ≠ pattern ξ S u₂ ∧
      (∀ q ∈ S.filter (fun z => c < inner2 w z), ξ (u₁ + q) = T (z₁ - a) y (t • v + q)) ∧
      (∀ q ∈ S.filter (fun z => c < inner2 w z), ξ (u₂ + q) = T (z₁ - a) y' (t • v + q)) := by
    intro t
    obtain ⟨j, hj1, hj2, hj3⟩ := hDwin t
    obtain ⟨u₁, hu₁⟩ := T_mem_of_mem_orbitClosure hy ((z₁ - a) + t • v) S
    obtain ⟨u₂, hu₂⟩ := T_mem_of_mem_orbitClosure hy' ((z₁ - a) + t • v) S
    refine ⟨u₁, u₂, ?_, ?_, ?_⟩
    · intro heq
      apply hj3
      have hmem : (j - t) • v + a ∈ S := hcontig (j - t) (by omega) (by omega)
      have h1 := hu₁ _ hmem
      have h2 := hu₂ _ hmem
      have h3 : ξ (u₁ + ((j - t) • v + a)) = ξ (u₂ + ((j - t) • v + a)) :=
        congrFun heq ⟨_, hmem⟩
      simp only [T_apply] at h1 h2
      have he : (j - t) • v + a + ((z₁ - a) + t • v) = j • v + z₁ := by
        simp only [sub_smul]; abel
      rw [he] at h1 h2
      rw [h1, h2, h3]
    · intro q hq
      have hqS : q ∈ S := (Finset.filter_subset _ _) hq
      have h1 := hu₁ q hqS
      simp only [T_apply] at h1 ⊢
      rw [← h1]
      congr 1
      abel
    · intro q hq
      have hqS : q ∈ S := (Finset.filter_subset _ _) hq
      have h2 := hu₂ q hqS
      simp only [T_apply] at h2 ⊢
      rw [← h2]
      congr 1
      abel
  refine ⟨T (z₁ - a) y, T_mem_of_mem_orbitClosure hy _,
    T (z₁ - a) y', T_mem_of_mem_orbitClosure hy' _, ?_, ?_, ⟨a, haS, hac, ?_⟩, hagree_above⟩
  · -- `x` is ambiguous: the second pattern is transported from `y'` to `y` by (a)
    intro t
    obtain ⟨u₁, u₂, h1, h2, h3⟩ := hwit t
    refine ⟨u₁, u₂, h1, h2, fun q hq => ?_⟩
    rw [h3 q hq]
    exact (hagree_shift t q (Finset.mem_filter.mp hq).2).symm
  · -- `x'` is ambiguous: the first pattern is transported from `y` to `y'` by (a)
    intro t
    obtain ⟨u₁, u₂, h1, h2, h3⟩ := hwit t
    refine ⟨u₁, u₂, h1, fun q hq => ?_, h3⟩
    rw [h2 q hq]
    exact hagree_shift t q (Finset.mem_filter.mp hq).2
  · -- the disagreement at `a`
    have he : a + (z₁ - a) = z₁ := by abel
    simp only [T_apply, he]
    exact hz₁ne

/-- **Collé `b3_colle2.txt:774`, the ambiguous *pair*.**

`x_per` and `y_per` are the two members of the `ℓ ∈ nexpd(η)` witness, translated together
so that the face `𝒮 ∩ ℓ_𝒮` sits on the line where they first disagree.  Collé's `:774`:
*"Note that `x_per` and `y_per` are `(ℓ,𝒮)`-ambiguous configurations.  Thus, Propositions 2.10
and 2.12 imply that `x_per` and `y_per` are periodic with periods parallel to `ℓ`"*; and
`:890`: *"`(x_per)_g ≠ (y_per)_g` for some `g ∈ ℓ^(−) ∩ ℤ²` prevents both … from being fully
periodic"*.  The four conjuncts are exactly what those two sentences consume:

* both members are `(ℓ,𝒮)`-ambiguous — so `colle_prop_2_10` applies to **each**, and the
  period of `y_per` parallel to `ℓ` is not a new assumption;
* they disagree at a point `g` **of the face** `{z ∈ S | inner2 w z = c}` — Collé's
  `𝒮 ∩ ℓ_𝒮 ⊂ ℓ^(−)` (`:774`) with `g ∈ ℓ^(−)`;
* they agree **strictly above** the face level, i.e. on `ℋ(ℓ)` (`:774`, `x_per|ℋ(ℓ) = y_per|ℋ(ℓ)`).

The hypotheses are those of `exists_ambiguousAlong_of_oneSidedNonexpansive`, unchanged;
that theorem is now a corollary (its `∃ c'` is `c + 1`).  Added 2026-09-19 (lane Amink)
because the `:890` WLOG *"we may assume `x_per|ℋ(ℓ^(−))` is not fully periodic"* is a choice
between the two members, and the previous export (partner with no period, disagreement
somewhere, agreement at an unnamed level) could not make it: `Colle35.not_doublyPeriodicOn_both`
needs the disagreement point on the half plane it refutes, and the swap needs the partner to
carry everything `x_per` does. -/
theorem exists_ambiguousPair_of_oneSidedNonexpansive {ξ : Config A}
    {S : Finset (ℤ × ℤ)} (hgen : IsGeneratingSet ξ S)
    {v : ℤ × ℤ} (hv : Primitive v) {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0)
    {c : ℝ} (hmin : ∀ z ∈ S, c ≤ inner2 w z)
    (hfc : (S.filter fun z => inner2 w z = c).Nonempty)
    (honed : ∃ y ∈ orbitClosure ξ, ∃ y' ∈ orbitClosure ξ, y ≠ y' ∧
        ∀ z : ℤ × ℤ, 0 ≤ inner2 w z → y z = y' z) :
    ∃ x ∈ orbitClosure ξ, ∃ x' ∈ orbitClosure ξ,
      AmbiguousAlong ξ (S.filter fun z => c < inner2 w z) S x v ∧
      AmbiguousAlong ξ (S.filter fun z => c < inner2 w z) S x' v ∧
      (∃ g ∈ S, inner2 w g = c ∧ x g ≠ x' g) ∧
      ∀ z : ℤ × ℤ, c < inner2 w z → x z = x' z := by
  obtain ⟨y, hy, y', hy', hne, hagree⟩ := honed
  obtain ⟨μ, hμ, hμz⟩ := exists_ratio_of_inner2_eq_zero hv.ne_zero hw hwv
  rcases lt_or_gt_of_ne hμ with hneg | hpos
  · have hvneg : Primitive (-v) := by
      obtain ⟨p, q, hpq⟩ := hv
      exact ⟨-p, -q, by simp only [Prod.fst_neg, Prod.snd_neg]; linear_combination hpq⟩
    have hwvneg : inner2 w (-v) = 0 := by rw [inner2_neg, hwv, neg_zero]
    have hμz' : ∀ z : ℤ × ℤ, inner2 w z = (-μ) * ((det (-v) z : ℤ) : ℝ) := by
      intro z
      rw [hμz z]
      simp only [det, Prod.fst_neg, Prod.snd_neg]
      push_cast
      ring
    obtain ⟨x, hx, x', hx', hamb, hamb', hg, hab⟩ :=
      exists_ambiguousAlong_pos hgen hvneg hw hwvneg (by linarith) hμz' hmin hfc hy hy' hne hagree
    have hsm : ∀ t : ℤ, (-t) • (-v) = t • v := fun t => by rw [smul_neg, neg_smul, neg_neg]
    refine ⟨x, hx, x', hx', fun t => ?_, fun t => ?_, hg, hab⟩
    · obtain ⟨u₁, u₂, h1, h2, h3⟩ := hamb (-t)
      rw [hsm] at h2 h3
      exact ⟨u₁, u₂, h1, h2, h3⟩
    · obtain ⟨u₁, u₂, h1, h2, h3⟩ := hamb' (-t)
      rw [hsm] at h2 h3
      exact ⟨u₁, u₂, h1, h2, h3⟩
  · exact exists_ambiguousAlong_pos hgen hv hw hwv hpos hμz hmin hfc hy hy' hne hagree

/-- **Collé `b3_colle2.txt:355`, the producer for `AmbiguousAlong`.**

If `ℓ ∈ ONED(η)` — written out as in `colle_prop_2_10`: two distinct members of the orbit
closure agree on the half plane `{0 ≤ inner2 w ·}` — and `S` is an `η`-generating set whose
`inner2 w`-minimal face sits at level `c`, then some `x ∈ X_η` is `(ℓ,𝒮)`-ambiguous along the
primitive vector `v` spanning `ℓ`, with `𝒮 \ ℓ_𝒮 = {z ∈ S | c < inner2 w z}`.

The hypotheses are exactly those of `colle_prop_2_10` that concern `ℓ` and `S` (no
`hmax`/`hle`/`hcount`, no finiteness of the range), and the conclusion is its `hamb`.

The conclusion also carries the **ambiguity partner** `x'`: the produced `x` is a translate of
`y`, and `x'` is the same translate of `y'`, so the pair still differs somewhere and still
agrees on a half plane with normal `w` (at a shifted level `c'`).  This is Collé's pair
`x_per, y_per` of `b3_colle2.txt:774`; `b3_colle2.txt:890` uses *both* members and cannot be
discharged from `x` alone, since `AmbiguousAlong` (`:205`) records pattern positions, not a
configuration partner.  The level `c'` is existential rather than `0` precisely because the
translate moves the half plane, and no caller needs to know where it lands.

Since 2026-09-19 this is a corollary of `exists_ambiguousPair_of_oneSidedNonexpansive`, which
says more (`c' = c + 1`, the disagreement is on the face, and `x'` is ambiguous too); the
statement is kept verbatim for `ColleReg.exists_preamble` (`RegionSteps.lean`). -/
theorem exists_ambiguousAlong_of_oneSidedNonexpansive {ξ : Config A}
    {S : Finset (ℤ × ℤ)} (hgen : IsGeneratingSet ξ S)
    {v : ℤ × ℤ} (hv : Primitive v) {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0)
    {c : ℝ} (hmin : ∀ z ∈ S, c ≤ inner2 w z)
    (hfc : (S.filter fun z => inner2 w z = c).Nonempty)
    (honed : ∃ y ∈ orbitClosure ξ, ∃ y' ∈ orbitClosure ξ, y ≠ y' ∧
        ∀ z : ℤ × ℤ, 0 ≤ inner2 w z → y z = y' z) :
    ∃ x ∈ orbitClosure ξ, AmbiguousAlong ξ (S.filter fun z => c < inner2 w z) S x v ∧
      ∃ x' ∈ orbitClosure ξ, x ≠ x' ∧
        ∃ c' : ℝ, ∀ z : ℤ × ℤ, c' ≤ inner2 w z → x z = x' z := by
  obtain ⟨x, hx, x', hx', hamb, -, ⟨g, -, -, hg⟩, hab⟩ :=
    exists_ambiguousPair_of_oneSidedNonexpansive hgen hv hw hwv hmin hfc honed
  refine ⟨x, hx, hamb, x', hx', fun heq => hg (by rw [heq]), c + 1, fun z hz => hab z ?_⟩
  linarith

theorem colle_prop_2_10 {ξ x : Config A}
    (hξ : (Set.range ξ).Finite) (hx : x ∈ orbitClosure ξ)
    {S : Finset (ℤ × ℤ)} (hgen : IsGeneratingSet ξ S)
    {v : ℤ × ℤ} (hv : Primitive v) {w : ℝ × ℝ} (hw : w ≠ 0) (hwv : inner2 w v = 0)
    {c c' : ℝ}
    (hmin : ∀ z ∈ S, c ≤ inner2 w z) (hmax : ∀ z ∈ S, inner2 w z ≤ c')
    (hfc : (S.filter fun z => inner2 w z = c).Nonempty)
    (hle : (S.filter fun z => inner2 w z = c).card ≤
      (S.filter fun z => inner2 w z = c').card)
    (hcount : P ξ S - P ξ (S.filter fun z => c < inner2 w z) ≤
      (S.filter fun z => inner2 w z = c).card - 1)
    (honed : ∃ y ∈ orbitClosure ξ, ∃ y' ∈ orbitClosure ξ, y ≠ y' ∧
        ∀ z : ℤ × ℤ, 0 ≤ inner2 w z → y z = y' z)
    (hamb : AmbiguousAlong ξ (S.filter fun z => c < inner2 w z) S x v) :
    ∃ u : ℤ × ℤ, u ≠ 0 ∧ inner2 w u = 0 ∧
      ∀ z : ℤ × ℤ, inner2 w z ≤ c → x (z + u) = x z := by
  -- Step 1: Apply Cyr-Kra Lemma 2.24 (strip periodicity), fully proved above
  obtain ⟨u_strip, hu_ne, hu_perp, hu_strip⟩ :=
    exists_strip_period_of_ambiguousAlong hξ hx hgen hv hw hwv hmin hmax hfc hle
      hcount honed hamb
  -- Step 2: Apply the downward induction (Cyr-Kra Proposition 4.8, proved above)
  exact cyrKra_downward_induction hξ hx hgen hv hw hwv hmin hmax hfc hle hcount honed
    ⟨hu_ne, hu_perp, hu_strip⟩

end Nivat.Colle

