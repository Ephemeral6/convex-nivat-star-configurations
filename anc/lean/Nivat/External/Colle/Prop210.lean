            have hqS : qq ∈ S := (Finset.filter_subset _ _) hqq
            have h1 : ξ (u₁ + qq) = x ((z₁ - a) + t • v + qq) := congrFun hu₁ ⟨qq, hqS⟩
            rw [h1, hxKval]
            congr 1
            abel
          · intro qq hqq
            have hqS : qq ∈ S := (Finset.filter_subset _ _) hqq
            have h1 : ξ (u₂ + qq) = g ((z₁ - a) + t • v + qq) := congrFun hu₂ ⟨qq, hqS⟩
            have h2 : g ((z₁ - a) + t • v + qq) = x ((z₁ - a) + t • v + qq) := by
              refine hgagree _ ?_
              have hlev : det v ((z₁ - a) + t • v + qq)
                  = det v z₁ - det v a + det v qq := by
                rw [hdetadd, hdetadd, hdetsub, hdetv, add_zero]
              have hq2 : m₀ + 1 ≤ det v qq := hQlev qq hqq
              rw [hlev, hz₁lev, hdeta]
