/-! ## Definition 2.11: periodicity of a restriction -/

/-- **Colle, Definition 2.11.**  `η|𝒰` is periodic with period `h` if `h ≠ 0` and
`η_{g+h} = η_g` for all `g ∈ 𝒰 ∩ (𝒰 - h)`, i.e. for all `g ∈ 𝒰` with `g + h ∈ 𝒰`. -/
def PeriodicOnWith (η : Config α) (U : Set (ℤ × ℤ)) (h : ℤ × ℤ) : Prop :=
  h ≠ 0 ∧ ∀ g ∈ U, g + h ∈ U → η (g + h) = η g

/-- **Colle, Definition 2.11.**  `η|𝒰` is periodic. -/
def PeriodicOn (η : Config α) (U : Set (ℤ × ℤ)) : Prop := ∃ h, PeriodicOnWith η U h

/-- **Colle, Definition 3.4.**  The half-strip from `B` in the direction of `v`:
`H_B(ℓ) = {g + t v : g ∈ B, t ∈ ℤ_+}`. -/
def halfStrip (B : Set (ℤ × ℤ)) (v : ℤ × ℤ) : Set (ℤ × ℤ) :=
  {g | ∃ b ∈ B, ∃ t : ℕ, g = b + (t : ℤ) • v}

theorem subset_halfStrip (B : Set (ℤ × ℤ)) (v : ℤ × ℤ) : B ⊆ halfStrip B v := by
  intro b hb
  exact ⟨b, hb, 0, by simp⟩

/-- **Colle, Definition 2.1**, in normal form: `c` is the level of the support line of `S`
determined by the oriented line with inner normal `w`. -/
def SupportLevel (w : ℝ × ℝ) (S : Set (ℤ × ℤ)) (c : ℝ) : Prop :=
  (∀ z ∈ S, c ≤ inner2 w z) ∧ ∃ z ∈ S, inner2 w z = c

/-! ## Compactness of the shift space

Colle: "by compactness of `X_η`, the sequence `(ϑ_i)` has an accumulation point
`ϑ ∈ X_η` such that `ϑ|Â_∞ = x̂_per|Â_∞`."  Nothing here is assumed. -/

/-- **Compactness.**  A sequence of configurations whose values all lie in one finite set
has a pointwise accumulation point: a configuration `y` such that every finite window of
`y` is realised by `F n` for arbitrarily large `n`.

This is the same ultrafilter argument as `Nivat.subseqLimits_nonempty`, but for an
arbitrary sequence of configurations rather than the translates of a single one, and with
the finiteness carried by a set rather than by the whole alphabet. -/
theorem exists_accumulationPoint {S : Set α} (hS : S.Finite)
    (F : ℕ → Config α) (hF : ∀ n z, F n z ∈ S) :
    ∃ y : Config α, ∀ (W : Finset (ℤ × ℤ)) (M : ℕ),
      ∃ n : ℕ, M ≤ n ∧ ∀ z ∈ W, y z = F n z := by
  classical
  set 𝔲 : Ultrafilter ℕ := Ultrafilter.of Filter.atTop with h𝔲
  have key : ∀ z : ℤ × ℤ, ∃ a : α, {n : ℕ | F n z = a} ∈ 𝔲 := by
    intro z
    have hcover : (⋃ a ∈ S, {n : ℕ | F n z = a}) ∈ 𝔲 := by
      have huniv : (⋃ a ∈ S, {n : ℕ | F n z = a}) = Set.univ := by
        ext n
        simp only [Set.mem_iUnion, Set.mem_univ, iff_true, exists_prop]
        exact ⟨F n z, hF n z, rfl⟩
      rw [huniv]
      exact Filter.univ_mem
    obtain ⟨a, -, ha⟩ := (Ultrafilter.finite_biUnion_mem_iff hS).mp hcover
    exact ⟨a, ha⟩
  choose y hy using key
  refine ⟨y, fun W M => ?_⟩
  have h1 : {n : ℕ | M ≤ n} ∈ 𝔲 := Ultrafilter.of_le Filter.atTop (Filter.mem_atTop M)
  have h2 : (⋂ z ∈ W, {n : ℕ | F n z = y z}) ∈ 𝔲 :=
    (Filter.biInter_finset_mem W).mpr fun z _ => hy z
  obtain ⟨n, hn⟩ := Ultrafilter.nonempty_of_mem (Filter.inter_mem h1 h2)
  refine ⟨n, hn.1, fun z hz => ?_⟩
  have hn2 := hn.2
  simp only [Set.mem_iInter] at hn2
  exact (hn2 z hz).symm

/-- An accumulation point of a sequence inside the orbit closure lies in the orbit
closure: `X_η` is closed. -/
theorem mem_orbitClosure_of_accumulationPoint {θ y : Config α} {F : ℕ → Config α}
    (hF : ∀ n, F n ∈ orbitClosure θ)
    (hy : ∀ (W : Finset (ℤ × ℤ)) (M : ℕ), ∃ n : ℕ, M ≤ n ∧ ∀ z ∈ W, y z = F n z) :
    y ∈ orbitClosure θ := by
  apply orbitClosure_closed
  intro W
  obtain ⟨n, -, hn⟩ := hy W 0
  exact ⟨F n, hF n, hn⟩

/-- An accumulation point inherits, on the union of an increasing family of windows, any
agreement holding on each window. -/
theorem eqOn_iUnion_of_accumulationPoint {A : ℕ → Set (ℤ × ℤ)} (hmono : Monotone A)
    {F : ℕ → Config α} {x y : Config α}
    (hagree : ∀ i, ∀ z ∈ A i, F i z = x z)
    (hy : ∀ (W : Finset (ℤ × ℤ)) (M : ℕ), ∃ n : ℕ, M ≤ n ∧ ∀ z ∈ W, y z = F n z) :
    ∀ z ∈ ⋃ i, A i, y z = x z := by
  intro z hz
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
  obtain ⟨n, hn, hnz⟩ := hy {z} i
  rw [hnz z (Finset.mem_singleton_self z)]
  exact hagree n z (hmono hn hi)

/-- **Colle's accumulation step, in one piece and with no extra hypotheses.**
If translates `T^{u i} η` of a finite-range configuration `η` copy a fixed configuration
`x` on an increasing family of windows `A i`, then some `ϑ ∈ X_η` copies `x` on the whole
union `⋃ i, A i`. -/
theorem exists_mem_orbitClosure_eqOn_iUnion {θ : Config α} (hfin : (Set.range θ).Finite)
    {A : ℕ → Set (ℤ × ℤ)} (hmono : Monotone A) (u : ℕ → ℤ × ℤ) {x : Config α}
    (hagree : ∀ i, ∀ z ∈ A i, θ (z + u i) = x z) :
    ∃ ϑ ∈ orbitClosure θ, ∀ z ∈ ⋃ i, A i, ϑ z = x z := by
  obtain ⟨y, hy⟩ := exists_accumulationPoint hfin (fun n => T (u n) θ)
    (fun n z => ⟨z + u n, rfl⟩)
  refine ⟨y, mem_orbitClosure_of_accumulationPoint (fun n => T_mem_orbitClosure θ (u n)) hy,
    eqOn_iUnion_of_accumulationPoint hmono (fun i z hz => hagree i z hz) hy⟩

/-- "In particular, `ϑ|Â_∞` is a periodic configuration with period parallel to `ℓ`":
a configuration agreeing with `x` on `U` inherits every period of `x` as a period of its
restriction to `U`, in the sense of Colle's Definition 2.11. -/
theorem periodicOnWith_of_eqOn {ϑ x : Config α} {U : Set (ℤ × ℤ)}
    (hU : ∀ z ∈ U, ϑ z = x z) {h : ℤ × ℤ} (hne : h ≠ 0) (hp : h ∈ Per x) :
    PeriodicOnWith ϑ U h := by
  refine ⟨hne, fun g hg hgh => ?_⟩
  rw [hU _ hgh, hU _ hg]
  exact Per.apply hp g

/-! ## The finite-orbit pigeonhole along a tangent direction

Colle: "Since `x_per ∈ X_η` is a periodic configuration with period parallel to `ℓ`, then
there exists an integer `k ≥ 0` such that `T^{k v_ℓ} x_per = T^{k_i v_ℓ} x_per` for
infinitely many `i`."  Nothing here is assumed. -/

/-- A nonzero period parallel to `v` forces a positive *natural* multiple of `v` to be a
period. -/
theorem exists_nat_smul_mem_Per {x : Config α} {p v : ℤ × ℤ}
    (hp : p ∈ Per x) (hpne : p ≠ 0) (hv : v ≠ 0) (hdet : det p v = 0) :
    ∃ N : ℕ, 0 < N ∧ ((N : ℤ) • v) ∈ Per x := by
  have hdet' : det v p = 0 := by
    have := det_comm p v
    omega
  obtain ⟨k, l, hk, hkl⟩ := exists_common_multiple_of_det_eq_zero hv hpne hdet'
  have hmem : k • v ∈ Per x := by
    rw [hkl]
    exact (Per x).zsmul_mem hp l
  refine ⟨k.natAbs, Int.natAbs_pos.mpr hk, ?_⟩
  rcases Int.natAbs_eq k with heq | heq
  · rw [← heq]; exact hmem
  · rw [show ((k.natAbs : ℤ)) = -k by omega, neg_smul]
    exact (Per x).neg_mem hmem

/-- Translating by a period changes nothing. -/
theorem T_add_of_mem_Per {x : Config α} {a : ℤ × ℤ} (ha : a ∈ Per x) (b : ℤ × ℤ) :
    T (b + a) x = T b x := by
  rw [T_add, (mem_Per_iff.mp ha)]

/-- **The pigeonhole.**  For a configuration with a nonzero period parallel to `v`, any
sequence `κ : ℕ → ℕ` of translation amounts along `v` takes some value infinitely often, up
to equality of the translated configurations. -/
theorem exists_infinite_translate_eq {x : Config α} {p v : ℤ × ℤ}
    (hp : p ∈ Per x) (hpne : p ≠ 0) (hv : v ≠ 0) (hdet : det p v = 0) (κ : ℕ → ℕ) :
    ∃ k : ℕ, {i : ℕ | T ((κ i : ℤ) • v) x = T ((k : ℤ) • v) x}.Infinite := by
  classical
  obtain ⟨N, hN, hNper⟩ := exists_nat_smul_mem_Per hp hpne hv hdet
  have : NeZero N := ⟨hN.ne'⟩
  obtain ⟨r, hr⟩ := Finite.exists_infinite_fiber (fun i : ℕ => (⟨κ i % N, Nat.mod_lt _ hN⟩ : Fin N))
  refine ⟨(r : ℕ), ?_⟩
  have hsub : (fun i : ℕ => (⟨κ i % N, Nat.mod_lt _ hN⟩ : Fin N)) ⁻¹' {r} ⊆
      {i : ℕ | T ((κ i : ℤ) • v) x = T (((r : ℕ) : ℤ) • v) x} := by
    intro i hi
    have hmod : κ i % N = (r : ℕ) := congrArg Fin.val hi
    have hsplit : (κ i : ℤ) = ((r : ℕ) : ℤ) + (N : ℤ) * ((κ i / N : ℕ) : ℤ) := by
      have := Nat.div_add_mod (κ i) N
      omega
    show T ((κ i : ℤ) • v) x = T (((r : ℕ) : ℤ) • v) x
    have hper : ((N : ℤ) * ((κ i / N : ℕ) : ℤ)) • v ∈ Per x := by
      rw [mul_comm, mul_smul]
      exact (Per x).zsmul_mem hNper _
    rw [hsplit, add_smul]
    exact T_add_of_mem_Per hper _
  exact Set.Infinite.mono hsub (Set.infinite_coe_iff.mp hr)

/-! ## The least-`ε` extraction

Colle: "We claim that there exists `ε ∈ ℤ_+` such that `ϑ|Â_∞^{(ε)} = x̂_per|Â_∞^{(ε)}`
but `ϑ|Â_∞^{(ε+1)} ≠ x̂_per|Â_∞^{(ε+1)}`."  Nothing here is assumed. -/

/-- **(3.1).**  If agreement holds on the innermost shell but not on all shells, there is a
last shell on which it holds. -/
theorem exists_shell_boundary {ϑ y : Config α} {D : ℕ → Set (ℤ × ℤ)}
    (h0 : ∀ z ∈ D 0, ϑ z = y z) (hfail : ¬ ∀ ε, ∀ z ∈ D ε, ϑ z = y z) :
    ∃ ε : ℕ, (∀ z ∈ D ε, ϑ z = y z) ∧ ¬ (∀ z ∈ D (ε + 1), ϑ z = y z) := by
  classical
  have hex : ∃ ε : ℕ, ¬ ∀ z ∈ D ε, ϑ z = y z := by
    by_contra hc
    exact hfail (by simpa using hc)
  set ε₀ := Nat.find hex with hε₀
  have hspec : ¬ ∀ z ∈ D ε₀, ϑ z = y z := Nat.find_spec hex
  have hpos : 0 < ε₀ := by
    rcases Nat.eq_zero_or_pos ε₀ with h | h
    · exact absurd (h ▸ h0) hspec
    · exact h
  refine ⟨ε₀ - 1, ?_, ?_⟩
  · have := Nat.find_min hex (m := ε₀ - 1) (by omega)
    simpa using this
  · have heq : ε₀ - 1 + 1 = ε₀ := by omega
    rw [heq]
    exact hspec

/-! ## Propagation of agreement by a generating set

Colle: "Since `S_φ` is `η`-generating, by induction we get from (3.3) that
`ϑ_i|Â_i^{(ε)} = x̂_per|Â_i^{(ε)}`."  Nothing here is assumed beyond the generating
property itself, which is `Nivat.Colle.GeneratesAt`. -/

/-- One application of the local rule: if the generated site `a` of the window `S` is
translated by `t`, and all the *other* sites of the translated window already carry equal
values, then so does `a + t`. -/
theorem eq_at_of_generatesAt_shift {ξ : Config α} {S : Finset (ℤ × ℤ)} {a : ℤ × ℤ}
    (hgen : GeneratesAt ξ S a) {x y : Config α}
    (hx : x ∈ orbitClosure ξ) (hy : y ∈ orbitClosure ξ)
    {U : Set (ℤ × ℤ)} (hU : ∀ z ∈ U, x z = y z)
    {t : ℤ × ℤ} (hsub : ∀ b ∈ S.erase a, b + t ∈ U) :
    x (a + t) = y (a + t) := by
  have hlocal : ∀ b ∈ S.erase a, T t x b = T t y b := by
    intro b hb
    exact hU _ (hsub b hb)
  exact hgen.2 (T t x) (T_mem_of_mem_orbitClosure hx t)
    (T t y) (T_mem_of_mem_orbitClosure hy t) hlocal

/-- **The induction from (3.3).**  If every site of the `(n+1)`-st shell either already lies
in the `n`-th shell, or is the image of the generated site `a` under a translation carrying
the rest of the window into the `n`-th shell, then agreement spreads from the `0`-th shell
to all of them. -/
theorem eqOn_of_generatesAt_of_shells {ξ : Config α} {S : Finset (ℤ × ℤ)} {a : ℤ × ℤ}
    (hgen : GeneratesAt ξ S a) {x y : Config α}
    (hx : x ∈ orbitClosure ξ) (hy : y ∈ orbitClosure ξ)
    {U : ℕ → Set (ℤ × ℤ)}
    (hstep : ∀ n, ∀ z ∈ U (n + 1),
      z ∈ U n ∨ ∃ t : ℤ × ℤ, z = a + t ∧ ∀ b ∈ S.erase a, b + t ∈ U n)
    (h0 : ∀ z ∈ U 0, x z = y z) : ∀ n, ∀ z ∈ U n, x z = y z := by
  intro n
  induction n with
  | zero => exact h0
  | succ n ih =>
    intro z hz
    rcases hstep n z hz with hin | ⟨t, rfl, hsub⟩
    · exact ih z hin
    · exact eq_at_of_generatesAt_shift hgen hx hy ih hsub

/-! ## Auxiliary: extracting a monotone subsequence

Colle: "By passing to a subsequence, we can assume this holds for all `i`."  Nothing here is
assumed. -/

/-- An infinite set of naturals carries a monotone, index-dominating enumeration.  This is
the "pass to a subsequence" step, made explicit. -/
theorem exists_monotone_of_infinite {I : Set ℕ} (hI : I.Infinite) :
    ∃ σ : ℕ → ℕ, (∀ n, σ n ∈ I) ∧ (∀ i j, i ≤ j → σ i ≤ σ j) ∧ ∀ n, n ≤ σ n := by
  classical
  have hgt : ∀ n : ℕ, ∃ m, m ∈ I ∧ n < m := by
    intro n
    obtain ⟨m, hm, hm'⟩ := hI.exists_gt n
    exact ⟨m, hm, hm'⟩
  choose f hfI hflt using hgt
  obtain ⟨m₀, hm₀⟩ := hI.nonempty
  refine ⟨fun n => Nat.rec (motive := fun _ => ℕ) m₀ (fun _ p => f p) n, ?_, ?_, ?_⟩
  · intro n
    induction n with
    | zero => exact hm₀
    | succ n _ => exact hfI _
  · have hlt : ∀ n, (Nat.rec (motive := fun _ => ℕ) m₀ (fun _ p => f p) n : ℕ)
        < Nat.rec (motive := fun _ => ℕ) m₀ (fun _ p => f p) (n + 1) := fun n => hflt _
    exact fun i j hij => (strictMono_nat_of_lt_succ hlt).monotone hij
  · intro n
    induction n with
    | zero => exact Nat.zero_le _
    | succ n ih => exact Nat.succ_le_of_lt (lt_of_le_of_lt ih (hflt _))

/-- Every period of `x` is a period of any translate of `x`. -/
theorem mem_Per_T {x : Config α} {p : ℤ × ℤ} (hp : p ∈ Per x) (a : ℤ × ℤ) :
    p ∈ Per (T a x) := by
  rw [mem_Per_iff, ← T_add, add_comm, T_add, mem_Per_iff.mp hp]

/-! ## The geometric input of Lemma 3.5

Everything in `ChainData` is an **assumption**.  It packages exactly the parts of Colle's
proof that rest on the convex-geometry of `E(S_φ)`-enveloped sets, which is not developed in
this repository.  See the "What is assumed" section of the module docstring. -/

/-- The geometric data produced by the first two thirds of Colle's proof of Lemma 3.5,
recorded as explicit hypotheses.

`η` is the configuration, `xper` the periodic configuration `x_per ∈ X_η`, `vl` the lattice
vector `v_ℓ` spanning the direction of `ℓ = ℓ_ι`, and `GeneratesAt η S gen` (supplied
separately) is the generating-set input "`S_φ` is `η`-generating".

Field-by-field this is:

* `Env` — "is an `E(S_φ)`-enveloped set" (Definition 3.2), abstract.
* `B`, `A`, `u` — the chain `B' ⊂ B₁ ⊂ A₁ ⊂ B₂ ⊂ ⋯` and the translations `u_i` of
  items (i)–(iv); `envB`, `envA`, `subBA`, `subAB`, `subStrip`, `agreeA` are items (i)–(iii)
  together with the agreement half of (iv).
* `kk`, `Ahat`, `AhatEq` — the normalisation `Â_i := A_i - k_i v_ℓ`.
* `AhatMono` — that the normalised sets are nested (used by Colle implicitly when he writes
  `ϑ_{i'}|Â_i = ϑ_i|Â_i` for `i ≤ i'` and `Â_∞ := ⋃ Â_i`).
* `maximalHat` — Colle's "It is easy to see that each `Â_i` is a maximal set among all
  `E(S_φ)`-enveloped sets `T` such that `B_i - k_i v_ℓ ⊂ T ⊂ H_{B_i}(ℓ) - k_i v_ℓ` and
  `(T^{k_i v_ℓ + u_i} η)|T = (T^{k_i v_ℓ} x_per)|T`", transcribed literally.
* `shell`, `shellInf` — the families `Â_i^{(ε)}` and `Â_∞^{(ε)}`, with `shellFinite`,
  `subShell`, `shellSubInf`, `shellInfZero`, `shellSubStrip` recording the containments
  Colle states, and `shellProper` recording that a shell of positive thickness is strictly
  larger than `Â_i` (this is what makes the final contradiction bite).
* `shellEnv` — "for an appropriate `ε ∈ ℕ` fixed and all `i ∈ ℕ` sufficiently large,
  `Â_i^{(ε)}` is an `E(S_φ)`-enveloped set".
* `fill`, `fillZero`, `fillStep`, `fillCover` — the filtration along which Colle's phrase
  "by induction we get from (3.3)" runs: each new site of `Â_i^{(ε)}` is obtained from
  already-filled sites by one translate of the window `S` whose distinguished point is
  `gen`.  The induction itself is *proved*, in `eqOn_of_generatesAt_of_shells`; only the
  existence of the filtration is assumed. -/
structure ChainData {α : Type*} (η xper : Config α) (vl : ℤ × ℤ)
    (S : Finset (ℤ × ℤ)) (gen : ℤ × ℤ) where
  /-- "is an `E(S_φ)`-enveloped set" (Definition 3.2), left abstract. -/
  Env : Set (ℤ × ℤ) → Prop
  /-- The sets `B_i` of the chain. -/
  B : ℕ → Set (ℤ × ℤ)
  /-- The sets `A_i` of the chain. -/
  A : ℕ → Set (ℤ × ℤ)
  /-- The translations `u_i` of item (iii). -/
  u : ℕ → ℤ × ℤ
  /-- The normalising amounts `k_i`. -/
  kk : ℕ → ℕ
  /-- `Â_i := A_i - k_i v_ℓ`. -/
  Ahat : ℕ → Set (ℤ × ℤ)
  /-- `Â_i^{(ε)}`. -/
  shell : ℕ → ℕ → Set (ℤ × ℤ)
  /-- `Â_∞^{(ε)}`. -/
  shellInf : ℕ → Set (ℤ × ℤ)
  /-- Item (i): each `B_i` is `E(S_φ)`-enveloped. -/
  envB : ∀ i, Env (B i)
  /-- Item (iv): each `A_i` is `E(S_φ)`-enveloped. -/
  envA : ∀ i, Env (A i)
  /-- The chain `B_i ⊂ A_i`. -/
  subBA : ∀ i, B i ⊆ A i
  /-- The chain `A_i ⊂ B_{i+1}`. -/
  subAB : ∀ i, A i ⊆ B (i + 1)
  /-- Item (iv): `A_i ⊂ H_{B_i}(ℓ)`. -/
  subStrip : ∀ i, A i ⊆ halfStrip (B i) vl
  /-- Items (iii)–(iv): `(T^{u_i} η)|A_i = x_per|A_i`. -/
  agreeA : ∀ i, ∀ z ∈ A i, η (z + u i) = xper z
  /-- `Â_i = A_i - k_i v_ℓ`. -/
  AhatEq : ∀ i, Ahat i = {z | z + (kk i : ℤ) • vl ∈ A i}
  /-- The normalised sets are nested. -/
  AhatMono : ∀ i j, i ≤ j → Ahat i ⊆ Ahat j
  /-- Maximality of `Â_i`, transcribed from the source. -/
  maximalHat : ∀ i (Tset : Set (ℤ × ℤ)), Env Tset → Ahat i ⊆ Tset →
    Tset ⊆ {z | z + (kk i : ℤ) • vl ∈ halfStrip (B i) vl} →
    (∀ z ∈ Tset, η (z + ((kk i : ℤ) • vl + u i)) = xper (z + (kk i : ℤ) • vl)) →
    Tset ⊆ Ahat i
  /-- Each `Â_i^{(ε)}` is finite. -/
  shellFinite : ∀ i ε, (shell i ε).Finite
  /-- `Â_i ⊆ Â_i^{(ε)}` (the case `t = 0`). -/
  subShell : ∀ i ε, Ahat i ⊆ shell i ε
  /-- `Â_i^{(ε)} ⊆ Â_∞^{(ε)}`, by definition of `Â_i^{(ε)}`. -/
  shellSubInf : ∀ i ε, shell i ε ⊆ shellInf ε
  /-- `Â_∞^{(0)} ⊆ Â_∞`, since `d₀ = 0`. -/
  shellInfZero : shellInf 0 ⊆ ⋃ i, Ahat i
  /-- **`I₀`, the paper's second constant** (`b3_colle2.txt:520` verbatim: "consider a constant
  `I₀ ∈ ℕ` such that `ϑ|Â_{i₀}^{(ε)} = ϑ_i|Â_{i₀}^{(ε)}` for all `i ≥ I₀`"), used at `:524`
  ("if we consider `i ≥ max{i₀, I₀}`").

  **量词与原文对齐（2026-09-24，集成者，第 162 轮）。**在此之前 `shellSubStrip` /
  `shellProper` / `fillCover` 的尾部都写成 `∀ i, i₀ ≤ i → …`，**那比 `:524` 强**——原文的
  下界是 `max{i₀, I₀}`，而原文从未主张 `I₀ ≤ i₀`。按硬规矩 5，那个全称是我们加的，是债。
  两条独立路线同一轮撞到同一处：`lane-leafa-gen` 的 `exists_threshold_genClosure`
  （`tmp/wip/lane-leafa-gen-fillcover-depth.lean` §17，0 sorry）自然产出的形状正是
  `∃ N, … ∀ i, max i₀ N ≤ i → …` 且 `N` 与 `ε`、`i₀` 无关；`lane-tower-hlev` 的
  `escapeW_binder_false_on_box`（`tmp/wip/lane-tower-hlev-escapew.lean:782`）从反例侧
  指出 floor 必须自选（该反例的 `Env` 不是 `EnvOf ↑S`，只算收据不算活证伪）。

  **守卫仍然锚在 `i₀`**（`∀ i, i₀ ≤ i → Env (shell i ε)`），不跟着抬到 `max`：守卫是那三条
  的**前提**，锚得越低覆盖的 `i` 越多、对生产者越有利，而它正是 `shellEnv`（`:516-520`）
  产出的东西。抬到 `max` 只会白白削弱前提。 -/
  I₀ : ℕ
  /-- `Â_i^{(ε)} ⊆ H_{B_i}(ℓ) - k_i v_ℓ` (`b3_colle2.txt:520`).

  **量词与原文对齐（2026-09-23，集成者）。**原文这一句整句是

  > "Note that, **for an appropriate `ε ∈ ℕ` fixed and all `i ∈ ℕ` sufficiently large**,
  > `Â_i^{(ε)} := {g − t·v⃗_{ℓ_{J+1}} ∈ Â_∞^{(ε)} : g ∈ Â_i, t ∈ ℤ₊}` is an `E(S_φ)`-enveloped
  > set. **Furthermore**, one has `B_i − k_i v⃗_ℓ ⊂ Â_i^{(ε)} ⊂ H_{B_i}(ℓ) − k_i v⃗_ℓ`."

  即本字段与 `shellEnv` 是**同一句**、**共享同一对 `(ε, i₀)`**，量词是 `∃ε ∃i₀ ∀i≥i₀`，不是
  `∀i ∀ε`。旧版写成 `∀ i ε, shell i ε ⊆ …`，那个全称是我们加的（硬规矩 5），比原文强。
  现改成「对 `shellEnv` 给出的那对 `(ε, i₀)`、对每个 `i ≥ i₀`」——消费者
  （`lemma35` 内 `hfail` 的 `c.shellSubStrip …`，本文件下方）正是这样用的：那里的 `ε, i₀`
  就是 `obtain ⟨ε, i₀, hεpos, hEnv⟩ := c.shellEnv` 拿到的，`i₀ ≤ σ j` 现成。 -/
  shellSubStrip : ∀ ε i₀ : ℕ, 0 < ε → (∀ i, i₀ ≤ i → Env (shell i ε)) →
    ∀ i, max i₀ I₀ ≤ i → shell i ε ⊆ {z | z + (kk i : ℤ) • vl ∈ halfStrip (B i) vl}
  /-- A shell of positive thickness is strictly larger than `Â_i`.

  **量词与原文对齐（2026-09-23，集成者，第 159 轮）。**本字段与 `fillCover` 同出原文
  `b3_colle2.txt:530` 的**一句**：

  > "Since `S_φ` is `η`-generating, by induction we get from (3.3) that
  > `ϑ_i|Â_i^{(ε)} = x̂_per|Â_i^{(ε)}`, **which contradicts the maximality of `Â_i`** and
  > concludes the proof."

  那里的 `ε` 是 `:516` 「for an appropriate `ε ∈ ℕ` fixed and all `i ∈ ℕ` sufficiently large」
  钉住的那一个，不是任意的。旧版 `∀ i ε, 0 < ε → …` 的两个全称都是我们加的（硬规矩 5）。
  现改成与 `shellSubStrip`（`:756`）逐字同形的守卫版：对 `shellEnv` 给出的那对 `(ε, i₀)`、
  对每个 `i ≥ i₀`。消费者（本文件 `hfail` 末尾）正是这样用的——那里 `hεpos`、`hEnv`、
  `hi₀i : i₀ ≤ σ j` 全部现成。 -/
  shellProper : ∀ ε i₀ : ℕ, 0 < ε → (∀ i, i₀ ≤ i → Env (shell i ε)) →
    ∀ i, max i₀ I₀ ≤ i → ¬ (shell i ε ⊆ Ahat i)
  /-- "For an appropriate `ε` fixed and all `i` sufficiently large, `Â_i^{(ε)}` is an
  `E(S_φ)`-enveloped set." -/
  shellEnv : ∃ ε i₀, 0 < ε ∧ ∀ i, i₀ ≤ i → Env (shell i ε)
  /-- The filtration along which the generation induction of (3.3) runs. -/
  fill : ℕ → ℕ → ℕ → ℕ → Set (ℤ × ℤ)
  /-- The filtration starts inside `Â_i ∪ Â_{i₀}^{(ε)}`. -/
  fillZero : ∀ i i₀ ε, fill i i₀ ε 0 ⊆ Ahat i ∪ shell i₀ ε
  /-- Each new site is a translate of the distinguished point of the window `S`, all of
  whose other points are already filled. -/
  fillStep : ∀ i i₀ ε n, ∀ z ∈ fill i i₀ ε (n + 1),
    z ∈ fill i i₀ ε n ∨ ∃ t : ℤ × ℤ, z = gen + t ∧ ∀ b ∈ S.erase gen, b + t ∈ fill i i₀ ε n
  /-- The filtration exhausts `Â_i^{(ε)}`, from a lower filtration base `i₀ ≤ i` (see
  `ChainCanon.lean`'s `fillCover` for why the unconstrained `∀ i₀` version is false).
  Phrased against the unrestricted generating closure `Colle37.GenClosure` (Round 80,
  `blueprint/LANDING.md` 第八十轮) rather than the single-generator `fill` filtration above:
  `fill`/`fillZero`/`fillStep` can only ever generate at translates of the one distinguished
  point `gen`, and `FillCoverWitness.lean` exhibits a shell reachable from one choice of `gen`
  and not another — a choice the paper never makes.

  **量词与原文对齐（2026-09-23，集成者，第 159 轮）。**原文 `b3_colle2.txt:530` 的那句
  「Since `S_φ` is `η`-generating, by induction we get from (3.3) that …」整个活在 `:516`
  的 “for an appropriate `ε ∈ ℕ` **fixed** and all `i ∈ ℕ` sufficiently large” 之下，所以
  `ε` 不是任意的、`i` 有下界。旧版的 `∀ ε` 是我们加的，而且**已被内核证伪**：
  `Nivat.LaneLeafAGenInter.not_fillCover_binder_exh`（`tmp/wip/lane-leafa-gen-fillcover-inter.lean:746`，
  集成者复跑 `check1.sh` EXIT=0、公理全白名单）在 `(i, i₀, ε) = (2, 0, 5)` 上逐字符否掉
  `ChainExhaustInter.lean` 的 `fillCover` binder，同一赋值上 `hexh` 与 `nℓ`-组全部兑现；
  而同一实例在 `shellEnv` 给出的 `(ε, i₀) = (1, 0)` 上结论为真
  （`fillCover_guarded_x`，同文件 `:639`）。差别正是这道守卫。

  现改成与 `shellSubStrip`（`:756`）、`shellProper` 逐字同形的守卫版。消费者（本文件
  `hfail` 里 `hshelleq` 处）本来就在 `obtain ⟨ε, i₀, hεpos, hEnv⟩ := c.shellEnv` 之后用它。 -/
  fillCover : ∀ ε i₀ : ℕ, 0 < ε → (∀ i, i₀ ≤ i → Env (shell i ε)) →
    ∀ i, max i₀ I₀ ≤ i → shell i ε ⊆ {z | Colle37.GenClosure S (Ahat i ∪ shell i₀ ε) z}

/-- **Non-vacuity check for the hypothesis bundle.**  `ChainData` is satisfiable: here is an
explicit (degenerate, but genuine) instance, so `lemma35` below cannot be vacuously true
through a self-contradictory package.

The witness necessarily has `η` disagreeing with `x_per` at a point of the outer shell:
`shellEnv`, `shellProper` and the agreement clause of `maximalHat` are jointly
unsatisfiable when `η` agrees with `x_per` on a whole shell of positive thickness — which is
exactly the contradiction driving the last paragraph of Colle's proof. -/
theorem nonempty_chainData :
    Nonempty (ChainData (fun z : ℤ × ℤ => decide (z = ((1 : ℤ), (0 : ℤ))))
      (fun _ : ℤ × ℤ => false) ((1 : ℤ), (0 : ℤ)) {0} 0) := by
  classical
  refine ⟨{
    Env := fun T => T ⊆ ({0, ((1 : ℤ), (0 : ℤ))} : Set (ℤ × ℤ))
    B := fun _ => ({0} : Set (ℤ × ℤ))
    A := fun _ => ({0} : Set (ℤ × ℤ))
    u := fun _ => 0
    kk := fun _ => 0
    Ahat := fun _ => ({0} : Set (ℤ × ℤ))
    shell := fun _ ε => match ε with
      | 0 => ({0} : Set (ℤ × ℤ))
      | _ + 1 => ({0, ((1 : ℤ), (0 : ℤ))} : Set (ℤ × ℤ))
    shellInf := fun ε => match ε with
      | 0 => ({0} : Set (ℤ × ℤ))
      | _ + 1 => ({0, ((1 : ℤ), (0 : ℤ))} : Set (ℤ × ℤ))
    fill := fun _ i₀ ε _ => ({0} : Set (ℤ × ℤ)) ∪ (match ε with
      | 0 => ({0} : Set (ℤ × ℤ))
      | _ + 1 => ({0, ((1 : ℤ), (0 : ℤ))} : Set (ℤ × ℤ)))
    envB := ?_, envA := ?_, subBA := ?_, subAB := ?_, subStrip := ?_, agreeA := ?_
    AhatEq := ?_, AhatMono := ?_, maximalHat := ?_, shellFinite := ?_, subShell := ?_
    shellSubInf := ?_, shellInfZero := ?_, shellSubStrip := ?_, shellProper := ?_
    -- `I₀`（第 162 轮，`b3_colle2.txt:520`）：本实例的 shell 字段都不看 `i` 的下界，取 0。
    I₀ := 0
    shellEnv := ?_, fillZero := ?_, fillStep := ?_, fillCover := ?_ }⟩
  · exact fun _ => Set.singleton_subset_iff.mpr (Set.mem_insert _ _)
  · exact fun _ => Set.singleton_subset_iff.mpr (Set.mem_insert _ _)
  · exact fun _ => subset_rfl
  · exact fun _ => subset_rfl
  · exact fun _ => Set.singleton_subset_iff.mpr ⟨0, rfl, 0, by simp⟩
  · intro i z hz
    simp only [Set.mem_singleton_iff] at hz
    subst hz
    simp [Prod.ext_iff]
  · intro i
    ext z
    simp
  · exact fun _ _ _ => subset_rfl
  · -- maximality: a set strictly bigger than `{0}` must contain `(1,0)`, where the
    -- agreement clause fails because `η (1,0) = true ≠ false = x_per (1,0)`.
    intro i Tset hEnv _ _ hagree z hz
    have hz' := hEnv hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz' ⊢
    rcases hz' with h | h
    · exact h
    · exfalso
      have := hagree z hz
      subst h
      simp at this
  · intro i ε
    match ε with
    | 0 => exact Set.finite_singleton _
    | _ + 1 => exact (Set.finite_singleton _).insert _
  · intro i ε
    match ε with
    | 0 => exact subset_rfl
    | _ + 1 => exact Set.singleton_subset_iff.mpr (Set.mem_insert _ _)
  · intro i ε
    match ε with
    | 0 => exact subset_rfl
    | _ + 1 => exact subset_rfl
  · intro z hz
    exact Set.mem_iUnion.mpr ⟨0, hz⟩
  · intro ε _ _ _ i _ z hz
    have h0 : (0 : ℤ × ℤ) ∈ halfStrip ({0} : Set (ℤ × ℤ)) ((1 : ℤ), (0 : ℤ)) :=
      ⟨0, rfl, 0, by simp⟩
    have h1 : ((1 : ℤ), (0 : ℤ)) ∈ halfStrip ({0} : Set (ℤ × ℤ)) ((1 : ℤ), (0 : ℤ)) :=
      ⟨0, rfl, 1, by simp⟩
    simp only [Set.mem_ofPred_eq, Nat.cast_zero, zero_smul, add_zero]
    match ε with
    | 0 =>
      simp only [Set.mem_singleton_iff] at hz
      subst hz; exact h0
    | _ + 1 =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with h | h <;> subst h
      · exact h0
      · exact h1
  · intro ε _i₀ hε _hEnv i _hi hsub
    match ε with
    | 0 => exact absurd hε (by omega)
    | _ + 1 =>
      have : ((1 : ℤ), (0 : ℤ)) ∈ ({0} : Set (ℤ × ℤ)) :=
        hsub (Set.mem_insert_of_mem _ rfl)
      simp [Prod.ext_iff] at this
  · exact ⟨1, 0, by omega, fun i _ => subset_rfl⟩
  · exact fun _ _ _ => subset_rfl
  · exact fun _ _ _ _ z hz => Or.inl hz
  · intro ε i₀ _hε _hEnv i _hi
    exact fun z hz => Colle37.GenClosure.base (Set.mem_union_right _ hz)

/-! ## Lemma 3.5 -/

/-- **Colle, Lemma 3.5 (dynamical core).**

Given the geometric data of Colle's chain construction (`ChainData`, all assumed) and the
generating-set input, there exist `ϑ ∈ X_η`, an integer `K ≥ 0` and `ε ∈ ℤ_+` such that,
writing `x̂_per := T^{K v_ℓ} x_per`,

* `ϑ|Â_∞ = x̂_per|Â_∞` where `Â_∞ = ⋃ᵢ Â_i`;
* `ϑ|Â_∞` is periodic with period `p` (which is parallel to `ℓ` by `hdet`), in the sense of
  Definition 2.11;
* `ϑ|Â_∞^{(ε)} = x̂_per|Â_∞^{(ε)}` but `ϑ|Â_∞^{(ε+1)} ≠ x̂_per|Â_∞^{(ε+1)}`, which is (3.1).

**Not** concluded (see "Deviations" in the module docstring): that `Â_∞` is an
`(ℓ_ι, ℓ_J)`-region with `ι+1 ≤ J ≤ ι+m-1`.  Item (ii) of the source is the same statement
with `vl := -v_ℓ`, so it is not stated separately. -/
theorem lemma35 {η xper : Config α} (hfin : (Set.range η).Finite)
    (hxper : xper ∈ orbitClosure η)
    {S : Finset (ℤ × ℤ)} {gen : ℤ × ℤ} (hgen : Nivat.Colle.IsGeneratingSet η S)
    {vl : ℤ × ℤ} (hvl : vl ≠ 0) {p : ℤ × ℤ} (hp : p ∈ Per xper) (hpne : p ≠ 0)
    (hdet : det p vl = 0) (c : ChainData η xper vl S gen) :
    ∃ ϑ ∈ orbitClosure η, ∃ K : ℕ,
      (∀ z ∈ ⋃ i, c.Ahat i, ϑ z = T ((K : ℤ) • vl) xper z) ∧
      PeriodicOnWith ϑ (⋃ i, c.Ahat i) p ∧
      ∃ ε : ℕ,
        (∀ z ∈ c.shellInf ε, ϑ z = T ((K : ℤ) • vl) xper z) ∧
        ¬ (∀ z ∈ c.shellInf (ε + 1), ϑ z = T ((K : ℤ) • vl) xper z) := by
  classical
  -- "there exists an integer `k ≥ 0` such that `T^{k v_ℓ} x_per = T^{k_i v_ℓ} x_per` for
  -- infinitely many `i`.  By passing to a subsequence, we can assume this holds for all `i`."
  obtain ⟨K, hKinf⟩ := exists_infinite_translate_eq hp hpne hvl hdet c.kk
  obtain ⟨σ, hσmem, hσmono, hσle⟩ := exists_monotone_of_infinite hKinf
  set xhat : Config α := T ((K : ℤ) • vl) xper with hxhatdef
  have hxhatmem : xhat ∈ orbitClosure η := T_mem_of_mem_orbitClosure hxper _
  have hσeq : ∀ j, T ((c.kk (σ j) : ℤ) • vl) xper = xhat := fun j => hσmem j
  -- `ϑ_i := T^{k v_ℓ + u_i} η` along the subsequence.
  set U : ℕ → ℤ × ℤ := fun j => (c.kk (σ j) : ℤ) • vl + c.u (σ j) with hUdef
  set F : ℕ → Config α := fun j => T (U j) η with hFdef
  have hWmono : ∀ i j, i ≤ j → c.Ahat (σ i) ⊆ c.Ahat (σ j) :=
    fun i j hij => c.AhatMono _ _ (hσmono i j hij)
  -- `(T^{k_i v_ℓ + u_i} η)|Â_i = (T^{k_i v_ℓ} x_per)|Â_i = x̂_per|Â_i`.
  have hagreeW : ∀ j, ∀ z ∈ c.Ahat (σ j), F j z = xhat z := by
    intro j z hz
    have hzA : z + (c.kk (σ j) : ℤ) • vl ∈ c.A (σ j) := by
      rw [c.AhatEq (σ j)] at hz; exact hz
    have := c.agreeA (σ j) _ hzA
    have hrw : z + (c.kk (σ j) : ℤ) • vl + c.u (σ j) = z + U j := by
      simp [hUdef, add_assoc]
    rw [hrw] at this
    calc F j z = η (z + U j) := rfl
      _ = xper (z + (c.kk (σ j) : ℤ) • vl) := this
      _ = (T ((c.kk (σ j) : ℤ) • vl) xper) z := rfl
      _ = xhat z := by rw [hσeq j]
  -- "by compactness of `X_η`, the sequence `(ϑ_i)` has an accumulation point `ϑ ∈ X_η`."
  obtain ⟨ϑ, hϑ⟩ := exists_accumulationPoint hfin F (fun n z => ⟨z + U n, rfl⟩)
  have hϑmem : ϑ ∈ orbitClosure η :=
    mem_orbitClosure_of_accumulationPoint (fun n => T_mem_orbitClosure η (U n)) hϑ
  -- "such that `ϑ|Â_∞ = x̂_per|Â_∞`."
  have hAinf : ∀ z ∈ ⋃ i, c.Ahat i, ϑ z = xhat z := by
    intro z hz
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
    have hiσ : z ∈ c.Ahat (σ i) := c.AhatMono i (σ i) (hσle i) hi
    obtain ⟨n, hn, hnz⟩ := hϑ {z} i
    rw [hnz z (Finset.mem_singleton_self z)]
    exact hagreeW n z (hWmono i n hn hiσ)
  -- "In particular, `ϑ|Â_∞` is a periodic configuration with period parallel to `ℓ`."
  have hperiodic : PeriodicOnWith ϑ (⋃ i, c.Ahat i) p :=
    periodicOnWith_of_eqOn hAinf hpne (mem_Per_T hp _)
  -- "We claim that there exists `ε` such that (3.1) holds."
  have h0 : ∀ z ∈ c.shellInf 0, ϑ z = xhat z := fun z hz => hAinf z (c.shellInfZero hz)
  have hfail : ¬ ∀ ε, ∀ z ∈ c.shellInf ε, ϑ z = xhat z := by
    intro hall
    obtain ⟨ε, i₀, hεpos, hEnv⟩ := c.shellEnv
    -- `b3_colle2.txt:524`「if we consider `i ≥ max{i₀, I₀}`」：累积点的指标从 `max i₀ c.I₀`
    -- 起取，`c.I₀` 就是 `:520` 的那个常数。窗口 `Â_{i₀}^{(ε)}` 仍锚在 `i₀`（(3.3) 的那一个）。
    obtain ⟨j, hji₀, hjeq⟩ := hϑ (c.shellFinite i₀ ε).toFinset (max i₀ c.I₀)
    have hmaxi : max i₀ c.I₀ ≤ σ j := le_trans hji₀ (hσle j)
    have hi₀i : i₀ ≤ σ j := le_trans (le_max_left _ _) hmaxi
    -- (3.3): `ϑ_i|(Â_i ∪ Â_{i₀}^{(ε)}) = x̂_per|(Â_i ∪ Â_{i₀}^{(ε)})`.
    have h33 : ∀ z ∈ c.Ahat (σ j) ∪ c.shell i₀ ε, F j z = xhat z := by
      rintro z (hz | hz)
      · exact hagreeW j z hz
      · have h1 : ϑ z = F j z := hjeq z ((c.shellFinite i₀ ε).mem_toFinset.mpr hz)
        have h2 : ϑ z = xhat z := hall ε z (c.shellSubInf i₀ ε hz)
        rw [← h1, h2]
    -- "Since `S_φ` is `η`-generating, by induction we get from (3.3) that
    -- `ϑ_i|Â_i^{(ε)} = x̂_per|Â_i^{(ε)}`."
    have hshelleq : ∀ z ∈ c.shell (σ j) ε, F j z = xhat z := fun z hz =>
      Colle37.agree_on_genClosure hgen (T_mem_orbitClosure η (U j)) hxhatmem h33 z
        (c.fillCover ε i₀ hεpos hEnv (σ j) hmaxi hz)
    -- "which contradicts the maximality of `Â_i`."
    have hsub : c.shell (σ j) ε ⊆ c.Ahat (σ j) := by
      refine c.maximalHat (σ j) _ (hEnv (σ j) hi₀i) (c.subShell (σ j) ε)
        (c.shellSubStrip ε i₀ hεpos hEnv (σ j) hmaxi) ?_
      intro z hz
      have := hshelleq z hz
      have hrw : z + ((c.kk (σ j) : ℤ) • vl + c.u (σ j)) = z + U j := rfl
      rw [hrw]
      calc η (z + U j) = F j z := rfl
        _ = xhat z := this
        _ = (T ((c.kk (σ j) : ℤ) • vl) xper) z := by rw [hσeq j]
        _ = xper (z + (c.kk (σ j) : ℤ) • vl) := rfl
    exact c.shellProper ε i₀ hεpos hEnv (σ j) hmaxi hsub
  obtain ⟨ε, hε1, hε2⟩ := exists_shell_boundary h0 hfail
  exact ⟨ϑ, hϑmem, K, hAinf, hperiodic, ε, hε1, hε2⟩

end Nivat.Colle35
